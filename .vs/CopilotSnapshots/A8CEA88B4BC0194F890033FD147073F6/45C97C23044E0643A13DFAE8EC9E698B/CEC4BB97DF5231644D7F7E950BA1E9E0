using System;
using System.Diagnostics;
using System.IO;
using System.Linq;
using System.Windows.Forms;

namespace TcPouStatechartGenerator
{
    internal sealed class LauncherForm : Form
    {
        private readonly TextBox _tbTcDut;
        private readonly TextBox _tbTcPou;
        private readonly TextBox _tbOut;
        private readonly Button  _btnGenerate;
        private readonly Label   _lblStatus;
        private readonly CheckBox _cbAutoOpen;
        private readonly CheckBox _cbCollapseErrors;
        private bool _promptTcDutOnShow;

        public LauncherForm(string preTcDut, string preTcPou)
        {
            Text = "TcPouStatechartGenerator";
            StartPosition = FormStartPosition.CenterScreen;
            ClientSize = new System.Drawing.Size(720, 260);
            MinimumSize = new System.Drawing.Size(600, 260);
            AllowDrop = true;
            DragEnter += OnDragEnter;
            DragDrop  += OnDragDrop;

            var lblHint = new Label
            {
                Text = "Drag & drop a .TcDUT (states) and a .TcPOU (POU) file anywhere on this window,\n" +
                       "or use the Browse buttons below.",
                AutoSize = false, Location = new System.Drawing.Point(12, 10),
                Size = new System.Drawing.Size(680, 36)
            };

            _tbTcDut = new TextBox { Location = new System.Drawing.Point(120, 56), Size = new System.Drawing.Size(500, 23), ReadOnly = true };
            _tbTcPou = new TextBox { Location = new System.Drawing.Point(120, 88), Size = new System.Drawing.Size(500, 23), ReadOnly = true };
            _tbOut   = new TextBox { Location = new System.Drawing.Point(120, 120), Size = new System.Drawing.Size(500, 23) };

            Controls.Add(lblHint);
            Controls.Add(new Label { Text = "States (.TcDUT):", Location = new System.Drawing.Point(12, 60), AutoSize = true });
            Controls.Add(_tbTcDut);
            Controls.Add(MakeBrowseButton(630, 55, "*.TcDUT", p => { _tbTcDut.Text = p; UpdateOutputDefault(); }));

            Controls.Add(new Label { Text = "POU (.TcPOU):", Location = new System.Drawing.Point(12, 92), AutoSize = true });
            Controls.Add(_tbTcPou);
            Controls.Add(MakeBrowseButton(630, 87, "*.TcPOU", p => { _tbTcPou.Text = p; UpdateOutputDefault(); }));

            Controls.Add(new Label { Text = "Output (.md):", Location = new System.Drawing.Point(12, 124), AutoSize = true });
            Controls.Add(_tbOut);
            var btnBrowseOut = new Button { Location = new System.Drawing.Point(630, 119), Size = new System.Drawing.Size(75, 25), Text = "Browse..." };
            btnBrowseOut.Click += (s, e) =>
            {
                using (var sfd = new SaveFileDialog { Filter = "Markdown (*.md)|*.md|All files (*.*)|*.*", DefaultExt = "md" })
                {
                    if (!string.IsNullOrEmpty(_tbOut.Text)) sfd.FileName = _tbOut.Text;
                    if (sfd.ShowDialog(this) == DialogResult.OK) _tbOut.Text = sfd.FileName;
                }
            };
            Controls.Add(btnBrowseOut);

            _cbAutoOpen = new CheckBox { Text = "Open output when done", Location = new System.Drawing.Point(120, 155), AutoSize = true, Checked = true };
            Controls.Add(_cbAutoOpen);

            _cbCollapseErrors = new CheckBox
            {
                Text = "Collapse error-sink edges",
                Location = new System.Drawing.Point(320, 155),
                AutoSize = true,
                Checked = Program.DefaultCollapseErrorSinkEdges
            };
            Controls.Add(_cbCollapseErrors);

            _btnGenerate = new Button { Text = "Generate", Location = new System.Drawing.Point(534, 190), Size = new System.Drawing.Size(85, 30) };
            _btnGenerate.Click += (s, e) => Generate();
            AcceptButton = _btnGenerate;
            Controls.Add(_btnGenerate);

            var btnClose = new Button { Text = "Close", Location = new System.Drawing.Point(625, 190), Size = new System.Drawing.Size(80, 30) };
            btnClose.Click += (s, e) => Close();
            CancelButton = btnClose;
            Controls.Add(btnClose);

            _lblStatus = new Label { Location = new System.Drawing.Point(12, 195), Size = new System.Drawing.Size(500, 40), AutoSize = false, ForeColor = System.Drawing.Color.DimGray };
            Controls.Add(_lblStatus);

            if (!string.IsNullOrEmpty(preTcDut) && File.Exists(preTcDut)) _tbTcDut.Text = preTcDut;
            if (!string.IsNullOrEmpty(preTcPou) && File.Exists(preTcPou)) _tbTcPou.Text = preTcPou;
            UpdateOutputDefault();

            // Defer the TcDUT prompt until the window handle exists (Shown),
            // otherwise BeginInvoke/dialog in the ctor throws and the app never opens.
            _promptTcDutOnShow = !string.IsNullOrEmpty(_tbTcPou.Text) && string.IsNullOrEmpty(_tbTcDut.Text);
            Shown += OnShown;
        }

        private void OnShown(object sender, EventArgs e)
        {
            if (_promptTcDutOnShow)
            {
                _promptTcDutOnShow = false;
                PromptForTcDut();
            }
        }

        private Button MakeBrowseButton(int x, int y, string filter, Action<string> assign)
        {
            var b = new Button { Location = new System.Drawing.Point(x, y), Size = new System.Drawing.Size(75, 25), Text = "Browse..." };
            b.Click += (s, e) =>
            {
                using (var ofd = new OpenFileDialog
                {
                    Filter = filter + "|" + filter + "|All files (*.*)|*.*",
                    Multiselect = false
                })
                {
                    if (ofd.ShowDialog(this) == DialogResult.OK) assign(ofd.FileName);
                }
            };
            return b;
        }

        private void PromptForTcDut()
        {
            _lblStatus.Text = "Please select the .TcDUT states file.";
            string initialDir = "";
            try { initialDir = Path.GetDirectoryName(_tbTcPou.Text) ?? ""; } catch { }
            using (var ofd = new OpenFileDialog
            {
                Title = "Select the states (.TcDUT) file",
                Filter = "TwinCAT DUT (*.TcDUT)|*.TcDUT|All files (*.*)|*.*",
                InitialDirectory = initialDir
            })
            {
                if (ofd.ShowDialog(this) == DialogResult.OK)
                {
                    _tbTcDut.Text = ofd.FileName;
                    UpdateOutputDefault();
                    _lblStatus.Text = "";
                }
                else _lblStatus.Text = "";
            }
        }

        private void UpdateOutputDefault()
        {
            if (string.IsNullOrEmpty(_tbTcPou.Text)) return;
            if (!string.IsNullOrEmpty(_tbOut.Text)) return;
            _tbOut.Text = Path.Combine(
                Path.GetDirectoryName(_tbTcPou.Text) ?? ".",
                Path.GetFileNameWithoutExtension(_tbTcPou.Text) + ".statechart.md");
        }

        private void OnDragEnter(object sender, DragEventArgs e)
        {
            e.Effect = e.Data.GetDataPresent(DataFormats.FileDrop) ? DragDropEffects.Copy : DragDropEffects.None;
        }

        private void OnDragDrop(object sender, DragEventArgs e)
        {
            var files = (string[])e.Data.GetData(DataFormats.FileDrop);
            foreach (string f in files)
            {
                if (f.EndsWith(".TcDUT", StringComparison.OrdinalIgnoreCase)) _tbTcDut.Text = f;
                else if (f.EndsWith(".TcPOU", StringComparison.OrdinalIgnoreCase)) _tbTcPou.Text = f;
            }
            UpdateOutputDefault();
        }

        private void Generate()
        {
            _lblStatus.ForeColor = System.Drawing.Color.DimGray;
            _lblStatus.Text = "";
            try
            {
                if (string.IsNullOrEmpty(_tbTcDut.Text) || !File.Exists(_tbTcDut.Text))
                { _lblStatus.ForeColor = System.Drawing.Color.Firebrick; _lblStatus.Text = "Select a valid .TcDUT file."; return; }
                if (string.IsNullOrEmpty(_tbTcPou.Text) || !File.Exists(_tbTcPou.Text))
                { _lblStatus.ForeColor = System.Drawing.Color.Firebrick; _lblStatus.Text = "Select a valid .TcPOU file."; return; }

                string outPath = Program.Generate(_tbTcDut.Text, _tbTcPou.Text,
                    string.IsNullOrWhiteSpace(_tbOut.Text) ? null : _tbOut.Text,
                    _cbCollapseErrors.Checked);

                _lblStatus.ForeColor = System.Drawing.Color.ForestGreen;
                _lblStatus.Text = "Wrote: " + outPath;

                if (_cbAutoOpen.Checked)
                    Process.Start(new ProcessStartInfo(outPath) { UseShellExecute = true });
            }
            catch (Exception ex)
            {
                _lblStatus.ForeColor = System.Drawing.Color.Firebrick;
                _lblStatus.Text = "Failed: " + ex.Message;
            }
        }
    }
}
