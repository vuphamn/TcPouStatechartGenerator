{
  "name": "kval-machinescope-vscode",
  "displayName": "Kval MachineScope",
  "description": "TwinCAT in VS Code: .TcPOU / .TcDUT as Structured Text (declaration and implementation, as in XAE), Build, Login, Start, Stop; state machines as statecharts: view, edit, simulate",
  "version": "1.0.0",
  "publisher": "kval",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onFileSystem:twincat-st",
    "workspaceContains:**/*.tsproj"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kval-st",
        "aliases": [
          "Structured Text (TwinCAT)",
          "kval-st"
        ],
        "configuration": "./syntaxes/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kval-st",
        "scopeName": "source.kval-st",
        "path": "./syntaxes/structured-text.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "kvalMachineScope.structuredText",
        "displayName": "TwinCAT Structured Text (Declaration and Implementation)",
        "selector": [
          { "filenamePattern": "*.TcPOU" },
          { "filenamePattern": "*.tcpou" },
          { "filenamePattern": "*.TcDUT" },
          { "filenamePattern": "*.tcdut" },
          { "filenamePattern": "*.TcGVL" },
          { "filenamePattern": "*.tcgvl" },
          { "filenamePattern": "*.TcIO" },
          { "filenamePattern": "*.tcio" }
        ],
        "priority": "default"
      },
      {
        "viewType": "kvalMachineScope.statechart",
        "displayName": "Kval MachineScope Statechart",
        "selector": [
          { "filenamePattern": "*.TcPOU" },
          { "filenamePattern": "*.tcpou" }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      { "command": "kvalMachineScope.open", "title": "Open in Kval MachineScope", "category": "Kval MachineScope", "icon": "$(type-hierarchy)" },
      { "command": "kvalMachineScope.openStructuredText", "title": "Open as Structured Text", "category": "TwinCAT", "icon": "$(symbol-keyword)" },
      { "command": "kvalMachineScope.openXml", "title": "Open as XML", "category": "TwinCAT", "icon": "$(code)" },
      { "command": "kvalMachineScope.goToMember", "title": "Go to Member (Method, Property, Action)…", "category": "TwinCAT", "icon": "$(symbol-method)" },
      { "command": "kvalMachineScope.build", "title": "Build", "category": "TwinCAT", "icon": "$(tools)", "enablement": "!kvalMachineScope.busy" },
      { "command": "kvalMachineScope.login", "title": "Login", "category": "TwinCAT", "icon": "$(plug)", "enablement": "!kvalMachineScope.busy" },
      { "command": "kvalMachineScope.logout", "title": "Logout", "category": "TwinCAT", "icon": "$(debug-disconnect)", "enablement": "!kvalMachineScope.busy" },
      { "command": "kvalMachineScope.start", "title": "Start", "category": "TwinCAT", "icon": "$(debug-start)", "enablement": "!kvalMachineScope.busy && kvalMachineScope.loggedIn" },
      { "command": "kvalMachineScope.stop", "title": "Stop", "category": "TwinCAT", "icon": "$(debug-stop)", "enablement": "!kvalMachineScope.busy && kvalMachineScope.loggedIn" },
      { "command": "kvalMachineScope.pickTarget", "title": "Choose Target…", "category": "TwinCAT", "icon": "$(server-environment)" },
      { "command": "kvalMachineScope.pickBuild", "title": "Choose Build (Remote Manager)…", "category": "TwinCAT", "icon": "$(versions)" },
      { "command": "kvalMachineScope.plcActions", "title": "PLC Actions…", "category": "TwinCAT" },
      { "command": "kvalMachineScope.showOutput", "title": "Show Output", "category": "TwinCAT", "icon": "$(output)" },
      { "command": "kvalMachineScope.refreshPlc", "title": "Refresh", "category": "TwinCAT", "icon": "$(refresh)" }
    ],
    "keybindings": [
      { "command": "kvalMachineScope.build", "key": "ctrl+shift+b", "when": "kvalMachineScope.twincatProject && (resourceScheme == twincat-st || resourceExtname =~ /^\\.tc(pou|dut|gvl|io)$/i)" },
      { "command": "kvalMachineScope.login", "key": "alt+f8", "when": "kvalMachineScope.twincatProject && !kvalMachineScope.loggedIn && (resourceScheme == twincat-st || resourceExtname =~ /^\\.tc(pou|dut|gvl|io)$/i)" },
      { "command": "kvalMachineScope.logout", "key": "ctrl+f8", "when": "kvalMachineScope.loggedIn && (resourceScheme == twincat-st || resourceExtname =~ /^\\.tc(pou|dut|gvl|io)$/i)" },
      { "command": "kvalMachineScope.goToMember", "key": "ctrl+shift+o", "when": "resourceScheme == twincat-st" }
    ],
    "menus": {
      "explorer/context": [
        { "command": "kvalMachineScope.open", "when": "resourceExtname =~ /^\\.tcpou$/i", "group": "navigation@9" },
        { "command": "kvalMachineScope.openStructuredText", "when": "resourceExtname =~ /^\\.tc(pou|dut|gvl|io)$/i", "group": "navigation@8" },
        { "command": "kvalMachineScope.openXml", "when": "resourceExtname =~ /^\\.tc(pou|dut|gvl|io)$/i", "group": "navigation@10" }
      ],
      "editor/title/context": [
        { "command": "kvalMachineScope.open", "when": "resourceExtname =~ /^\\.tcpou$/i || resourceScheme == twincat-st", "group": "navigation@9" },
        { "command": "kvalMachineScope.openXml", "when": "resourceScheme == twincat-st", "group": "navigation@10" }
      ],
      "editor/title": [
        { "command": "kvalMachineScope.build", "when": "resourceScheme == twincat-st && kvalMachineScope.twincatProject", "group": "navigation@1" },
        { "command": "kvalMachineScope.login", "when": "resourceScheme == twincat-st && kvalMachineScope.twincatProject && !kvalMachineScope.loggedIn", "group": "navigation@2" },
        { "command": "kvalMachineScope.logout", "when": "resourceScheme == twincat-st && kvalMachineScope.loggedIn", "group": "navigation@2" },
        { "command": "kvalMachineScope.start", "when": "resourceScheme == twincat-st && kvalMachineScope.loggedIn && !kvalMachineScope.plcRunning", "group": "navigation@3" },
        { "command": "kvalMachineScope.stop", "when": "resourceScheme == twincat-st && kvalMachineScope.loggedIn && kvalMachineScope.plcRunning", "group": "navigation@3" },
        { "command": "kvalMachineScope.goToMember", "when": "resourceScheme == twincat-st", "group": "navigation@4" },
        { "command": "kvalMachineScope.open", "when": "resourceScheme == twincat-st", "group": "navigation@5" }
      ],
      "view/title": [
        { "command": "kvalMachineScope.build", "when": "view == kvalMachineScope.plc", "group": "navigation@1" },
        { "command": "kvalMachineScope.login", "when": "view == kvalMachineScope.plc && !kvalMachineScope.loggedIn", "group": "navigation@2" },
        { "command": "kvalMachineScope.logout", "when": "view == kvalMachineScope.plc && kvalMachineScope.loggedIn", "group": "navigation@2" },
        { "command": "kvalMachineScope.start", "when": "view == kvalMachineScope.plc && kvalMachineScope.loggedIn && !kvalMachineScope.plcRunning", "group": "navigation@3" },
        { "command": "kvalMachineScope.stop", "when": "view == kvalMachineScope.plc && kvalMachineScope.loggedIn && kvalMachineScope.plcRunning", "group": "navigation@3" },
        { "command": "kvalMachineScope.refreshPlc", "when": "view == kvalMachineScope.plc", "group": "navigation@9" },
        { "command": "kvalMachineScope.goToMember", "when": "view == kvalMachineScope.pouMembers", "group": "navigation@1" }
      ],
      "commandPalette": [
        { "command": "kvalMachineScope.plcActions", "when": "kvalMachineScope.twincatProject" }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        { "id": "kvalTwinCAT", "title": "TwinCAT", "icon": "./media/twincat.svg" }
      ]
    },
    "views": {
      "kvalTwinCAT": [
        { "id": "kvalMachineScope.plc", "name": "PLC" },
        { "id": "kvalMachineScope.pouMembers", "name": "POU" }
      ]
    },
    "configuration": {
      "title": "Kval MachineScope",
      "properties": {
        "kvalMachineScope.structuredText.language": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "The language of the Structured Text sections (TwinCAT files opened without their XML). `auto`: `st` when an extension provides it (Structured Text language Support), else this extension's own grammar (`kval-st`). Or a language id (`st`, `twincat-st`, `kval-st`)."
        },
        "kvalMachineScope.twincat.confirmStartStop": {
          "type": "boolean",
          "default": true,
          "description": "Ask before Start and Stop of the PLC (its program runs or stops: the machine moves or stops being controlled)."
        }
      }
    }
  }
}
