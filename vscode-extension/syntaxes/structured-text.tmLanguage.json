{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Structured Text (TwinCAT)",
  "scopeName": "source.kval-st",
  "patterns": [
    { "include": "#comments" },
    { "include": "#pragmas" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#control" },
    { "include": "#operators" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.block.st", "begin": "\\(\\*", "end": "\\*\\)" },
        { "name": "comment.block.c-style.st", "begin": "/\\*", "end": "\\*/" },
        { "name": "comment.line.double-slash.st", "match": "//.*$" }
      ]
    },
    "pragmas": {
      "patterns": [
        { "name": "meta.preprocessor.pragma.st", "begin": "\\{", "end": "\\}", "patterns": [ { "name": "string.quoted.single.st", "match": "'[^']*'" } ] }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.single.st", "begin": "'", "end": "'", "patterns": [ { "name": "constant.character.escape.st", "match": "\\$." } ] },
        { "name": "string.quoted.double.st", "begin": "\"", "end": "\"", "patterns": [ { "name": "constant.character.escape.st", "match": "\\$." } ] }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.time.st", "match": "(?i)\\b(?:T|TIME|LT|LTIME|D|DATE|LD|LDATE|TOD|TIME_OF_DAY|LTOD|DT|DATE_AND_TIME|LDT)#[0-9A-Za-z_:.\\-]+" },
        { "name": "constant.numeric.based.st", "match": "\\b(?:2#[01_]+|8#[0-7_]+|16#[0-9A-Fa-f_]+)\\b" },
        { "name": "constant.numeric.typed.st", "match": "(?i)\\b[A-Z_]+#[0-9A-Za-z_.\\-]+" },
        { "name": "constant.numeric.st", "match": "\\b[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9]+)?\\b" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "(?i)\\b(FUNCTION_BLOCK|FUNCTION|PROGRAM|METHOD|PROPERTY|INTERFACE|ACTION|TYPE|STRUCT|UNION)\\b(?:\\s+(?:(?:PUBLIC|PRIVATE|PROTECTED|INTERNAL|ABSTRACT|FINAL)\\s+)*([A-Za-z_]\\w*))?",
          "captures": { "1": { "name": "storage.type.pou.st" }, "2": { "name": "entity.name.type.st" } }
        },
        { "name": "storage.type.pou.st", "match": "(?i)\\b(END_FUNCTION_BLOCK|END_FUNCTION|END_PROGRAM|END_METHOD|END_PROPERTY|END_INTERFACE|END_ACTION|END_TYPE|END_STRUCT|END_UNION)\\b" },
        { "name": "keyword.other.var.st", "match": "(?i)\\b(VAR_INPUT|VAR_OUTPUT|VAR_IN_OUT|VAR_GLOBAL|VAR_EXTERNAL|VAR_TEMP|VAR_STAT|VAR_INST|VAR_CONFIG|VAR|END_VAR)\\b" },
        { "name": "storage.modifier.st", "match": "(?i)\\b(CONSTANT|RETAIN|PERSISTENT|PUBLIC|PRIVATE|PROTECTED|INTERNAL|ABSTRACT|FINAL|EXTENDS|IMPLEMENTS|AT|REFERENCE\\s+TO|POINTER\\s+TO|ARRAY|OF|THIS|SUPER)\\b" }
      ]
    },
    "control": {
      "patterns": [
        { "name": "keyword.control.st", "match": "(?i)\\b(IF|THEN|ELSIF|ELSE|END_IF|CASE|END_CASE|FOR|TO|BY|DO|END_FOR|WHILE|END_WHILE|REPEAT|UNTIL|END_REPEAT|EXIT|CONTINUE|RETURN|JMP|__NEW|__DELETE|__QUERYINTERFACE|__QUERYPOINTER|__ISVALIDREF|__TRY|__CATCH|__FINALLY|__ENDTRY)\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.word.st", "match": "(?i)\\b(AND|AND_THEN|OR|OR_ELSE|XOR|NOT|MOD|ADR|ADRINST|SIZEOF|BITADR|REF|S=|R=)\\b" },
        { "name": "keyword.operator.assignment.st", "match": ":=|=>|R=|S=|REF=" },
        { "name": "keyword.operator.comparison.st", "match": "<>|<=|>=|=|<|>" },
        { "name": "keyword.operator.arithmetic.st", "match": "\\*\\*|[+\\-*/^]" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.primitive.st", "match": "(?i)\\b(BOOL|BIT|BYTE|WORD|DWORD|LWORD|SINT|USINT|INT|UINT|DINT|UDINT|LINT|ULINT|REAL|LREAL|TIME|LTIME|DATE|LDATE|TIME_OF_DAY|TOD|LTOD|DATE_AND_TIME|DT|LDT|STRING|WSTRING|CHAR|WCHAR|ANY|ANY_NUM|ANY_INT|ANY_REAL|ANY_BIT|ANY_STRING|ANY_DATE|XINT|UXINT|XWORD|PVOID|HRESULT)\\b" }
      ]
    },
    "constants": {
      "patterns": [ { "name": "constant.language.st", "match": "(?i)\\b(TRUE|FALSE|NULL)\\b" } ]
    },
    "functions": {
      "patterns": [ { "match": "\\b([A-Za-z_]\\w*)\\s*(?=\\()", "captures": { "1": { "name": "entity.name.function.st" } } } ]
    },
    "variables": {
      "patterns": [ { "name": "variable.other.st", "match": "\\b[A-Za-z_]\\w*\\b" } ]
    }
  }
}
