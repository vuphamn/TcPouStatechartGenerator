    </Method>
    <Method Name="getDevicePowerRating" Id="{1b070528-9d21-4d11-9faa-780d3c76e242}">
      <Declaration><![CDATA[METHOD getDevicePowerRating : LREAL
VAR_INPUT
	sPUTypeCode					: STRING(19);
END_VAR
VAR
	iTempDriveRatedPowerkWs		: DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
iTempDriveRatedPowerkWs := STRING_TO_DINT(MID(sPUTypeCode,3,6));

CASE (iTempDriveRatedPowerkWs) OF

	125:
	getDevicePowerRating := 0.25;
	
	137:
	getDevicePowerRating := 0.37;
	
	155:
	getDevicePowerRating := 0.55;
	
	175:
	getDevicePowerRating := 0.75;
	
	211:
	getDevicePowerRating := 1.1;
	
	215:
	getDevicePowerRating := 1.5;
	
	222:
	getDevicePowerRating := 2.2;
	
	230:
	getDevicePowerRating := 3.0;
	
	240:
	getDevicePowerRating := 4.0;
	
	255:
	getDevicePowerRating := 5.5;
	
	275:
	getDevicePowerRating := 7.5;
	
	311:
	getDevicePowerRating := 11.0;
	
	315:
	getDevicePowerRating := 15.0;
	
	318:
	getDevicePowerRating := 18.5;
	
	322:
	getDevicePowerRating := 22.0;
	
	330:
	getDevicePowerRating := 30.0;
	
	337:
	getDevicePowerRating := 37.5;
	
	345:
	getDevicePowerRating := 45.0;
	
	355:
	getDevicePowerRating := 55.0;
	
	375:
	getDevicePowerRating := 75.0;
	
	ELSE
	getDevicePowerRating := 0.0;		
	
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="getDeviceStateErrorString" Id="{cd8191ef-b81d-4ba8-9d91-48156e2bddc7}">
      <Declaration><![CDATA[METHOD getDeviceStateErrorString
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE (status_byDeviceState) OF
	
	0:
	status_sDeviceState := 'No Device State Available';
	
	1:
	status_sDeviceState := 'Init State';
	
	2:
	status_sDeviceState := 'Pre-Operational State';
	
	3:
	status_sDeviceState := 'Bootstrap State';
	
	4:
	status_sDeviceState := 'Safe-Operational State';
	
	8:
	status_sDeviceState := 'Operational State';
	
	16:
	status_sDeviceState := 'StateMachine Error in the EtherCAT Slave';
	
	32:
	status_sDeviceState := 'Invalid VendorId, Product Code, RevisionsNo OR SerialNo';
	
	64:
	status_sDeviceState := 'Error Occured While Sending Initialization Commands';
	
	ELSE status_sDeviceState := 'Unknown State';
		
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="getLinkStateErrorString" Id="{f02ac959-9715-4719-805b-d28d35d03382}">
      <Declaration><![CDATA[METHOD getLinkStateErrorString
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE (status_byLinkState) OF
	
	0:
	status_sLinkState := 'Link Status Ok';
	
	1:
	status_sLinkState := 'No Communication with the EtherCAT Slave';
	
	2:
	status_sLinkState := 'Error at Port X, The Port has a Link, but no Communication is Possible';
	
	4:
	status_sLinkState := 'Missing link at port X';
	
	8:
	status_sLinkState := 'Additional link at port X';
	
	10:
	status_sLinkState := 'Port 0';
	
	16:
	status_sLinkState := 'Port 0';
	
	20:
	status_sLinkState := 'Port 1';
	
	32:
	status_sLinkState := 'Port 1';
	
	40:
	status_sLinkState := 'Port 2';
	
	64:
	status_sLinkState := 'Port 2';
	
	80:
	status_sLinkState := 'Port 3';
	
	128:
	status_sLinkState := 'Port 3';
	
	ELSE status_sLinkState := 'Unknown State';

END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="getStateDescription" Id="{6ceb35af-f464-4f73-bfcf-f7c84c135ec6}">
      <Declaration><![CDATA[METHOD getStateDescription : STRING

]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE (machineState) OF
	KMOTORVFDSTATE_DISABLED: getStateDescription := 'Disabled';
	KMOTORVFDSTATE_ENABLING: getStateDescription := 'Enabling';
	KMOTORVFDSTATE_PU_TYPE_CHECK: getStateDescription := 'Device Size Check';
	KMOTORVFDSTATE_SERIAL_CHECK: getStateDescription := 'Device Serial Check';
	KMOTORVFDSTATE_SERIAL_CU_CHECK: getStateDescription := 'Device CU Serial Check';
	KMOTORVFDSTATE_FACTORY_RESET: getStateDescription := 'Factory Reset';
	KMOTORVFDSTATE_FACTORY_RESET_CHECK: getStateDescription := 'Factory Reset';
		IF (read_byte = 2) THEN
			getStateDescription := CONCAT(getStateDescription, ', In Progress');
		ELSIF (read_byte = 3) THEN
			getStateDescription := CONCAT(getStateDescription, ', Action Cancelled');
		ELSIF (read_byte = 4) THEN
			getStateDescription := CONCAT(getStateDescription, ', No Access');
		ELSIF (read_byte = 5) THEN
			getStateDescription := CONCAT(getStateDescription, ', No Access(Inverter Disabled)');				
		END_IF
	KMOTORVFDSTATE_WAIT_FOR_ETHERCAT_RESET: getStateDescription := 'Waiting for Turn to EtherCAT Reset';
	KMOTORVFDSTATE_ETHERCAT_RESET: getStateDescription := 'EtherCAT Reset';
	KMOTORVFDSTATE_ETHERCAT_RESET_CHECK: getStateDescription := 'EtherCAT Reset';
		IF (read_byte = 10) THEN
			getStateDescription := CONCAT(getStateDescription, ', In Progress');
		ELSIF (read_byte = 11) THEN
			getStateDescription := CONCAT(getStateDescription, ', Action Cancelled');
		ELSIF (read_byte = 12) THEN
			getStateDescription := CONCAT(getStateDescription, ', Fault');				
		END_IF
	KMOTORVFDSTATE_PARAMETER_WRITE: getStateDescription := 'Parameter Write, Index# ';
		getStateDescription := CONCAT(getStateDescription,INT_TO_STRING(idx));
	KMOTORVFDSTATE_STOPPING: getStateDescription := 'Stopping';
	KMOTORVFDSTATE_STOPPED: getStateDescription := 'Stopped';
	KMOTORVFDSTATE_FWD: getStateDescription := 'Move Forward';
	KMOTORVFDSTATE_REV: getStateDescription := 'Move Reverse';
	KMOTORVFDSTATE_JOG_MODE: getStateDescription := 'Jogging Mode';
    KMOTORVFDSTATE_ERROR_DRIVE_FAULT:  getStateDescription := 'ERROR';  
END_CASE;

IF (getStateDescription = '') THEN
	getStateDescription := SUPER^.getStateDescription();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="initialize" Id="{53727299-5ce2-4f49-97fd-a27cbecd2557}">
      <Declaration><![CDATA[METHOD initialize
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.initialize();
descriptor.sModuleClass := 'SM_KMotorVFDEtherCATi550';

// Increament the VFD count so we know how many drives there are
iVFDCount := iVFDCount +1;

// Will only use non quick stop in STOPPING doState if config_iStopMethod is set to coast
IF (config_iStopMethod = 0) THEN
	bDisableQuickStop := TRUE;
END_IF

// set jog speed if it was not set when the function block was called
IF (config_iJogSpeedRPM = 0) THEN
	config_iJogSpeedRPM := config_iMinSpeedRPM;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="loadParamStructure" Id="{2e5f5bbb-824e-4df8-a9d0-4a312a28c18e}">
      <Declaration><![CDATA[METHOD loadParamStructure
VAR_INPUT
	stMotorData		 : ST_MotorData;
	eMotorDutyRating : E_MOTOR_DUTY_RATING;
	stResistorData	 : ST_RegenResistorData;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (NOT stMotorData.bValidData) THEN
	logger(sMessage := 'Invalid Motor Parameter Array, No Data Loaded', ePriority := LOGPRIORITY_ALERT);	
ELSIF (NOT stResistorData.bValidData) THEN
	logger(sMessage := 'Invalid Regen Resistor Parameter Array, No Data Loaded', ePriority := LOGPRIORITY_ALERT);	
ELSE
	config_iMotorRatedSpeedRPM := stMotorData.iMotorRatedSpeedRPM;
	config_iMotorRatedFreqHz := stMotorData.iMotorRatedFreqHz;
	config_iMotorRatedVoltage := stMotorData.iMotorRatedVoltage;
	config_iMaxSpeedRPM := stMotorData.iMaxSpeedRPM;
	config_iMinSpeedRPM:= stMotorData.iMinSpeedRPM;
	config_iRegenMode:= stResistorData.iRegenMode;
	config_iRegenResistanceOhms:= stResistorData.iRegenResistanceOhms;
	config_iRegenRatedPowerWatts:= stResistorData.iRegenRatedPowerWatts;
	config_iRegenMaxThermalLoadkWs:= stResistorData.iRegenMaxThermalLoadkWs;
	IF(eMotorDutyRating = E_MOTOR_DUTY_RATING.S6) THEN
		config_fDriveRatedPowerkW:= stMotorData.fDriveRatedPowerS6kW;
		config_fMotorRatedCurrentA:= stMotorData.fMotorRatedCurrentS6A;
		config_fMotorRatedPowerkW:= stMotorData.fMotorRatedPowerS6kW;
	ELSE
		config_fDriveRatedPowerkW:= stMotorData.fDriveRatedPowerS1kW;
		config_fMotorRatedCurrentA:= stMotorData.fMotorRatedCurrentS1A;
		config_fMotorRatedPowerkW:= stMotorData.fMotorRatedPowerS1kW;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="mapAllProcessVariables" Id="{3eecd15f-3d10-49b2-8576-595ed487805a}">
      <Declaration><![CDATA[METHOD mapAllProcessVariables
VAR
	iSpeedMultiplier	:INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// this method just does the easy stuff, mapping the obvious 
// process variables over, assuming that we want them all mappped.

// set the other outputs with pass-throughs:
status_fCurrentAmps		:= INT_TO_LREAL(iReportedCurrentAmps)/10.0;
status_iOutputSpeedRPM	:= iReportedVelocityRPM;
status_fOutputFreqHz := UINT_TO_LREAL(iReportedVelocityRPM)*(DINT_TO_LREAL(config_iMotorRatedFreqHz)/DINT_TO_LREAL(config_iMotorRatedSpeedRPM));

// Check if the commanded speed is out of bounds (but only if not jogging)
IF (status_bMoving AND NOT status_bJogModeOn) AND (cmd_iSpeedRPM < config_iMinSpeedRPM) AND (NOT bCmdSpeedOutOfBounds) THEN
	cmd_bStop := TRUE;
	cmd_bFwd := FALSE;
	cmd_bRev := FALSE;
	sErrorMessage := CONCAT('Commanded Speed: ', UINT_TO_STRING(cmd_iSpeedRPM));
	sErrorMessage := CONCAT(sErrorMessage, ' RPM, ');
	sErrorMessage := CONCAT(sErrorMessage, ' is Less than Minimum Value: ');
	sErrorMessage := CONCAT(sErrorMessage, DINT_TO_STRING(config_iMinSpeedRPM));
	sErrorMessage := CONCAT(sErrorMessage, ' RPM, ');
	sErrorMessage := CONCAT(sErrorMessage, 'State Set to Stop.');
	logger(
		sMessage := sErrorMessage, 
		ePriority := LOGPRIORITY_ERROR
	);	
ELSIF (status_bMoving AND NOT status_bJogModeOn) AND (cmd_iSpeedRPM > config_iMaxSpeedRPM) AND (NOT bCmdSpeedOutOfBounds) THEN
	cmd_bStop := TRUE;
	cmd_bFwd := FALSE;
	cmd_bRev := FALSE;
	sErrorMessage := CONCAT('Commanded Speed: ', UINT_TO_STRING(cmd_iSpeedRPM));
	sErrorMessage := CONCAT(sErrorMessage, ' RPM, ');
	sErrorMessage := CONCAT(sErrorMessage, ' is Greater than Maximum Value: ');
	sErrorMessage := CONCAT(sErrorMessage, DINT_TO_STRING(config_iMaxSpeedRPM));
	sErrorMessage := CONCAT(sErrorMessage, ' RPM, ');
	sErrorMessage := CONCAT(sErrorMessage, 'State Set to Stop.');
	logger(
		sMessage := sErrorMessage, 
		ePriority := LOGPRIORITY_ERROR
	);	
END_IF


IF (cmd_iSpeedRPM < config_iMinSpeedRPM) OR (cmd_iSpeedRPM > config_iMaxSpeedRPM) THEN
	bCmdSpeedOutOfBounds := TRUE;
ELSE
	bCmdSpeedOutOfBounds := FALSE;
END_IF	

(* Fast & Slow Speed Commands *)
IF (cmd_bSpeedFast = TRUE) THEN
	cmd_bSpeedFast := FALSE;
	cmd_iSpeedRPM := config_iFastSpeedRPM;
END_IF
IF (cmd_bSpeedSlow = TRUE) THEN
	cmd_bSpeedSlow := FALSE;
	cmd_iSpeedRPM := config_iSlowSpeedRPM;
END_IF

iTargetVelocity := cmd_iSpeedRPM; // Send the Commanded Speed to the Drive]]></ST>
      </Implementation>
    </Method>
    <Method Name="ParameterWrite" Id="{fbf8bd45-d0f9-4fb4-bb24-b477bc4dca07}">
      <Declaration><![CDATA[METHOD ParameterWrite : BOOL
VAR_INST
	bExecute   			: BOOL; (* rising edge starts writing to the CoE Object *)
	iMaxFreq_x10   		: DINT;
	iMinFreq_x10   		: DINT;
	iJogTargetHz_x10 	: DINT;
	sModuleName			: STRING; 
	rtrig_parametersWritten : R_TRIG;
END_VAR

VAR_INPUT
	iParamWriteIndex	: INT;
END_VAR

VAR_OUTPUT
	astDriveParam		: ARRAY[0..iNumberOfParameters] OF ST_ParameterIndex;
END_VAR
                     	
VAR CONSTANT
	iNumberOfParameters	: INT := 41;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (Descriptor.sModuleName = '') THEN
	sModuleName := 'Un-Named VFD';
ELSE
	sModuleName := Descriptor.sModuleName;
END_IF

IF (config_iVoltFreqMode = 0) THEN
	IF (config_iMidpointVoltage <> 0) AND (config_iMidpointFreqHz <> 0) THEN
		logger(sMessage := 'Midpoint Values have no Effect in Liner Mode', ePriority := LOGPRIORITY_WARNING_LOW );
	END_IF
ELSIF (config_iVoltFreqMode = 2) THEN
	IF (config_iMidpointVoltage = 0) OR (config_iMidpointFreqHz = 0) THEN
		logger(sMessage := 'Invalid Midpoint Values Set, in Multipoint Mode', ePriority := LOGPRIORITY_ERROR );
		config_iVoltFreqMode := 0;
	END_IF
END_IF

iMaxFreq_x10 :=  LREAL_TO_DINT(10 * DINT_TO_LREAL(config_iMaxSpeedRPM) / (DINT_TO_LREAL(config_iMotorRatedSpeedRPM) / DINT_TO_LREAL(config_iMotorRatedFreqHz)));
// Check if Max Hz are valid for with the Drive Can do
IF (iMaxFreq_x10 > config_iDriveMaxHz * 10) THEN
	iMaxFreq_x10 := (config_iDriveMaxHz * 10);
END_IF

iMinFreq_x10 := LREAL_TO_DINT(DINT_TO_LREAL(10 * config_iMinSpeedRPM) / (DINT_TO_LREAL(config_iMotorRatedSpeedRPM) / DINT_TO_LREAL(config_iMotorRatedFreqHz)));

iJogTargetHz_x10 := LREAL_TO_DINT(10 * DINT_TO_LREAL(config_iJogSpeedRPM) / (DINT_TO_LREAL(config_iMotorRatedSpeedRPM) / DINT_TO_LREAL(config_iMotorRatedFreqHz)));

(*------- Drive Setup Parameters ------ *)

(*		code										subcode							size						value*)
astDriveParam[1].wIndex:=16#2631;	astDriveParam[1].bySubIndex:=37;	astDriveParam[1].bySize:=1;		astDriveParam[1].iData := 1;												(* Active Network Control*)
astDriveParam[2].wIndex:=16#6060;	astDriveParam[2].bySubIndex:=0;		astDriveParam[2].bySize:=1;		astDriveParam[2].iData := -2;												(* Modes of Operation*)
astDriveParam[3].wIndex:=16#2D66;	astDriveParam[3].bySubIndex:=1;		astDriveParam[3].bySize:=1;		astDriveParam[3].iData := 1;												(* Mains Failure Control Enabled*)
astDriveParam[4].wIndex:=16#2B01;	astDriveParam[4].bySubIndex:=1;		astDriveParam[4].bySize:=2;		astDriveParam[4].iData := config_iMotorRatedVoltage; 						(* Base Voltage*)
astDriveParam[5].wIndex:=16#2B01;	astDriveParam[5].bySubIndex:=2;		astDriveParam[5].bySize:=2;		astDriveParam[5].iData := config_iMotorRatedFreqHz; 						(* Base Frequency*)
astDriveParam[6].wIndex:=16#2B00;	astDriveParam[6].bySubIndex:=0;		astDriveParam[6].bySize:=1;		astDriveParam[6].iData := config_iVoltFreqMode; 							(* V/F Characteristic Shape: Operating Mode*)
astDriveParam[7].wIndex:=16#2B01;	astDriveParam[7].bySubIndex:=3;		astDriveParam[7].bySize:=2;		astDriveParam[7].iData := config_iMidpointVoltage; 							(* Midpoint Voltage*)
astDriveParam[8].wIndex:=16#2B01;	astDriveParam[8].bySubIndex:=4;		astDriveParam[8].bySize:=2;		astDriveParam[8].iData := config_iMidpointFreqHz; 							(* Midpoint Frequency*)
astDriveParam[9].wIndex:=16#2D4B;	astDriveParam[9].bySubIndex:=1;		astDriveParam[9].bySize:=2;		astDriveParam[9].iData := config_MaxLoadErrorLevelPercent;					(* Motor Overload monit. Max Utilisation default 150%*)
astDriveParam[10].wIndex:=16#2D4B;	astDriveParam[10].bySubIndex:=3;	astDriveParam[10].bySize:=1;	astDriveParam[10].iData := 3;												(* Motor Overload monit. Responce Fault*)
astDriveParam[11].wIndex:=16#2939;	astDriveParam[11].bySubIndex:=0;	astDriveParam[11].bySize:=1;	astDriveParam[11].iData := config_iSwitchingFrequencyCode;					(* Switching Frequency *)
astDriveParam[12].wIndex:=16#2C01;	astDriveParam[12].bySubIndex:=6;	astDriveParam[12].bySize:=2;	astDriveParam[12].iData := LREAL_TO_DINT(config_fMotorRatedPowerkW*100);	(* Motor Parameters: Rated Power*)
astDriveParam[13].wIndex:=16#2C01;	astDriveParam[13].bySubIndex:=7;	astDriveParam[13].bySize:=2;	astDriveParam[13].iData := config_iMotorRatedVoltage;						(* Motor Parameters: Rated Voltage*)
astDriveParam[14].wIndex:=16#2C01;	astDriveParam[14].bySubIndex:=4;	astDriveParam[14].bySize:=2;	astDriveParam[14].iData := config_iMotorRatedSpeedRPM; 						(* Motor Parameters: Rated Speed*)
astDriveParam[15].wIndex:=16#2C01;	astDriveParam[15].bySubIndex:=5;	astDriveParam[15].bySize:=2;	astDriveParam[15].iData := config_iMotorRatedFreqHz*10; 					(* Motor Parameters: Rated Frequency*)
astDriveParam[16].wIndex:=16#6075;	astDriveParam[16].bySubIndex:=0;	astDriveParam[16].bySize:=4;	astDriveParam[16].iData := LREAL_TO_DINT(config_fMotorRatedCurrentA*1000);	(* Motor Parameters: Rated Current*)
astDriveParam[17].wIndex:=16#6080;	astDriveParam[17].bySubIndex:=0;	astDriveParam[17].bySize:=4;	astDriveParam[17].iData := config_iMaxSpeedRPM + 5; 						(* Max Motor Speed*)
astDriveParam[18].wIndex:=16#2917;	astDriveParam[18].bySubIndex:=0;	astDriveParam[18].bySize:=2;	astDriveParam[18].iData := convertToAccMaxSpdDINT(config_fRatedAccelS);		(* Acceleration Time - the config is in "seconds to rated speed" but the Lenze needs "seconds to max speed", as a fixed point int *)
astDriveParam[19].wIndex:=16#2918;	astDriveParam[19].bySubIndex:=0;	astDriveParam[19].bySize:=2;	astDriveParam[19].iData := convertToAccMaxSpdDINT(config_fRatedDeccelS);	(* Deceleration Time - the config is in "seconds to rated speed" but the Lenze needs "seconds to max speed", as a fixed point int *)
astDriveParam[20].wIndex:=16#291C;	astDriveParam[20].bySubIndex:=0;	astDriveParam[20].bySize:=2;	astDriveParam[20].iData := convertToAccMaxSpdDINT(config_fRatedDeccelS);	(* Quick Stop Decel Time - the config is in "seconds to rated speed" but the Lenze needs "seconds to max speed", as a fixed point int *)
astDriveParam[21].wIndex:=16#2915;	astDriveParam[21].bySubIndex:=0;	astDriveParam[21].bySize:=2;	astDriveParam[21].iData := iMinFreq_x10;									(* Minimum Frequency - fixed point int needs to be shifted*)
astDriveParam[22].wIndex:=16#2916;	astDriveParam[22].bySubIndex:=0;	astDriveParam[22].bySize:=2;	astDriveParam[22].iData := iMaxFreq_x10;									(* Maximum Frequency - fixed point int needs to be shifted*)
astDriveParam[23].wIndex:=16#2D44;	astDriveParam[23].bySubIndex:=1;	astDriveParam[23].bySize:=2;	astDriveParam[23].iData := config_iMaxSpeedRPM+5; 							(* Overspeed Monitoring: Threshold*)
astDriveParam[24].wIndex:=16#2B12;	astDriveParam[24].bySubIndex:=1;	astDriveParam[24].bySize:=1;	astDriveParam[24].iData := config_iFixedBoostPercent*10;					(* Fixed V/F Boost: Fixed Boost*)
astDriveParam[25].wIndex:=16#2B12;	astDriveParam[25].bySubIndex:=2;	astDriveParam[25].bySize:=1;	astDriveParam[25].iData := config_iAccelBoostPercent*10;					(* V/F Voltage Boost: Boost at Acceleration*)
astDriveParam[26].wIndex:=16#2541;	astDriveParam[26].bySubIndex:=1;	astDriveParam[26].bySize:=1;	astDriveParam[26].iData := config_iRegenMode; 								(* Brake Energy Management: Operating Mode*)
astDriveParam[27].wIndex:=16#2541;	astDriveParam[27].bySubIndex:=6;	astDriveParam[27].bySize:=1;	astDriveParam[27].iData := 0; 												(* Brake Energy Management: Brake Resistor Response*)
astDriveParam[28].wIndex:=16#2550;	astDriveParam[28].bySubIndex:=2;	astDriveParam[28].bySize:=2;	astDriveParam[28].iData := (config_iRegenResistanceOhms*10);				(* Brake Resistor: Resistance Value *)
astDriveParam[29].wIndex:=16#2550;	astDriveParam[29].bySubIndex:=3;	astDriveParam[29].bySize:=4;	astDriveParam[29].iData := config_iRegenRatedPowerWatts; 					(* Brake Resistor: Rated Power *)
astDriveParam[30].wIndex:=16#2550;	astDriveParam[30].bySubIndex:=4;	astDriveParam[30].bySize:=4;	astDriveParam[30].iData := (config_iRegenMaxThermalLoadkWs*10);				(* Brake Resistor: Maximum Thermal Load *)
astDriveParam[31].wIndex:=16#2634;	astDriveParam[31].bySubIndex:=1;	astDriveParam[31].bySize:=1;	astDriveParam[31].iData := 33; 												(* Digital Outputs Function: Relay *)
astDriveParam[32].wIndex:=16#2820;	astDriveParam[32].bySubIndex:=1;	astDriveParam[32].bySize:=1;	astDriveParam[32].iData := 0; 												(* Holding Brake Control: Brake Mode: 0 = Automatically, 2 = Off, 1 = Manually *)
astDriveParam[33].wIndex:=16#2820;	astDriveParam[33].bySubIndex:=7;	astDriveParam[33].bySize:=2;	astDriveParam[33].iData := 0; 												(* Holding Brake Control: Brake Closing Threshold *)
astDriveParam[34].wIndex:=16#2838;	astDriveParam[34].bySubIndex:=3;	astDriveParam[34].bySize:=1;	astDriveParam[34].iData := config_iStopMethod;								(* Stopping method *)
astDriveParam[35].wIndex:=16#2631;	astDriveParam[35].bySubIndex:=10;	astDriveParam[35].bySize:=1;	astDriveParam[35].iData := 11;												(* Jog mode trigger - 11 is digital input 1*)
astDriveParam[36].wIndex:=16#2911;	astDriveParam[36].bySubIndex:=5;	astDriveParam[36].bySize:=2;	astDriveParam[36].iData := iJogTargetHz_x10; 								(* Set Preset 5 - This is the preset that jog mode targets *)
astDriveParam[37].wIndex:=16#2860;	astDriveParam[37].bySubIndex:=1;	astDriveParam[37].bySize:=1;	astDriveParam[37].iData := 5;												(* set Default Frequency setpoint to be controlled by EtherCAT network *)
astDriveParam[38].wIndex:=16#2631;	astDriveParam[38].bySubIndex:=2;	astDriveParam[38].bySize:=1;	astDriveParam[38].iData := 1;												(* Enable Inverter to Constant TRUE *)
astDriveParam[39].wIndex:=16#400E;	astDriveParam[39].bySubIndex:=1;	astDriveParam[39].bySize:=1;	astDriveParam[39].iData := 1;												(* Netword IN, bit 1 - disable inverter*)
astDriveParam[40].wIndex:=16#400E;	astDriveParam[40].bySubIndex:=2;	astDriveParam[40].bySize:=1;	astDriveParam[40].iData := 49;												(* Netword IN, bit 2 - release holding brake *)
astDriveParam[41].wIndex:=16#2634;	astDriveParam[41].bySubIndex:=14;	astDriveParam[41].bySize:=1;	astDriveParam[41].iData := 59; 												(* Netword OUT, bit 4 - device trouble active *)

(*=======================*)
IF (iParamWriteIndex >= 0) AND (iParamWriteIndex <= iNumberOfParameters) THEN
	IF ((config_iRegenMode <> 1) OR ((iParamWriteIndex <> 28) AND (iParamWriteIndex <> 29) AND (iParamWriteIndex <> 30))) THEN
		bExecute := TRUE;
	END_IF
ELSIF (iParamWriteIndex > iNumberOfParameters) THEN
	bFinishedAllParam := TRUE;
	rtrig_parametersWritten(CLK := bFinishedAllParam);
	IF (rtrig_parametersWritten.Q) THEN
		logger(ePriority := E_LogPriority.LOGPRIORITY_MESSAGE_HIGH, sMessage := 'Motor parameters written successfully');
	END_IF
END_IF

IF (iParamWriteIndex = 0) THEN
		FB_EcCoESdoWrite(
			sNetId:= F_CreateAmsNetId(stAdsAddr.netId), 
			nSlaveAddr:= stAdsAddr.port, 
			nSubIndex:= 0, 
			nIndex:= 16#2001, 
			pSrcBuf:= ADR(sModuleName), 
			cbBufLen:= SIZEOF(sModuleName), 
			bExecute:= bExecute, 
			tTimeout:= DEFAULT_ADS_TIMEOUT, 
			bBusy=> , 
			bError=> , 
			nErrId=> );		
ELSE
		FB_EcCoESdoWrite(
			sNetId:= F_CreateAmsNetId(stAdsAddr.netId), 
			nSlaveAddr:= stAdsAddr.port, 
			nSubIndex:= astDriveParam[iParamWriteIndex].bySubIndex, 
			nIndex:= astDriveParam[iParamWriteIndex].wIndex, 
			pSrcBuf:= ADR(astDriveParam[iParamWriteIndex].iData), 
			cbBufLen:= astDriveParam[iParamWriteIndex].bySize, 
			bExecute:= bExecute, 
			tTimeout:= DEFAULT_ADS_TIMEOUT, 
			bBusy=> , 
			bError=> , 
			nErrId=> );		
END_IF


IF NOT fb_EcCoESdoWrite.bBusy THEN
    IF NOT (fb_EcCoESdoWrite.bError) THEN 
        (* write successful *)
        bCoEerror := FALSE;
        iCoEerrId := 0;
    ELSE 
        (* write failed *)
        bCoEerror := fb_EcCoESdoWrite.bError;
        iCoEerrId := fb_EcCoESdoWrite.nErrId;
    END_IF
	bExecute := FALSE;
    fb_EcCoESdoWrite(bExecute := FALSE);
	ParameterWrite := NOT bCoEerror;
END_IF

	
	]]></ST>
      </Implementation>
    </Method>
    <Method Name="postProcess" Id="{cb100595-0645-45bd-a569-973df57f8407}">
      <Declaration><![CDATA[METHOD postProcess
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.postProcess();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="preProcess" Id="{ed9aa34f-9ea3-424d-9557-d78a12ebdc9d}">
      <Declaration><![CDATA[METHOD preProcess
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// run always
TON_xCommFault(IN:= NOT TON_xCommFault.Q , PT:=T#1S);

// update command variables
RTrig_ErrorResetBtn(CLK:= di_ErrorResetBtn);
IF (RTrig_ErrorResetBtn.Q) THEN
	cmd_bResetError := TRUE;
END_IF

// call the synch functions
GenMfgSpecificErrorStr();
decodeStatusWord();
mapAllProcessVariables();
EncodeControlWord();
getDeviceStateErrorString();
getLinkStateErrorString();

// ----------------------------------------------------------------------------
// update other status variables
status_iMotorOverloadPercent := iReportedMotorOverloadPercent;
status_bMotorThermalWarning	:= (status_iMotorOverloadPercent > config_MaxLoadWarningLevelPercent);
do_DriveErrorLight := status_bGeneralVFDError;

SUPER^.preProcess();]]></ST>
      </Implementation>
    </Method>
    <Method Name="resetAllFlags" Id="{2bda79ac-0ba9-4db1-8c1e-60f7ec98284b}" FolderPath="Helper Methods\">
      <Declaration><![CDATA[METHOD PRIVATE resetAllFlags
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* clear status *)
status_bMoving 			:= FALSE;
status_bMovingFwd 		:= FALSE;
status_bMovingRev 		:= FALSE;
status_bReady 			:= FALSE;
status_bError 			:= FALSE;
status_bAtSpeed			:= FALSE;
status_bStopped			:= FALSE;
status_iOutputSpeedRPM	:= 0;
status_fCurrentAmps		:= 0;
status_bGeneralVFDError	:= FALSE;
status_bEtherCATError	:= FALSE;
status_bDriveError		:= FALSE;
status_bJoggingError  := FALSE;
status_bDriveWarning	:= FALSE;
status_bDriveReady		:= FALSE;
status_bDriveEnabled	:= FALSE;
(* Parameter write flags *)
idx 				:= 0;
bCoEerror 			:= FALSE;
iCoEerrId 			:= 0;
(* Drive resetting *)
iVFDReadyforReset := 0;
iVFDResetNeeded	  := 0;
iVFDResetOrder	  := 0;
bVFDReadyforReset := FALSE;
(* cmds *)
cmd_bFwd 	:= FALSE;
cmd_bRev 	:= FALSE;		
cmd_bStop 	:= FALSE;
sConflictingCmd := '';
]]></ST>
      </Implementation>
    </Method>
