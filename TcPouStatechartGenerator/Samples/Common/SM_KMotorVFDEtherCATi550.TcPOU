	65366:
 	status_sMfgSpecificError := 'Max Motor Frequency Reached Warning';
	
	65370:
 	status_sMfgSpecificError := 'Manual Mode Deactivated Warning';
	
	65371:
 	status_sMfgSpecificError := 'Manual Mode Activated Warning';
	
	65372:
 	status_sMfgSpecificError := 'Manual Mode Timeout Fault';
	
	65393:
 	status_sMfgSpecificError := 'Wrong Password Warning';
	
	65395:
 	status_sMfgSpecificError := 'Fatal Error';
	
	65396:
 	status_sMfgSpecificError := 'PowerUnit Fatal Error';
	
	65413:
 	status_sMfgSpecificError := 'Keypad Full Control Active Warning';
	
