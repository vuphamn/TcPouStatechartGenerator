	65328:
 	status_sMfgSpecificError := 'TMO Generated No Reaction';
	
	65329:
 	status_sMfgSpecificError := 'TMO Generated Warning';
	
	65330:
 	status_sMfgSpecificError := 'TMO Generated Trouble';
	
	65331:
 	status_sMfgSpecificError := 'TMO Generated Fault';
	
	65332:
 	status_sMfgSpecificError := 'TMO Generated Fault Delayed';
	
	65333:
 	status_sMfgSpecificError := 'TMO Generated Fault Blocked';
	
	65334:
 	status_sMfgSpecificError := 'Brake Resistor: Overload Warning';
	
