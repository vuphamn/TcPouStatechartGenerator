	30345:
 	status_sMfgSpecificError := 'Memory Module: Invalid OEM Data Warning';
	
	30346:
 	status_sMfgSpecificError := 'Memory Module: Wrong Type Fault';
	
	30352:
 	status_sMfgSpecificError := 'EPM Firmware Version Incompatible Fault';
	
	30353:
 	status_sMfgSpecificError := 'EPM Data: Firmware Type Incompatible Fault';
	
	30354:
