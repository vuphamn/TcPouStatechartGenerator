	30357:
 	status_sMfgSpecificError := 'Invalid Parameter Changover Configuration Warning';
	
	30358:
 	status_sMfgSpecificError := 'EPM Data: Unkown Parameter Found';
	
	30359:
 	status_sMfgSpecificError := 'Parameter Changes Lost Fault';
	
	33042:
 	status_sMfgSpecificError := 'Network: Timeout Explicit Message Warning';
	
	33044:
 	status_sMfgSpecificError := 'Network: Overall Communication Timeout Warning';
	
	33045:
 	status_sMfgSpecificError := 'Timeout (PAM)';
	
	33046:
 	status_sMfgSpecificError := 'Modbus TCP Master Timeout Fault';
	
	33047:
 	status_sMfgSpecificError := 'Modbus TCP Keep Alive Timeout Fault';
	
	33154:
 	status_sMfgSpecificError := 'CAN: Bus Off';
	
	33155:
 	status_sMfgSpecificError := 'CAN: Warning';
	
	33156:
 	status_sMfgSpecificError := 'CAN: Heartbeat Timeout Consumer 1 Fault';
	
	33157:
 	status_sMfgSpecificError := 'CAN: Heartbeat Timeout Consumer 2 Fault';
	
	33158:
 	status_sMfgSpecificError := 'CAN: Heartbeat Timeout Consumer 3 Fault';
	
	33159:
 	status_sMfgSpecificError := 'CAN: Heartbeat Timeout Consumer 4 Fault';
	
	33168:
 	status_sMfgSpecificError := 'Network: Watchdog Timeout';
	
	33169:
 	status_sMfgSpecificError := 'Network: Disruption of Cyclic Data Exchange';
	
	33170:
 	status_sMfgSpecificError := 'Network: Initialization Error';
	
	33171:
 	status_sMfgSpecificError := 'Network: Invalid Cyclic Process Data';
	
