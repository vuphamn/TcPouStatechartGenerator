<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="SM_KMotorVFDEtherCATi550" Id="{dbcadc4e-f90b-4c3c-a66b-74b2abf3061b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK SM_KMotorVFDEtherCATi550 EXTENDS SM_KMotorBase

VAR_INPUT	
	TON_xCommFault				: TON;
	
	// extra commands
	cmd_iSpeedRPM					: UINT;				// the commanded RPM of the motor
	cmd_bResetError					: BOOL;				// reset from error state
	cmd_bEnableRelay				: BOOL;				// Enable Relay
	cmd_bForceLowEnergyState		: BOOL;				// Hold the Stopping state to ensure the spindle has stopped
	
(* Configs Sent to Drive Via. EtherCAT *)
	config_iMotorRatedSpeedRPM		: DINT := 24000;	// Motor Rated Speed in RPM
	config_iMotorRatedVoltage		: DINT := 460;		// Motor Rated Voltage
	config_iMotorRatedFreqHz		: DINT := 400;		// Motor Rated Frequency in Hz
	config_fMotorRatedCurrentA		: LREAL := 4.3;		// Motor Rated Current in Amps
	config_fMotorRatedPowerkW		: LREAL := 0;		// Motor Rated Power in kWs
	config_fRatedAccelS				: LREAL := 0.5;		// Accel Time to Rated Speed in Seconds
	config_fRatedDeccelS			: LREAL := 2.0;		// Deccel Time from Rated Speed to Stop in Seconds
	config_iMaxSpeedRPM				: DINT := 24000;	// Maximum Motor Speed in RPM
	config_iMinSpeedRPM				: DINT := 1200;		// Minimum Motor Speed in RPM
	config_iFastSpeedRPM			: UINT := 24000;	// Default setting for "fast"
	config_iSlowSpeedRPM			: UINT := 1200;		// Default setting for "slow"
	config_iJogSpeedRPM				: DINT;				// overwrite jogging speed; defaults to config_iMinSpeedRPM if not overwritten
	config_bReverseRotation			: BOOL := FALSE;	// Reverse The Rotational Direction Definition of FWD
	config_iRegenMode				: DINT := 1;		// Brake Energy Management: Operating Mode, (No Regen Brake Resistor-1, With Regen Brake Resistor-2)
	config_iRegenResistanceOhms		: DINT := 750;		// Brake Resistor: Resistance Value in Ohms
	config_iRegenRatedPowerWatts	: DINT := 800;		// Brake Resistor: Rated Power in Watts
	config_iRegenMaxThermalLoadkWs	: DINT := 1200;		// Brake Resistor: Maximum Thermal Load in kWs
	config_iSwitchingFrequencyCode	: DINT := 21;		// Switching Frequency Mode. Default is 8KHz, with drive optimization. 
	config_iVoltFreqMode			: DINT := 0;		// V/F Characteristic Shape Mode(Linear-0, Quadratic-1, Multipoint-2, Eco-3)
	config_iMidpointVoltage			: DINT := 0;		// Motor Midpoint Voltage
	config_iMidpointFreqHz			: DINT := 0;		// Motor Midpoint Frequency in Hz
	config_iFixedBoostPercent		: DINT := 00;		// Fixed V/F Boost 0-20%
	config_iAccelBoostPercent		: DINT := 00;		// V/F Voltage Boost at Acceleration 0-20%
	config_MaxLoadErrorLevelPercent : DINT := 150;
	config_iStopMethod				: DINT := 1;		// Stopping method (coast-0, standard ramp-1, quick stop ramp-2, switch off positioning-3)
	
(* Configs that are Non EtherCAT *) 
	config_fAddedStoppingTimeS		  : LREAL := 0.1; 		// time to add after bStopped is true during stopping
	config_fDriveRatedPowerkW		  : LREAL := 0;			// Drive Rated Power in kWs
	config_iDriveMaxHz				  : DINT := 599;		// Drive Maximum Hz
	config_MaxLoadWarningLevelPercent : DINT := 75;			// the percentage of overload to triger a warning. 100 = motor fault with overload error.
	config_bAllowJoggingOnStart       : BOOL;				// Will not go to error state if drive is jogging when started

	// mappable inputs
	stAdsAddr						AT %I* : AMSADDR;		// The structure holding the AMS address and port
	iStatusWord						AT %I* : UINT;			// linked status word from the drive. (Dissected)
	iStatusDigitalInput				AT %I* : UDINT;			// linked to status of digital inputs
	iErrorCode		   				AT %I* : UINT; 			// linked error code from the drive
	iReportedVelocityRPM			AT %I* : UINT;			// in RPM, 1 count = 1 rpm
	iReportedCurrentAmps			AT %I* : INT;			// in tenths of an amp, 10 counts = 1 amp 
	iReportedMotorOverloadPercent	AT %I* : UINT;			// 100 ≡ 100% of configured overload
	di_ErrorResetBtn   				AT %I* : BOOL;			// Warning, if this is hit, and the source of error has not been fixed, cmd_bReset will be stuck in True, and will require a Twincat reset to clear
	
END_VAR
VAR_OUTPUT
	// extra VFD statuses, not used in base class
	status_bStopped					: BOOL;	
	status_fCurrentAmps				: LREAL;
	status_iOutputSpeedRPM			: UINT;
	status_fOutputFreqHz			: LREAL;
	
	// drive error set	
	status_bGeneralVFDError			: BOOL;
	status_bEtherCATError			: BOOL;
	status_bDriveError				: BOOL;
	status_bJoggingError			: BOOL;
	status_bStoppedError			: BOOL;
	status_bDriveWarning			: BOOL;
	status_bDriveTrouble			: BOOL;
	status_iMotorOverloadPercent	: UINT;		// 100 = 100% of thermal overload. When it reaches 100 the drives faults
	status_bMotorThermalWarning		: BOOL;		// true when the thermal load on the drive reaches warning level
	status_bDriveReady				: BOOL;
	status_bDriveEnabled			: BOOL;
	status_bDriveQuickStop			: BOOL;
	status_bSafeTorqueOff			: BOOL;
	status_bJogModeOn				: BOOL;
	status_byLinkState				: BYTE;
	status_byDeviceState			: BYTE;
	status_sLinkState				: STRING;
	status_sDeviceState				: STRING;
	status_sMfgSpecificError		: STRING;
	sErrorMessage				    : STRING(LOG_MESSAGE_SIZE);
	// mappable outputs
	iControlWord			 AT %Q* : UINT; // .7, reset error, only is passed to the drive on a rising edge
	iTargetVelocity 		 AT %Q* : UINT;
	do_DriveErrorLight		 AT %Q* : BOOL; 

END_VAR
VAR
	(* Timers *)
	fbTON_DriveEnableTimeout		: TON;			// timer to give warning if drive is not enabling.
	RTrig_ErrorResetBtn				: R_Trig;
	fcnDone							: BOOL;
	idx								: INT; // my general purpose index
	iRetryCount						: INT;
	iRetryLimit						: INT:=20;
	FB_EcGetSlaveState				: FB_EcGetSlaveState;
	FB_EcCoESdoWrite				: FB_EcCoESdoWrite;
	FB_EcCoESdoRead					: FB_EcCoESdoRead;
	bWarningLastPass				: BOOL;
	iWarningCodeLastPass			: UINT;
	bCoEerror    				    : BOOL;
    iCoEerrId     					: UDINT;
	sTempSerialNumber				: STRING(50);
	sTempCUSerialNumber				: STRING(50);
	sPUTypeCode						: STRING(19);
	bFinishedAllParam 				: BOOL;
	bCmdSpeedOutOfBounds			: BOOL;
	iAddedStoppingCycles			: UINT; // number of quantized cycles to add to the stopping state
	read_byte						: BYTE :=0;
	iVFDResetOrder					: INT  :=0;
	bVFDReadyforReset				: BOOL;
	sConflictingCmd					: STRING;
END_VAR    
VAR PERSISTENT
	sSerialNumber					: STRING(50);
	sCUSerialNumber					: STRING(50);
END_VAR
VAR_STAT
	iVFDCount						: INT :=0;	// Total Machine VFD count
	iVFDReadyforReset				: INT :=0;	// Number of VFD's ready for EtherCAT reset
	iVFDResetNeeded					: INT :=0; // Number of VFD's that Need an EtherCAT reset
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[runMachine();
]]></ST>
    </Implementation>
    <Folder Name="Helper Methods" Id="{1390bd17-c0bc-4cf6-a22b-45dcac883046}" />
    <Method Name="checkForStoppedError" Id="{125716ac-375a-492a-9bcc-da180c6e83a5}" FolderPath="Helper Methods\">
      <Declaration><![CDATA[METHOD PRIVATE checkForStoppedError
VAR_INPUT
	sBadCmd : STRING;
END_VAR

VAR_INST
	ton_stoppedError : TON := (PT := T#0.5S);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (bFirstPass) THEN
	ton_stoppedError(IN := FALSE);
END_IF

// check if motor is stopped - throw error after half second
IF (status_bStopped) THEN
	ton_stoppedError(IN := TRUE);
	IF (ton_stoppedError.Q) THEN
		status_bStoppedError := TRUE;
		sConflictingCmd := sBadCmd;
	END_IF
ELSE
	ton_stoppedError(IN := FALSE);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="convertToAccMaxSpdDINT" Id="{2c8aff59-a558-46ec-acf0-877b17de3e1a}">
      <Declaration><![CDATA[METHOD convertToAccMaxSpdDINT : DINT
VAR_INPUT
	fAccRatedSpeed		: LREAL;
END_VAR
VAR
	fConvertedSpeed		: LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// this method takes the more normal "acceleration time to rated speed" and converts it to what the Lenze wants, whcih is "acceleration time to max speed"
// it also converts the number from a LREAL to a fixed-point DINT (xxxxx.x)

fConvertedSpeed := DINT_TO_LREAL(config_iMaxSpeedRPM) * fAccRatedSpeed / DINT_TO_LREAL(config_iMotorRatedSpeedRPM);
convertToAccMaxSpdDINT := LREAL_TO_DINT(fConvertedSpeed * 10);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="decodeStatusWord" Id="{0e06f6f5-34da-4e40-87ed-9eafb339f999}">
      <Declaration><![CDATA[METHOD decodeStatusWord
VAR_INST
	bLowVoltageErrorCode : BOOL;
	ton_lowVoltageWarningsEnabled : TON := (PT := T#5S);
	bRaiseWarning : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// general status
status_bDriveReady		:= iStatusWord.0;
status_bDriveEnabled	:= iStatusWord.2;
status_bDriveQuickStop	:= iStatusWord.5;
status_bAtSpeed			:= iStatusWord.10;
status_bSafeTorqueOff	:= iStatusWord.15;

// our definitions
status_bMoving := (NOT iStatusWord.12) AND status_bDriveEnabled;
status_bStopped := (NOT status_bMoving);
// not speedEqZero and not dirCCW and driveEnabled
status_bMovingFwd := (status_bMoving) AND (NOT iStatusWord.13) AND (status_bDriveEnabled);
// not speedEqZero and dirCCW and driveEnabled 
status_bMovingRev := (status_bMoving) AND (iStatusWord.13) AND (status_bDriveEnabled);
// di 1 is active (assuming 16#2631:010 has been set to 11)
status_bJogModeOn := (iStatusDigitalInput.16);

// communication status
FB_EcGetSlaveState(
	sNetId:=F_CreateAmsNetId(stAdsAddr.netId),
	nSlaveAddr:=stAdsAddr.port,
	bExecute:= TON_xCommFault.Q,
	tTimeout:= ,
	bBusy=> ,
	bError=> ,
	nErrId=> ,
	state=> );

IF (NOT FB_EcGetSlaveState.bBusy) THEN
	status_bEtherCATError	:= NOT (FB_EcGetSlaveState.state.linkState=0);
	status_byLinkState := FB_EcGetSlaveState.state.linkState;
	status_byDeviceState := FB_EcGetSlaveState.state.deviceState;
END_IF

// error set 
status_bDriveError 	 := iStatusWord.3;
status_bDriveTrouble := iStatusWord.4;
status_bDriveWarning := iStatusWord.7;
bLowVoltageErrorCode := ((iErrorCode = 12832) OR (iErrorCode = 12833) OR (iErrorCode = 12834)); // All undervoltage trouble/warning codes

// combo of status
IF ( machineState > KMOTORVFDSTATE_ENABLING) THEN
	status_bGeneralVFDError :=  status_bDriveError OR status_bEtherCATError OR (status_byDeviceState > 8 OR status_byDeviceState < 1) OR status_bDriveTrouble OR status_bJoggingError OR status_bStoppedError;
	ton_lowVoltageWarningsEnabled(IN := TRUE);	
ELSE
	ton_lowVoltageWarningsEnabled(IN := FALSE);
	status_bGeneralVFDError :=  status_bDriveError OR status_bEtherCATError;
END_IF

// disable warning if is a low voltage warning, but the drive has not been enabled for long enough
IF bLowVoltageErrorCode AND NOT ton_lowVoltageWarningsEnabled.Q THEN
	bRaiseWarning := FALSE;
ELSE
	bRaiseWarning := (status_bDriveWarning) AND (iErrorCode <> 0) AND (NOT status_bGeneralVFDError);
END_IF

IF (bRaiseWarning) THEN
	IF (NOT bWarningLastPass) OR ( iWarningCodeLastPass <> iErrorCode) THEN
		sErrorMessage := CONCAT(status_sMfgSpecificError, ' - Warning Id# ');
		sErrorMessage := CONCAT(sErrorMessage, UDINT_TO_STRING(iErrorCode));
		sErrorMessage := CONCAT(sErrorMessage, ' - in state: ');
		sErrorMessage := CONCAT(sErrorMessage, getStateDescription());
		sErrorMessage := CONCAT(sErrorMessage, ' (');
		sErrorMessage := CONCAT(sErrorMessage, INT_TO_STRING(machineState));
		sErrorMessage := CONCAT(sErrorMessage, ')');
		logger(
			sMessage := sErrorMessage, 
			ePriority := LOGPRIORITY_ALERT
		);	
	bWarningLastPass := TRUE;
	iWarningCodeLastPass := iErrorCode;
	END_IF
ELSE
	bWarningLastPass := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="doState" Id="{7b90ca81-36be-4d85-971d-e4186c9550c6}">
      <Declaration><![CDATA[METHOD doState

VAR
	byte_true 			: BYTE :=1;
	fDevicePowerRating	: LREAL;
	
	sTemp : STRING; // temp string to help with intermediary formatting
END_VAR

VAR CONSTANT
	sJogInputStr : STRING(10) := 'DI1'; // jogging input always assumed to be DI1, for now
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE (machineState) OF
	KMOTORVFDSTATE_DISABLED:
		IF (bFirstPass) THEN
			// try to reset any faults on startup
			resetAllFlags();
			cmd_bResetError := TRUE;
		END_IF


	KMOTORVFDSTATE_ENABLING:
		IF (bFirstPass) THEN
			resetAllFlags();
		END_IF
		// wait for ethercat device to be ready
		IF (status_byDeviceState <> 0) THEN
			IF (status_bJogModeOn) THEN
				IF (config_bAllowJoggingOnStart) THEN
					IF (NOT bFinishedAllParam) THEN
						logger(ePriority := E_LogPriority.LOGPRIORITY_MESSAGE_HIGH, sMessage := 'Motor started in jog mode, delaying parameter write.');
					END_IF
					machineState := KMOTORVFDSTATE_JOG_MODE;
				ELSE
					status_bJoggingError := TRUE;
					machineState := KMOTORVFDSTATE_ERROR_DRIVE_FAULT;
				END_IF
			ELSE
				machineState := KMOTORVFDSTATE_PU_TYPE_CHECK;
			END_IF
		END_IF
		

	KMOTORVFDSTATE_PU_TYPE_CHECK:
		IF (bFirstPass) THEN
			sPUTypeCode :='';
		END_IF
		
		FB_EcCoESdoRead(			
			sNetId:= F_CreateAmsNetId(stAdsAddr.netId), 
			nSlaveAddr:= stAdsAddr.port, 
			nSubIndex:= 5, 
			nIndex:= 16#2002, 			
			pDstBuf := ADR(sPUTypeCode), 
			cbBufLen:= SIZEOF(sPUTypeCode), 
			bExecute:= bFirstPass, 
			tTimeout:= DEFAULT_ADS_TIMEOUT);
		IF (NOT FB_EcCoESdoRead.bBusy) THEN
			IF (NOT FB_EcCoESdoRead.bError) THEN 
				(* Read successful *)
				bCoEerror := FALSE;
				iCoEerrId := 0;
				IF (getDevicePowerRating(sPUTypeCode) = config_fDriveRatedPowerkW) THEN
					machineState := KMOTORVFDSTATE_SERIAL_CHECK;
				ELSIF (getDevicePowerRating(sPUTypeCode) = 0.0) THEN
					logger(sMessage := 'Drive Size Unknown, Please Contact Kval.', ePriority := LOGPRIORITY_ALERT);	
					machineState := KMOTORVFDSTATE_SERIAL_CHECK;
				ELSE
					fDevicePowerRating := getDevicePowerRating(sPUTypeCode);
					// build the summary string
					fbTaskMaster.fbFormatString(sFormat:='Drive Size %2.1f Kw is Wrong - Expected %2.1f Kw, Please Contact Kval.',
						arg1:= F_LREAL(fDevicePowerRating),
						arg2:= F_LREAL(config_fDriveRatedPowerkW));
					logger(sMessage := fbTaskMaster.fbFormatString.sOut, ePriority := LOGPRIORITY_ALERT);
					machineState := KMOTORVFDSTATE_SERIAL_CHECK;
				END_IF
			ELSE 
				(* Read failed *)
				bCoEerror := FB_EcCoESdoRead.bError;
				iCoEerrId := FB_EcCoESdoRead.nErrId;
				machineState := KMOTORVFDSTATE_ERROR_DRIVE_FAULT;
			END_IF
		END_IF

	KMOTORVFDSTATE_SERIAL_CHECK:
		IF (bFirstPass) THEN
			sTempSerialNumber :='';
		END_IF
		
		FB_EcCoESdoRead(			
			sNetId:= F_CreateAmsNetId(stAdsAddr.netId), 
			nSlaveAddr:= stAdsAddr.port, 
			nSubIndex:= 2, 
			nIndex:= 16#2000, 			
			pDstBuf := ADR(sTempSerialNumber), 
			cbBufLen:= SIZEOF(sTempSerialNumber), 
			bExecute:= bFirstPass, 
			tTimeout:= DEFAULT_ADS_TIMEOUT);
		IF (NOT FB_EcCoESdoRead.bBusy) THEN
			IF (NOT FB_EcCoESdoRead.bError) THEN 
				(* Read successful *)
				IF (sTempSerialNumber = 'XXXXXXXXXXXXXXXXXXXXXX') THEN
					machineState := KMOTORVFDSTATE_SERIAL_CU_CHECK;	
				ELSIF (sTempSerialNumber = sSerialNumber) THEN
					machineState := KMOTORVFDSTATE_PARAMETER_WRITE;	
				ELSE
					iVFDResetNeeded := iVFDResetNeeded+1;
					iVFDResetOrder := iVFDResetNeeded;
					logger(sMessage := 'New Serial# Detected, Factory Reset Started', ePriority := LOGPRIORITY_ALERT);	
					machineState := KMOTORVFDSTATE_FACTORY_RESET;
				END_IF
			ELSE 
				(* Read failed *)
				bCoEerror := FB_EcCoESdoRead.bError;
				iCoEerrId := FB_EcCoESdoRead.nErrId;
				machineState := KMOTORVFDSTATE_ERROR_DRIVE_FAULT;
			END_IF
		END_IF

	KMOTORVFDSTATE_SERIAL_CU_CHECK:
		IF (bFirstPass) THEN
			sTempCUSerialNumber :='';
		END_IF
		
		FB_EcCoESdoRead(			
			sNetId:= F_CreateAmsNetId(stAdsAddr.netId), 
			nSlaveAddr:= stAdsAddr.port, 
			nSubIndex:= 6, 
			nIndex:= 16#2002, 			
			pDstBuf := ADR(sTempCUSerialNumber), 
			cbBufLen:= SIZEOF(sTempCUSerialNumber), 
			bExecute:= bFirstPass, 
			tTimeout:= DEFAULT_ADS_TIMEOUT);
		IF (NOT FB_EcCoESdoRead.bBusy) THEN
			IF (NOT FB_EcCoESdoRead.bError) THEN 
				(* Read successful *)
				IF (sTempCUSerialNumber = sCUSerialNumber) THEN
					machineState := KMOTORVFDSTATE_PARAMETER_WRITE;	
				ELSE
					iVFDResetNeeded := iVFDResetNeeded+1;
					iVFDResetOrder := iVFDResetNeeded;
					logger(sMessage := 'New Serial# Detected, Factory Reset Started', ePriority := LOGPRIORITY_ALERT);	
					machineState := KMOTORVFDSTATE_FACTORY_RESET;
				END_IF
			ELSE 
				(* Read failed *)
				bCoEerror := FB_EcCoESdoRead.bError;
				iCoEerrId := FB_EcCoESdoRead.nErrId;
				machineState := KMOTORVFDSTATE_ERROR_DRIVE_FAULT;
			END_IF
		END_IF
		
	KMOTORVFDSTATE_FACTORY_RESET:
		FB_EcCoESdoWrite(
			sNetId:=F_CreateAmsNetId(stAdsAddr.netId),
			nSlaveAddr:=stAdsAddr.port,
			nIndex := 16#2022, 
			nSubIndex:= 1,
			pSrcBuf:= ADR(byte_true),
			cbBufLen:= 1,	
			bExecute:= bFirstPass, 
			tTimeout:= DEFAULT_ADS_TIMEOUT);
		IF (NOT FB_EcCoESdoWrite.bBusy) THEN
			IF (NOT FB_EcCoESdoWrite.bError) THEN 
				(* write successful *)
				machineState := KMOTORVFDSTATE_FACTORY_RESET_CHECK;
			ELSE 
				(* write failed *)
				bCoEerror := FB_EcCoESdoWrite.bError;
				iCoEerrId := FB_EcCoESdoWrite.nErrId;
				machineState := KMOTORVFDSTATE_ERROR_DRIVE_FAULT;
			END_IF
		END_IF	
		
	KMOTORVFDSTATE_FACTORY_RESET_CHECK:
		IF( bFirstPass) THEN
			idx := 0;
			read_byte := 1;
		END_IF
		FB_EcCoESdoRead(
			sNetId:=F_CreateAmsNetId(stAdsAddr.netId),
			nSlaveAddr:=stAdsAddr.port,
			nIndex := 16#2022, 
			nSubIndex:= 1,
			pDstBuf:=ADR(read_byte),
			cbBufLen:= 1,	
			bExecute:= (idx=0), 
			tTimeout:= DEFAULT_ADS_TIMEOUT);
		idx := idx +1;	
		IF (NOT FB_EcCoESdoRead.bBusy) AND (idx > 10) THEN
			IF (NOT FB_EcCoESdoRead.bError)THEN
				idx := 0;	
				IF (read_byte = 0) THEN									// Reset Complete
					iVFDReadyforReset := iVFDReadyforReset + 1;
					machineState := KMOTORVFDSTATE_WAIT_FOR_ETHERCAT_RESET;
				ELSIF (read_byte=3) THEN								//Action Cancelled
					machineState := KMOTORVFDSTATE_ERROR_DRIVE_FAULT;
				ELSIF (read_byte=4) THEN								//No Access
					machineState := KMOTORVFDSTATE_ERROR_DRIVE_FAULT;
				ELSIF (read_byte=5) THEN								//No Access (Inverter Disabled)
					machineState := KMOTORVFDSTATE_ERROR_DRIVE_FAULT;
				END_IF
			ELSE 
				(* write failed *)
				bCoEerror := FB_EcCoESdoRead.bError;
				iCoEerrId := FB_EcCoESdoRead.nErrId;
				machineState := KMOTORVFDSTATE_ERROR_DRIVE_FAULT;
			END_IF
		END_IF
		
	KMOTORVFDSTATE_WAIT_FOR_ETHERCAT_RESET:
		IF (iVFDReadyforReset = iVFDResetNeeded) OR (bVFDReadyforReset) THEN
			bVFDReadyforReset :=TRUE;
			IF (iVFDResetOrder = iVFDResetNeeded) THEN			
				machineState := KMOTORVFDSTATE_ETHERCAT_RESET;	
			END_IF
		END_IF
	
	KMOTORVFDSTATE_ETHERCAT_RESET:
		FB_EcCoESdoWrite(
			sNetId:=F_CreateAmsNetId(stAdsAddr.netId),
			nSlaveAddr:=stAdsAddr.port,
			nIndex := 16#2360, 
			nSubIndex:= 0,
			pSrcBuf:= ADR(byte_true),
			cbBufLen:= 1,	
			bExecute:= bFirstPass, 
			tTimeout:= DEFAULT_ADS_TIMEOUT);
		IF (NOT FB_EcCoESdoWrite.bBusy) THEN
			IF (NOT FB_EcCoESdoWrite.bError) THEN 
				(* write successful *)
				machineState := KMOTORVFDSTATE_ETHERCAT_RESET_CHECK;
			ELSE 
				(* write failed *)
				bCoEerror := FB_EcCoESdoWrite.bError;
				iCoEerrId := FB_EcCoESdoWrite.nErrId;
				machineState := KMOTORVFDSTATE_ERROR_DRIVE_FAULT;
			END_IF
		END_IF	
		
	KMOTORVFDSTATE_ETHERCAT_RESET_CHECK:
		fbTON_DriveEnableTimeout();	
		IF( bFirstPass) THEN
			idx := 0;
			read_byte := 1;
			fbTON_DriveEnableTimeout(IN:=FALSE);
			fbTON_DriveEnableTimeout(IN:=TRUE, PT:= T#5S);
		ELSIF (fbTON_DriveEnableTimeout.Q) THEN
			FB_EcCoESdoRead(
				sNetId:=F_CreateAmsNetId(stAdsAddr.netId),
				nSlaveAddr:=stAdsAddr.port,
				nIndex := 16#2360, 
				nSubIndex:= 0,
				pDstBuf:=ADR(read_byte),
				cbBufLen:= 1,	
				bExecute:= (idx=0), 
				tTimeout:= DEFAULT_ADS_TIMEOUT);
			idx := idx +1;	
			IF (NOT FB_EcCoESdoRead.bBusy) AND (idx > 10) THEN
				IF (NOT FB_EcCoESdoRead.bError)THEN
					idx := 0;	
					IF (read_byte = 0) THEN									// Reset Complete
						iVFDResetNeeded := iVFDResetNeeded-1;
						sSerialNumber := sTempSerialNumber;
						sCUSerialNumber := sTempCUSerialNumber;
						fbTaskMaster.cmd_bWritePersistent := (iVFDResetOrder = 1);
						machineState := KMOTORVFDSTATE_PARAMETER_WRITE;	
					ELSIF (read_byte=11) THEN								//Action Cancelled
						machineState := KMOTORVFDSTATE_ERROR_DRIVE_FAULT;
					ELSIF (read_byte=12) THEN								//Fault
						machineState := KMOTORVFDSTATE_ERROR_DRIVE_FAULT;
					END_IF
				ELSE 
					(* write failed *)
					bCoEerror := FB_EcCoESdoRead.bError;
					iCoEerrId := FB_EcCoESdoRead.nErrId;
					machineState := KMOTORVFDSTATE_ERROR_DRIVE_FAULT;
				END_IF
			END_IF
		END_IF	

	KMOTORVFDSTATE_PARAMETER_WRITE:
		IF (bFirstPass) THEN
			fbTON_DriveEnableTimeout(IN:=FALSE, PT:= T#1S);
		END_IF
				
		(* watch for dirve enabled error *)
		fbTON_DriveEnableTimeout(IN:=TRUE);
		
		// -- Stateful parameter write; call repeatedly until done --
		fcnDone := ParameterWrite(idx);	
		
		IF (status_bGeneralVFDError)THEN
			machineState := KMOTORVFDSTATE_ERROR_DRIVE_FAULT;
		ELSIF (bFinishedAllParam) AND (status_byDeviceState > 0) THEN // if we're done move on to the next state
			status_bReady := TRUE;
			machineState := KMOTORVFDSTATE_STOPPING;
		ELSIF (fbTON_DriveEnableTimeout.Q) THEN // if we have timed out, Retry
			logger(sMessage := Concat('Drive Failed to Initialize on Iteration: ',INT_TO_STRING(iRetryCount)), ePriority := LOGPRIORITY_WARNING_LOW );
			iRetryCount := iRetryCount +1;
			machineState := KMOTORVFDSTATE_ENABLING;
		ELSIF (bCoEerror) THEN
			logger(sMessage := CONCAT('CoE Parameter Write Error ID: ',UDINT_TO_STRING(iCoEerrId)), ePriority := LOGPRIORITY_WARNING_HIGH);	
			iRetryCount := iRetryCount +1;
			machineState := KMOTORVFDSTATE_ENABLING;
		ELSIF (fcnDone)THEN
			idx := idx + 1;
			fbTON_DriveEnableTimeout(IN:=FALSE);			(* clear timer *)				
		END_IF
		IF  (iRetryCount > iRetryLimit) THEN
			logger(sMessage := Concat('Drive Failed to Initialize, Max Iterations: ',INT_TO_STRING(iRetryLimit)) , ePriority := LOGPRIORITY_WARNING_HIGH );
			iRetryCount := 0;
			machineState := KMOTORVFDSTATE_ERROR_DRIVE_FAULT;
		END_IF

	KMOTORVFDSTATE_STOPPING:
		cmd_bStop := FALSE;
		IF (bFirstPass) THEN
			iAddedStoppingCycles:=0;
		END_IF
		IF (status_bGeneralVFDError) THEN
			machineState := KMOTORVFDSTATE_ERROR_DRIVE_FAULT;
		ELSIF (cmd_bForceLowEnergyState) THEN
			iAddedStoppingCycles := iAddedStoppingCycles +1;
			IF (iAddedStoppingCycles > (Floor( 10*100)+1)) THEN
				machineState := KMOTORVFDSTATE_STOPPED;
			END_IF
		ELSIF (status_bStopped) THEN
			iAddedStoppingCycles := iAddedStoppingCycles +1;
			IF (iAddedStoppingCycles > (Floor( config_fAddedStoppingTimeS*100)+1)) THEN
				machineState := KMOTORVFDSTATE_STOPPED;
			END_IF
		ELSIF (cmd_bFwd) AND (NOT bCmdSpeedOutOfBounds) THEN
			machineState := KMOTORVFDSTATE_FWD;
		ELSIF (cmd_bRev) AND (NOT bCmdSpeedOutOfBounds) THEN
			machineState := KMOTORVFDSTATE_REV;
		ELSIF (status_bJogModeOn) THEN
			machineState := KMOTORVFDSTATE_JOG_MODE;
		END_IF

	KMOTORVFDSTATE_STOPPED:
		cmd_bStop := FALSE;
		IF (status_bGeneralVFDError) THEN
			machineState := KMOTORVFDSTATE_ERROR_DRIVE_FAULT;
		// go back and finish writing parameters, if weren't written before
		// this only happens when the motor was jogging on startup
		ELSIF (NOT bFinishedAllParam) THEN
			machineState := KMOTORVFDSTATE_ENABLING;
		ELSIF (cmd_bFwd) AND (NOT bCmdSpeedOutOfBounds) THEN
			machineState := KMOTORVFDSTATE_FWD;
		ELSIF (cmd_bRev) AND (NOT bCmdSpeedOutOfBounds) THEN
			machineState := KMOTORVFDSTATE_REV;
		ELSIF (status_bJogModeOn) THEN
			machineState := KMOTORVFDSTATE_JOG_MODE;
		END_IF
		

	KMOTORVFDSTATE_FWD:
		cmd_bFwd := FALSE;
		IF (status_bGeneralVFDError) THEN
			machineState := KMOTORVFDSTATE_ERROR_DRIVE_FAULT;
		ELSIF (cmd_bRev) THEN
			machineState := KMOTORVFDSTATE_REV;
		ELSIF (cmd_bStop) THEN
			machineState := KMOTORVFDSTATE_STOPPING;
		ELSIF (status_bJogModeOn) THEN
			status_bJoggingError := TRUE;
		END_IF
		checkForStoppedError('cmd_bFwd');

	KMOTORVFDSTATE_REV:
		cmd_bRev := FALSE;
		IF (status_bGeneralVFDError) THEN
			machineState := KMOTORVFDSTATE_ERROR_DRIVE_FAULT;
		ELSIF (cmd_bFwd) THEN
			machineState := KMOTORVFDSTATE_FWD;
		ELSIF (cmd_bStop) THEN
			machineState := KMOTORVFDSTATE_STOPPING;
		ELSIF (status_bJogModeOn) THEN
			status_bJoggingError := TRUE;
		END_IF
		checkForStoppedError('cmd_bRev');
	
	KMOTORVFDSTATE_JOG_MODE:
		IF (bFirstPass) THEN
			status_bReady := TRUE;
		END_IF
		
		IF (status_bGeneralVFDError) THEN
			machineState := KMOTORVFDSTATE_ERROR_DRIVE_FAULT;
		END_IF
		
		IF (NOT status_bJogModeOn) THEN
			machineState := KMOTORVFDSTATE_STOPPING;
		ELSE
			IF (cmd_bFwd OR cmd_bRev OR cmd_bStop) THEN
				IF (cmd_bFwd) THEN
					cmd_bFwd := FALSE;
					sConflictingCmd := 'cmd_bFwd';
				ELSIF (cmd_bRev) THEN
					cmd_bRev := FALSE;
					sConflictingCmd := 'cmd_bRev';
				ELSIF (cmd_bStop) THEN
					cmd_bStop := FALSE;
					sConflictingCmd := 'cmd_bStop';
				END_IF
				status_bJoggingError := TRUE;
			END_IF
		END_IF

		
	KMOTORVFDSTATE_ERROR_DRIVE_FAULT:
		IF (bFirstPass) THEN
			(* update status *)
			status_bError := TRUE;
			status_bReady := FALSE;
			IF (status_bDriveError OR status_bDriveTrouble) THEN
					sErrorMessage := CONCAT(status_sMfgSpecificError, ' - Error Id# ');
					sErrorMessage := CONCAT(sErrorMessage, UDINT_TO_STRING(iErrorCode));
					sErrorMessage := CONCAT(sErrorMessage, ' - in state: ');
					sErrorMessage := CONCAT(sErrorMessage, getLastStateDescription());
					sErrorMessage := CONCAT(sErrorMessage, ' (');
					sErrorMessage := CONCAT(sErrorMessage, INT_TO_STRING(eLastCycleState));
					sErrorMessage := CONCAT(sErrorMessage, ')');
					logger(
						sMessage := sErrorMessage, 
						ePriority := LOGPRIORITY_ERROR
					);
			END_IF			
			IF (status_bEtherCATError) THEN
					sErrorMessage := CONCAT(status_sLinkState, ' - Error Id# ');
					sErrorMessage := CONCAT(sErrorMessage, UDINT_TO_STRING(status_byLinkState));
					sErrorMessage := CONCAT(sErrorMessage, ' - in state: ');
					sErrorMessage := CONCAT(sErrorMessage, getLastStateDescription());
					sErrorMessage := CONCAT(sErrorMessage, ' (');
					sErrorMessage := CONCAT(sErrorMessage, INT_TO_STRING(eLastCycleState));
					sErrorMessage := CONCAT(sErrorMessage, ')');
					logger(
						sMessage := sErrorMessage, 
						ePriority := LOGPRIORITY_ERROR
					);	
			END_IF		
			IF (status_byDeviceState > 8 OR status_byDeviceState < 1) THEN
					sErrorMessage := CONCAT(status_sDeviceState, ' - Error Id# ');
					sErrorMessage := CONCAT(sErrorMessage, UDINT_TO_STRING(status_byDeviceState));
					sErrorMessage := CONCAT(sErrorMessage, ' - in state: ');
					sErrorMessage := CONCAT(sErrorMessage, getLastStateDescription());
					sErrorMessage := CONCAT(sErrorMessage, ' (');
					sErrorMessage := CONCAT(sErrorMessage, INT_TO_STRING(eLastCycleState));
					sErrorMessage := CONCAT(sErrorMessage, ')');
					logger(
						sMessage := sErrorMessage, 
						ePriority := LOGPRIORITY_ERROR
					);			
			END_IF
			IF (bCoEerror) THEN
				IF (eLastCycleState = KMOTORVFDSTATE_PARAMETER_WRITE) THEN
					sErrorMessage := 'Parameter Write Failed on Index# ';
					sErrorMessage := CONCAT(sErrorMessage, INT_TO_STRING(idx));
					sErrorMessage := CONCAT(sErrorMessage, ' - Error Id# ');
					sErrorMessage := CONCAT(sErrorMessage, UDINT_TO_STRING(iCoEerrId));
				ELSE
					sErrorMessage := 'COE Read/Write Error - Error Id# ';
					sErrorMessage := CONCAT(sErrorMessage, UDINT_TO_STRING(iCoEerrId));
					sErrorMessage := CONCAT(sErrorMessage, ' - in state: ');
					sErrorMessage := CONCAT(sErrorMessage, getLastStateDescription());
					sErrorMessage := CONCAT(sErrorMessage, ' (');
					sErrorMessage := CONCAT(sErrorMessage, INT_TO_STRING(eLastCycleState));
					sErrorMessage := CONCAT(sErrorMessage, ')');
				END_IF
				
					logger(
						sMessage := sErrorMessage, 
						ePriority := LOGPRIORITY_ERROR
					);
			END_IF
			IF (status_bJoggingError) THEN
				IF (sConflictingCmd = '') THEN
					sErrorMessage := 'Jog input (';
					sErrorMEssage := CONCAT(sErrorMessage, sJogInputStr);
					sErrorMEssage := CONCAT(sErrorMessage, ') detected at invalid time - in state: ');
					sErrorMessage := CONCAT(sErrorMessage, getLastStateDescription());
					sErrorMessage := CONCAT(sErrorMessage, ' (');
					sErrorMessage := CONCAT(sErrorMessage, INT_TO_STRING(eLastCycleState));
					sErrorMessage := CONCAT(sErrorMessage, ')');
					logger(
						sMessage := sErrorMessage, 
						ePriority := LOGPRIORITY_ERROR
					);
				ELSE
					logger.fbFString(sFormat := 'Received command %s, but jog input (%s) is on.', arg1 := F_STRINGEx(sConflictingCmd), arg2 := F_STRINGEx(sJogInputStr));
					sErrorMEssage := CONCAT(logger.fbFString.sOut ,' - in state: ');
					sErrorMessage := CONCAT(sErrorMessage, getLastStateDescription());
					sErrorMessage := CONCAT(sErrorMessage, ' (');
					sErrorMessage := CONCAT(sErrorMessage, INT_TO_STRING(eLastCycleState));
					sErrorMessage := CONCAT(sErrorMessage, ')');
					logger(
						sMessage := sErrorMessage, 
						ePriority := LOGPRIORITY_ERROR
					);
				END_IF
			END_IF
			IF (status_bStoppedError) THEN
				sErrorMEssage := CONCAT(sConflictingCmd, ' command received, but drive is stopped');
				sErrorMEssage := CONCAT(sErrorMEssage,' - in state: ');
				sErrorMessage := CONCAT(sErrorMessage, getLastStateDescription());
				sErrorMessage := CONCAT(sErrorMessage, ' (');
				sErrorMessage := CONCAT(sErrorMessage, INT_TO_STRING(eLastCycleState));
				sErrorMessage := CONCAT(sErrorMessage, ')');
				logger(
					sMessage := sErrorMessage, 
					ePriority := LOGPRIORITY_ERROR
				);
			END_IF
		END_IF
		
		// Recovery
		IF (status_bJoggingError) THEN
			status_bJoggingError := status_bJogModeOn;
		END_IF
		status_bStoppedError := FALSE;
		IF (NOT (status_bGeneralVFDError OR bCoEerror)) THEN
			machineState := KMOTORVFDSTATE_DISABLED;
		END_IF


END_CASE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="EncodeControlWord" Id="{cb0deefe-7afa-42ca-b95c-511493d6c7bf}">
      <Declaration><![CDATA[METHOD EncodeControlWord
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[iControlWord.15		:= cmd_bEnableRelay;	(* Enable Relay *)

(* Reset Error *)
IF (cmd_bResetError) THEN
	iControlWord.7 := TRUE;
	cmd_bResetError := status_bGeneralVFDError;
ELSE
	iControlWord.7 := FALSE;
END_IF

CASE (machineState) OF
	
	KMOTORVFDSTATE_DISABLED:
		IF (status_bMoving) THEN
			iControlWord.0		:= FALSE; 				(* Disable Inverter *)
			iControlWord.2 		:= TRUE; 				(* Activate Quickstop *)
			iControlWord.4		:= TRUE;				(* Run Forward CW *)
			iControlWord.12		:= FALSE;				(* Invert Rotation *)	
		ELSIF (status_bStopped) THEN
			iControlWord.0		:= TRUE; 				(* Disable Inverter *)
			iControlWord.2 		:= TRUE; 				(* Activate Quickstop *)
			iControlWord.4		:= FALSE;				(* Run Forward CW *)
			iControlWord.12		:= FALSE;				(* Invert Rotation *)
		END_IF

	KMOTORVFDSTATE_ENABLING:
		iControlWord.0		:= FALSE; 				(* Disable Inverter *)
		iControlWord.2 		:= TRUE; 				(* Activate Quickstop *)
		iControlWord.4		:= FALSE;				(* Run Forward CW *)
		iControlWord.12		:= FALSE;				(* Invert Rotation *)
		
	KMOTORVFDSTATE_FACTORY_RESET:	
		iControlWord.0		:= FALSE; 				(* Disable Inverter *)
		iControlWord.2 		:= FALSE; 				(* Activate Quickstop *)
		iControlWord.4		:= FALSE;				(* Run Forward CW *)
		iControlWord.12		:= FALSE;				(* Invert Rotation *)
		
	KMOTORVFDSTATE_FACTORY_RESET_CHECK:	
		iControlWord.0		:= FALSE; 				(* Disable Inverter *)
		iControlWord.2 		:= FALSE; 				(* Activate Quickstop *)
		iControlWord.4		:= FALSE;				(* Run Forward CW *)
		iControlWord.12		:= FALSE;				(* Invert Rotation *)
		
	KMOTORVFDSTATE_STOPPING:	
		iControlWord.0		:= FALSE; 				(* Disable Inverter *)
		iControlWord.2 		:= NOT bDisableQuickStop;(* Activate Quickstop *)
		iControlWord.4		:= NOT bDisableQuickStop;(* Run Forward CW *)
		iControlWord.12		:= FALSE;				(* Invert Rotation *)
		
	KMOTORVFDSTATE_STOPPED:	
		iControlWord.0		:= FALSE; 				(* Disable Inverter *)
		iControlWord.2 		:= FALSE; 				(* Activate Quickstop *)
		iControlWord.4		:= FALSE;				(* Run Forward CW *)
		iControlWord.12		:= FALSE;				(* Invert Rotation *)
	
	KMOTORVFDSTATE_FWD:
		iControlWord.0		:= FALSE; 				(* Disable Inverter *)
		iControlWord.2 		:= FALSE; 				(* Activate Quickstop *)
		iControlWord.4		:= TRUE;				(* Run Forward CW *)
		iControlWord.12		:= FALSE XOR config_bReverseRotation;	(* Invert Rotation *)
	
	KMOTORVFDSTATE_REV:
		iControlWord.0		:= FALSE; 				(* Disable Inverter *)
		iControlWord.2 		:= FALSE; 				(* Activate Quickstop *)
		iControlWord.4		:= TRUE;				(* Run Forward CW *)
		iControlWord.12		:= TRUE XOR config_bReverseRotation;	(* Invert Rotation *)
	
	KMOTORVFDSTATE_ERROR_DRIVE_FAULT:
		iControlWord.0		:= TRUE; 				(* Disable Inverter *)
		iControlWord.2 		:= TRUE; 				(* Activate Quickstop *)
		iControlWord.4		:= FALSE;				(* Run Forward CW *)
		iControlWord.12		:= FALSE;				(* Invert Rotation *)
		
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="GenMfgSpecificErrorStr" Id="{af165e00-771a-422f-9689-a954e95f4f28}">
      <Declaration><![CDATA[METHOD GenMfgSpecificErrorStr
