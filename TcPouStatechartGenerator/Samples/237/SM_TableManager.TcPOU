(ID := 18, Name := 'TABLEMANAGER_DOOR_TRACKER_WAIT_FOR_DATA_READY_OR_TRANSFERRED_IN', StateType := _UML_SC_StateTypes.SlowState, StartOfTransitionIndex := 92, OutGoingTransitionsCount := 9, RegionCount := 0, RegionStartIndex := 0, RegionEndIndex := 0, CompletionTransitionID := 0, MaxDoCycles := 32766, HasEntryAction := True, HasDoAction := True, HasExitAction := True) , 
