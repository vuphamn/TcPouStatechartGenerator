    <Method Name="setNewTargetFeedoutPortSelected" Id="{2d7f9ec5-2151-41fc-905a-30f627a21c01}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD setNewTargetFeedoutPortSelected
VAR_INPUT
	stDoorTrackOther : ST_DoorTrack;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[cmd_bNewTargetFeedoutPortSelected := 
	bHasDoor
;
IF cmd_bNewTargetFeedoutPortSelected THEN
	cmd_stNewTargetFeedoutPort.TableIndex := stDoorTrackOther.Target;
	cmd_stNewTargetFeedoutPort.Side := stDoorTrackOther.TargetFeedoutSide;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="setNextDoorId" Id="{b6fcee3a-b6e4-44da-b88e-781a674e1d02}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD setNextDoorId
VAR_INPUT	
END_VAR
VAR 
	i : INT;
	doorId : INT;
	doorIdInUsed : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stDoorTrack.DoorId := 0;
FOR doorId := 1 TO MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.TablesCount DO
	doorIdInUsed := FALSE;
	FOR i:=0 TO MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.TablesCount-1 DO
		IF NOT MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].IsFunctionalTable THEN
			CONTINUE;
		END_IF
		IF MAIN.mainStateMachine.asmTableManagers[i].bHasDoor AND MAIN.mainStateMachine.asmTableManagers[i].stDoorTrack.DoorId = doorId THEN
			doorIdInUsed := TRUE;
			EXIT;
		END_IF
	END_FOR
	IF NOT doorIdInUsed THEN
		stDoorTrack.DoorId := doorId;
		RETURN;
	END_IF
END_FOR

]]></ST>
      </Implementation>
    </Method>
    <Method Name="setOkToFeedOutSidesTest" Id="{04f1118d-6181-406b-9983-1d152ac6c798}" FolderPath="test\">
      <Declaration><![CDATA[METHOD setOkToFeedOutSidesTest
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF config_bNoHardwareTestMode THEN
	IF config_bIsConveyorTable THEN
		smC235FeedManager.di_OkToFeedOutSideC := TRUE;
		smC235FeedManager.di_OkToFeedOutSideD := TRUE;
	ELSE
		smC234FeedManager.di_OkToFeedOutSideA := TRUE;
		smC234FeedManager.di_OkToFeedOutSideB := TRUE;
		smC234FeedManager.di_OkToFeedOutSideC := TRUE;
		smC234FeedManager.di_OkToFeedOutSideD := TRUE;
	END_IF
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="setReadyToFeedoutSide" Id="{fc17bb31-531b-495b-b0df-a38ca8e8c6da}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD setReadyToFeedoutSide
VAR_INPUT
	bReadyToFeedoutSide : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF config_bIsConveyorTable THEN
	IF smC235FeedManager.cmd_eFeedoutSide = E_FeedoutSideType.C THEN
		smC235FeedManager.setReadyToFeedoutSideC(bReadyToFeedoutSide);
	ELSIF smC235FeedManager.cmd_eFeedoutSide = E_FeedoutSideType.D THEN
		smC235FeedManager.setReadyToFeedoutSideD(bReadyToFeedoutSide);
	END_IF
ELSE	
	IF smC234FeedManager.cmd_eFeedoutSide = E_FeedoutSideType.A THEN
		smC234FeedManager.setReadyToFeedoutSideA(bReadyToFeedoutSide);
	ELSIF smC234FeedManager.cmd_eFeedoutSide = E_FeedoutSideType.B THEN
		smC234FeedManager.setReadyToFeedoutSideB(bReadyToFeedoutSide);
	ELSIF smC234FeedManager.cmd_eFeedoutSide = E_FeedoutSideType.C THEN
		smC234FeedManager.setReadyToFeedoutSideC(bReadyToFeedoutSide);
	ELSIF smC234FeedManager.cmd_eFeedoutSide = E_FeedoutSideType.D THEN
		smC234FeedManager.setReadyToFeedoutSideD(bReadyToFeedoutSide);
	END_IF
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="setReadyToFeedoutSides" Id="{e81deb71-8bd3-46ff-9aaa-17c8aa940969}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD setReadyToFeedoutSides
VAR_INPUT
	bReadyToFeedoutSide : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[smC234FeedManager.setReadyToFeedoutSideA(bReadyToFeedoutSide);
smC234FeedManager.setReadyToFeedoutSideB(bReadyToFeedoutSide);
smC234FeedManager.setReadyToFeedoutSideC(bReadyToFeedoutSide);
smC234FeedManager.setReadyToFeedoutSideD(bReadyToFeedoutSide);
smC235FeedManager.setReadyToFeedoutSideC(bReadyToFeedoutSide);
smC235FeedManager.setReadyToFeedoutSideD(bReadyToFeedoutSide);
]]></ST>
      </Implementation>
    </Method>
