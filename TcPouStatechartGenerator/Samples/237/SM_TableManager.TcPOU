    <Method Name="hasDeadlockedDoorInPath" Id="{7d767058-f468-42fc-9c91-690e29e49ed4}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD hasDeadlockedDoorInPath : BOOL
VAR_INPUT
	pstPath : POINTER TO ST_PathInfo;
END_VAR
VAR
	i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[hasDeadlockedDoorInPath := FALSE;
IF pstPath = 0 THEN	
	RETURN;
END_IF

FOR i:= 0 TO pstPath^.PathCount - 1 DO
	IF MAIN.mainStateMachine.asmTableManagers[pstPath^.Path[i].TableIndex].bHasDoor AND 
		(MAIN.mainStateMachine.asmTableManagers[pstPath^.Path[i].TableIndex].bWaitingForClearRoute OR
		MAIN.mainStateMachine.asmTableManagers[pstPath^.Path[i].TableIndex].bAllTargetFeedoutPortsDisabled OR
		MAIN.mainStateMachine.asmTableManagers[pstPath^.Path[i].TableIndex].bDoorHasNoTarget)
	THEN
		hasDeadlockedDoorInPath := TRUE;
		RETURN;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="hasDoorGoingOppositeDirection" Id="{d03ba15b-9e9a-473e-a09b-09f80459e23b}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD hasDoorGoingOppositeDirection : BOOL
VAR_INPUT
	pstPath : POINTER TO ST_PathInfo;
END_VAR
VAR
	i : INT;
	j : INT;
	k : INT;
	intersectAtTableIndex : INT;
	prevDoorDirection : E_Direction;
	curDoorDirection : E_Direction;
	otherDoorDirection : E_Direction;
	pstPathOther : POINTER TO ST_PathInfo;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[hasDoorGoingOppositeDirection := FALSE;
IF pstPath = 0 THEN	
	RETURN;
END_IF

FOR i:= 0 TO pstPath^.PathCount - 1 DO
	intersectAtTableIndex := pstPath^.Path[i].TableIndex;
	IF MAIN.mainStateMachine.asmTableManagers[intersectAtTableIndex].stDoorTrack.Target <> -1 THEN
		pstPathOther := ADR(MAIN.mainStateMachine.asmTableManagers[intersectAtTableIndex].stDoorTrack.TargetPath);
		FOR j:= 0 TO pstPathOther^.PathCount - 1 DO
			prevDoorDirection := E_Direction.None;
			FOR k:= 0 TO pstPath^.PathCount - 1 DO				
				curDoorDirection := pstPath^.Path[k].Direction;
				IF pstPathOther^.Path[j].TableIndex = pstPath^.Path[k].TableIndex THEN
					otherDoorDirection  := pstPathOther^.Path[j].Direction;
					IF 	curDoorDirection = E_Direction.North 	AND otherDoorDirection = E_Direction.South OR
						curDoorDirection = E_Direction.South 	AND otherDoorDirection = E_Direction.North OR
						curDoorDirection = E_Direction.West 	AND otherDoorDirection = E_Direction.East OR
						curDoorDirection = E_Direction.East 	AND otherDoorDirection = E_Direction.West OR
						prevDoorDirection = E_Direction.North 	AND otherDoorDirection = E_Direction.South OR
						prevDoorDirection = E_Direction.South 	AND otherDoorDirection = E_Direction.North OR
						prevDoorDirection = E_Direction.West 	AND otherDoorDirection = E_Direction.East OR
						prevDoorDirection = E_Direction.East 	AND otherDoorDirection = E_Direction.West
					THEN
						hasDoorGoingOppositeDirection := TRUE;
						RETURN;
					END_IF
				END_IF
				prevDoorDirection := curDoorDirection;
			END_FOR
		END_FOR
	END_IF
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="hasEmptyTableInPath" Id="{3fc6f488-6f3b-48f0-9665-4db354def7f8}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD hasEmptyTableInPath : BOOL
VAR_INPUT
	pstPath : POINTER TO ST_PathInfo;
END_VAR
VAR
	i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pstPath = 0 THEN
	hasEmptyTableInPath := FALSE;
	RETURN;
END_IF

IF pstPath^.PathCount = 0 THEN
	hasEmptyTableInPath := FALSE;
	RETURN;
END_IF

IF pstPath^.PathCount = 1 THEN
	hasEmptyTableInPath := NOT MAIN.mainStateMachine.asmTableManagers[pstPath^.Path[0].TableIndex].bHasDoor;
	RETURN;
END_IF

// skip index 0, which is the source/first table in path.
FOR i:= 1 TO pstPath^.PathCount - 1 DO
	IF NOT MAIN.mainStateMachine.asmTableManagers[pstPath^.Path[i].TableIndex].bHasDoor THEN
		hasEmptyTableInPath := TRUE;
		RETURN;
	END_IF
END_FOR

hasEmptyTableInPath := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="hasError" Id="{2c61bbda-1b42-49bc-8a59-a85cdaf154bd}">
      <Declaration><![CDATA[METHOD hasError : bool

]]></Declaration>
      <Implementation>
        <ST><![CDATA[hasError := smDoorDasher.bError;
IF hasError THEN
	RETURN;
END_IF

IF config_bIsConveyorTable THEN
	hasError := smC235FeedManager.bError;
ELSE
	hasError := smC234FeedManager.bError;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="hasErrorDescription" Id="{1faa15b1-5213-4852-af31-65adb95f968b}">
      <Declaration><![CDATA[METHOD hasErrorDescription : T_MaxString

]]></Declaration>
      <Implementation>
        <ST><![CDATA[hasErrorDescription := smDoorDasher.sError;
IF hasErrorDescription <> '' THEN
	RETURN;
END_IF

IF config_bIsConveyorTable THEN
	hasErrorDescription := smC235FeedManager.sError;
ELSE
	hasErrorDescription := smC234FeedManager.sError;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="hasErrorId" Id="{9c82927c-e4ba-48de-956e-36421fafaa17}">
      <Declaration><![CDATA[METHOD hasErrorId : UINT

]]></Declaration>
      <Implementation>
        <ST><![CDATA[hasErrorId := INT_TO_UINT(smDoorDasher.iLastErrorId);
IF hasErrorId <> 0 THEN
	RETURN;
END_IF

IF config_bIsConveyorTable THEN
	hasErrorId := INT_TO_UINT(smC235FeedManager.iLastErrorId);
ELSE
	hasErrorId := INT_TO_UINT(smC234FeedManager.iLastErrorId);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="hasIncomingDoorInPath" Id="{ad3e0b4b-e655-460d-af27-fbf5c8db8edd}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD hasIncomingDoorInPath : BOOL
VAR_INPUT
	pstPath : POINTER TO ST_PathInfo;
END_VAR
VAR
	i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[hasIncomingDoorInPath := FALSE;
IF pstPath = 0 THEN	
	RETURN;
END_IF

FOR i:= 0 TO pstPath^.PathCount - 1 DO
	IF MAIN.mainStateMachine.asmTableManagers[pstPath^.Path[i].TableIndex].bRouteReadyWaitForFeedIn THEN
		hasIncomingDoorInPath := TRUE;
		RETURN;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="initDoorTrack" Id="{49c6cea8-7efe-4c11-a190-4a562681b896}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD initDoorTrack
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stDoorTrackLast := stDoorTrack; 

stDoorTrack.CandidateRoutes := stCandidateRoutesDefault;
stDoorTrack.SearchResults := stSearchResultsDefault;
stDoorTrack.TargetPath := stPathInfoDefault;

bHasEnabledFeedoutPorts := FALSE;

IF cmd_bRequestNewRoute THEN
	stDoorTrack.AllEnabledFeedoutPorts := stFeedoutPortsConfigDefault;
	stDoorTrack.RejectedFeedoutPorts := stFeedoutPortsConfigDefault;
	stDoorTrack.ReroutableFeedoutPorts := stReroutableFeedoutPortsConfigDefault;
	stDoorTrack.RejectedFeedoutPorts.FeedoutPortsCount := -1; // Notifies HMI to clear the rejected feed-out ports list for operator's manual re-route.
	stDoorTrack.ReroutableFeedoutPorts.FeedoutPortsCount := -1; // Notifies HMI to clear the reroutable feed-out ports list for operator's manual re-route.
ELSE
	stDoorTrack.TargetFeedoutPorts := stFeedoutPortsConfigDefault;
	stDoorTrack.DoorIsRotating := FALSE;
	stDoorTrack.DoorRotateRequired := FALSE;
	stDoorTrack.DoorWasRotated := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="initialize" Id="{4805b685-66bc-4917-916b-42c030f9c476}">
      <Declaration><![CDATA[METHOD initialize
VAR CONSTANT		
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.initialize();

descriptor.sModuleClass := 'TableManager';

// TODO: don't init if config_pstHcTransferTableHardware and config_pstHcConveyorHardware are null
config_pstHcTransferTableHardware;
config_pstHcConveyorHardware;

// initialize machine configs and defaults
cmd_bManualControlEnabled := config_bManualControlEnabled;

(*     --- Feed System ---     *)
IF config_bIsConveyorTable THEN
	//
	iCrossFeedFastSpeedRpm	:= LREAL_TO_UINT(config_iCrossFeedFastSpeedFPM / CONVEYOR_CROSSFEED_RPM_TO_FPM);
	iCrossFeedSlowSpeedRpm	:= LREAL_TO_UINT(config_iCrossFeedSlowSpeedFPM / CONVEYOR_CROSSFEED_RPM_TO_FPM);
	iFeedFastSpeedRPM		:= iCrossFeedFastSpeedRpm;
	iFeedSlowSpeedRPM 		:= iCrossFeedSlowSpeedRpm;
	iFeedOutSpeedRPM		:= 0; // not used for Conveyor table
	IF (config_pstHcConveyorHardware <> 0) THEN
		psmHcFeedMotor := ADR(config_pstHcConveyorHardware^.smFeedMotor);
	END_IF
ELSE
	//
	iCrossFeedFastSpeedRpm	:= LREAL_TO_UINT(config_iCrossFeedFastSpeedFPM / TABLE_CROSSFEED_RPM_TO_FPM);
	iCrossFeedSlowSpeedRpm	:= LREAL_TO_UINT(config_iCrossFeedSlowSpeedFPM / TABLE_CROSSFEED_RPM_TO_FPM);
	iFeedFastSpeedRPM		:= LREAL_TO_UINT(config_iFeedFastSpeedFPM / TABLE_INLINE_FEED_RPM_TO_FPM);
	iFeedSlowSpeedRPM 		:= LREAL_TO_UINT(config_iFeedSlowSpeedFPM / TABLE_INLINE_FEED_RPM_TO_FPM);
	iFeedOutSpeedRPM		:= LREAL_TO_UINT(config_iFeedOutSpeedFPM  / TABLE_INLINE_FEED_RPM_TO_FPM);
	IF (config_pstHcTransferTableHardware <> 0) THEN
		psmHcFeedMotor := ADR(config_pstHcTransferTableHardware^.smFeedMotor);
	END_IF
END_IF

IF (psmHcFeedMotor = 0) THEN
	logger(ePriority := E_LogPriority.LOGPRIORITY_WARNING_LOW, sMessage := 'Incorrect config - assigning dummy pointer to VFD');
	psmHcFeedMotor := ADR(MAIN.mainStateMachine.smDummyMotor);
END_IF
	
{IF defined (noHW) OR defined (noHW_UML)}
	// these are for no hardware mode only...
	psmHcFeedMotor^.config_bNoHardwareTestMode := config_bNoHardwareTestMode;
	psmHcFeedMotor^.config_fTestMaxAccel := 24; // unit: in/s^2
	psmHcFeedMotor^.config_fTestMaxDecel := 24; // unit: in/s^2
	psmHcFeedMotor^.config_fTestMaxJerk := 144; // unit: in/s^3
	psmHcFeedMotor^.config_fTestMaxSpeed := 30; // unit : in/sec
	
	IF psmHcFeedMotor^.config_iFastSpeedRPM = 0 THEN
		psmHcFeedMotor^.config_iFastSpeedRPM := 1345;
	END_IF
	psmHcFeedMotor^.config_fUnitConversionFactor := (config_iFeedFastSpeedFPM * 12.0) / (psmHcFeedMotor^.config_iFastSpeedRPM * 60.0);
{END_IF}

// Assign dummy values preemptively - if have correct link to hardware, will get overwritten
// Have to assign these here, in initialize, because SM_TableManager references some of these in preProcess
smC234FeedManager.psmCrossFeedFenceHeightCyl 					:= ADR(MAIN.mainStateMachine.smDummyCylinder);
smC234FeedManager.psmCrossFeedTransferHeightCyl 				:= ADR(MAIN.mainStateMachine.smDummyCylinder);
smC234FeedManager.smSelfCenterManager.psmSelfCenterWheelsCyl 	:= ADR(MAIN.mainStateMachine.smDummyCylinder);
smC234FeedManager.smSelfCenterManager.psmSelfCenterCyl 			:= ADR(MAIN.mainStateMachine.smDummyCylinder);
smC234FeedManager.smRotateManager.psmDoorLiftCyl				:= ADR(MAIN.mainStateMachine.smDummyCylinder);
smC234FeedManager.smRotateManager.psmRotateCyl					:= ADR(MAIN.mainStateMachine.smDummyDoubleCylinder);
	
IF config_bIsConveyorTable THEN
	addChildStateMachine('C235 Feed Manager', ADR(smC235FeedManager)); 
		smC235FeedManager.pbTableIsEmpty := ADR(bTableIsEmpty);
		smC235FeedManager.pbDoorInMachine := ADR(bDoorInMachine);
		smC235FeedManager.pstTable := THIS;
		smC235FeedManager.pstDoorTrack := ADR(stDoorTrack);
		smC235FeedManager.itfDoorTracker := THIS^;
		smC235FeedManager.psmFeedMotor := psmHcFeedMotor;
		smC235FeedManager.config_iFeedOutSpeedRPM := iCrossFeedFastSpeedRPM;
		smC235FeedManager.config_iCrossFastSpeedRPM := iCrossFeedFastSpeedRPM;
		smC235FeedManager.config_iCrossSlowSpeedRPM := iCrossFeedSlowSpeedRPM;
		smC235FeedManager.config_bNoHardwareTestMode := config_bNoHardwareTestMode;
		smC235FeedManager.config_iTableArrayIndex := config_iTableArrayIndex;
ELSE		
	addChildStateMachine('C234 Feed Manager', ADR(smC234FeedManager));
		smC234FeedManager.pbTableIsEmpty := ADR(bTableIsEmpty);
		smC234FeedManager.pbDoorInMachine := ADR(bDoorInMachine);
		smC234FeedManager.pstTable := THIS;
		smC234FeedManager.pstDoorTrack := ADR(stDoorTrack);
		smC234FeedManager.itfDoorTracker := THIS^;
		smC234FeedManager.config_bCanRotate := config_bCanRotate;
		smC234FeedManager.config_bCanSelfCenter := config_bCanSelfCenter;
		smC234FeedManager.config_bIsBufferTable := config_bIsBufferTable;
		smC234FeedManager.psmFeedMotor := psmHcFeedMotor;
		smC234FeedManager.config_iFastSpeedRPM := iFeedFastSpeedRPM;
		smC234FeedManager.config_iSlowSpeedRPM := iFeedSlowSpeedRPM;
		smC234FeedManager.config_iFeedOutSpeedRPM := iFeedOutSpeedRPM;
		smC234FeedManager.config_iCrossFastSpeedRPM := iCrossFeedFastSpeedRPM;
		smC234FeedManager.config_iCrossSlowSpeedRPM := iCrossFeedSlowSpeedRPM;
		smC234FeedManager.config_bNoHardwareTestMode := config_bNoHardwareTestMode;
		smC234FeedManager.config_iTableArrayIndex := config_iTableArrayIndex;
		// Assign valve pointers
		IF (config_pstHcTransferTableHardware <> 0) THEN
			smC234FeedManager.psmCrossFeedFenceHeightCyl 					:= ADR(config_pstHcTransferTableHardware^.smCrossFeedFenceHeightCyl);
			smC234FeedManager.psmCrossFeedTransferHeightCyl 				:= ADR(config_pstHcTransferTableHardware^.smCrossFeedTransferHeightCyl);
			smC234FeedManager.smSelfCenterManager.psmSelfCenterWheelsCyl 	:= ADR(config_pstHcTransferTableHardware^.smSelfCenterWheelsCyl);
			smC234FeedManager.smSelfCenterManager.psmSelfCenterCyl 			:= ADR(config_pstHcTransferTableHardware^.smSelfCenterCyl);
			smC234FeedManager.smRotateManager.psmDoorLiftCyl 				:= ADR(config_pstHcTransferTableHardware^.smDoorLiftCyl);
			smC234FeedManager.smRotateManager.psmRotateCyl 					:= ADR(config_pstHcTransferTableHardware^.smRotateCyl);
		ELSE
			logger(ePriority := E_LogPriority.LOGPRIORITY_WARNING_LOW, sMessage := 'Incorrect config - assigning dummy pointer to valves');
		END_IF
END_IF

addChildStateMachine('Door Dasher', ADR(smDoorDasher));
	smDoorDasher(
		pstTable := THIS,
		pstDoorTrack := ADR(stDoorTrack),
		itfDoorTracker := THIS^,
		config_bNoHardwareTestMode := config_bNoHardwareTestMode,
		config_iTableArrayIndex := config_iTableArrayIndex
	);]]></ST>
      </Implementation>
    </Method>
    <Method Name="initInputSourceAndDestinationIndexWithHighestFeedoutPortsCount" Id="{5c4a8618-d381-4871-a72a-b30663d1ea99}">
      <Declaration><![CDATA[METHOD initInputSourceAndDestinationIndexWithHighestFeedoutPortsCount : BOOL
VAR_IN_OUT
	iInputSource	: INT;
	iDestinationIndex	: INT;
END_VAR
VAR 
	iInputSourceIndex : INT;
	iDestIndex : INT;
	feedoutPortsCountMax : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[iInputSource := 0;
iDestinationIndex := 0;
feedoutPortsCountMax := 0;

FOR iInputSourceIndex:=0 TO MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.TablesCount-1 DO
	IF NOT (MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[iInputSourceIndex].IsFunctionalTable AND
			MAIN.mainStateMachine.asmTableManagers[iInputSourceIndex].config_bCanFeedinFromSideA) THEN
		CONTINUE;
	END_IF
	IF MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[iInputSourceIndex].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappingsCount > 0 THEN
		FOR iDestIndex:=0 TO MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[iInputSourceIndex].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappingsCount - 1 DO
			IF MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[iInputSourceIndex].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappings[iDestIndex].FeedoutPortsCount > feedoutPortsCountMax THEN
				iInputSource := iInputSourceIndex;
				iDestinationIndex := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[iInputSourceIndex].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappings[iDestIndex].DestinationIndex;
				feedoutPortsCountMax := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[iInputSourceIndex].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappings[iDestIndex].FeedoutPortsCount;
			END_IF
		END_FOR
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="isCurrentTargetFeedoutPortEnabled" Id="{8fdb5738-35be-4b91-9480-4162dff3ade2}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD isCurrentTargetFeedoutPortEnabled : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[isCurrentTargetFeedoutPortEnabled := FALSE;
IF 	stDoorTrack.Target <> -1 THEN		
	isCurrentTargetFeedoutPortEnabled := MAIN.mainStateMachine.asmTableManagers[stDoorTrack.Target].isFeedoutSideEnabled(stDoorTrack.TargetFeedoutSide);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="isCurrentTargetFeedoutPortExistInDestinationIndexFeedoutPorts" Id="{9e6a027e-10ab-406b-b13c-55256f92c2b6}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[// if currentTargetFeedoutPort exists in DestinationIndex, then the current Target was a re-route.
METHOD isCurrentTargetFeedoutPortExistInDestinationIndexFeedoutPorts : BOOL
VAR_INPUT
END_VAR
VAR
	i : INT;
	j : INT;
	k : INT;
	stFeedoutPort : ST_FeedoutPort;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[isCurrentTargetFeedoutPortExistInDestinationIndexFeedoutPorts := FALSE;
IF 	stDoorTrack.DestinationIndex <> -1 AND
	stDoorTrack.Target <> -1 
	THEN
	i := stDoorTrack.Source;
	IF MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappingsCount > 0 THEN
		FOR j:=0 TO MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappingsCount - 1 DO
			IF MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappings[j].DestinationIndex = stDoorTrack.DestinationIndex THEN
				IF MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappings[j].FeedoutPortsCount > 0 THEN
					FOR k:=0 TO MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappings[j].FeedoutPortsCount - 1 DO
						stFeedoutPort := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappings[j].FeedoutPorts[k];
						IF stFeedoutPort.TableIndex = stDoorTrack.Target AND stFeedoutPort.Side = stDoorTrack.TargetFeedoutSide THEN
							isCurrentTargetFeedoutPortExistInDestinationIndexFeedoutPorts := TRUE;
							RETURN;
						END_IF
					END_FOR
				END_IF
				EXIT;
			END_IF
		END_FOR
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="isFeedoutSideEnabled" Id="{3e5b0684-7834-4279-a78d-91e7536d3ed5}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD isFeedoutSideEnabled : BOOL
VAR_INPUT
	eFeedoutSide : E_FeedoutSideType;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[isFeedoutSideEnabled := FALSE;
IF config_bIsConveyorTable THEN
	IF eFeedoutSide = E_FeedoutSideType.C THEN
		isFeedoutSideEnabled := NOT smC235FeedManager.di_DisableFeedoutSideC;
	ELSIF eFeedoutSide = E_FeedoutSideType.D THEN
		isFeedoutSideEnabled := NOT smC235FeedManager.di_DisableFeedoutSideD;
	END_IF
ELSE
	IF eFeedoutSide = E_FeedoutSideType.A THEN
		isFeedoutSideEnabled := NOT smC234FeedManager.di_DisableFeedoutSideA;
	ELSIF eFeedoutSide = E_FeedoutSideType.B THEN
		isFeedoutSideEnabled := NOT smC234FeedManager.di_DisableFeedoutSideB;
	ELSIF eFeedoutSide = E_FeedoutSideType.C THEN
		isFeedoutSideEnabled := NOT smC234FeedManager.di_DisableFeedoutSideC;
	ELSIF eFeedoutSide = E_FeedoutSideType.D THEN
		isFeedoutSideEnabled := NOT smC234FeedManager.di_DisableFeedoutSideD;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="isNeighborInTargetPath" Id="{551b1681-1d03-4df0-b040-00154acda5c3}">
      <Declaration><![CDATA[METHOD isNeighborInTargetPath : BOOL
VAR_INPUT
	neighborIndex : INT;
END_VAR
VAR 
	i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[isNeighborInTargetPath := FALSE;

FOR i:= 0 TO stDoorTrack.TargetPath.PathCount - 1 DO
	// do we have the neighborIndex in TargetPath?
	IF stDoorTrack.TargetPath.Path[i].TableIndex = neighborIndex THEN
		isNeighborInTargetPath := TRUE;
		RETURN;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="isTableIndexExistInCandidateRoutes" Id="{4b981153-e66a-4065-9e51-719e2c8b119c}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD isTableIndexExistInCandidateRoutes : BOOL
VAR_INPUT
	iTableIndex : INT;
END_VAR
VAR
	i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[isTableIndexExistInCandidateRoutes := FALSE;
FOR i:=0 TO stDoorTrack.CandidateRoutes.CandidateRoutesCount-1 DO
	IF stDoorTrack.CandidateRoutes.CandidateRoutes[i].TargetTableIndex = iTableIndex THEN
		isTableIndexExistInCandidateRoutes := TRUE;
		RETURN;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="minDirectionalChanges" Id="{f0a486d1-b229-4b7e-a500-6722e1ff6a71}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD minDirectionalChanges : LREAL
VAR_INPUT
	pstSearchResults : POINTER TO ST_SearchResults;
END_VAR
VAR
	i : INT;
	pstSearchResult : POINTER TO ST_SearchResult;
	minDirChanges : LREAL := MAX_LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pstSearchResults = 0 THEN
	RETURN;
END_IF

FOR i:=0 TO pstSearchResults^.SearchResultsCount - 1 DO
	pstSearchResult := ADR(pstSearchResults^.SearchResults[i]);
	IF pstSearchResult^.DirectionalChanges < minDirChanges THEN
		minDirChanges := pstSearchResult^.DirectionalChanges;
	END_IF
END_FOR

minDirectionalChanges := minDirChanges;]]></ST>
      </Implementation>
    </Method>
    <Method Name="minDoorsInPath" Id="{2350c524-4230-4787-84a0-2e49f11a184b}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD minDoorsInPath : LREAL
VAR_INPUT
	pstSearchResults : POINTER TO ST_SearchResults;
END_VAR
VAR
	i : INT;
	pstSearchResult : POINTER TO ST_SearchResult;
	minDoorIntersects : LREAL := MAX_LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pstSearchResults = 0 THEN
	RETURN;
END_IF

FOR i:=0 TO pstSearchResults^.SearchResultsCount - 1 DO
	pstSearchResult := ADR(pstSearchResults^.SearchResults[i]);
	IF pstSearchResult^.DoorsInPath < minDoorIntersects THEN
		minDoorIntersects := pstSearchResult^.DoorsInPath;
	END_IF
END_FOR

minDoorsInPath := minDoorIntersects;]]></ST>
      </Implementation>
    </Method>
    <Method Name="minNumberOfHops" Id="{186d5b37-6fed-4cd7-8288-763ea95336a5}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD minNumberOfHops : LREAL
VAR_INPUT
	pstSearchResults : POINTER TO ST_SearchResults;
END_VAR
VAR
	i : INT;
	pstSearchResult : POINTER TO ST_SearchResult;
	minHops : LREAL := MAX_LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pstSearchResults = 0 THEN
	RETURN;
END_IF

FOR i:=0 TO pstSearchResults^.SearchResultsCount - 1 DO
	pstSearchResult := ADR(pstSearchResults^.SearchResults[i]);
	IF pstSearchResult^.NumberOfHops < minHops THEN
		minHops := pstSearchResult^.NumberOfHops;
	END_IF
END_FOR

minNumberOfHops := minHops;]]></ST>
      </Implementation>
    </Method>
    <Method Name="pathHasRotateOption" Id="{b461e24f-06ee-47cf-b679-d5591d468038}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD pathHasRotateOption : BOOL
VAR_INPUT
	pstPath : POINTER TO ST_PathInfo;
END_VAR
VAR
	i : INT;
	nodeTableIndex : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[pathHasRotateOption := FALSE;
IF pstPath = 0 THEN	
	RETURN;
END_IF

FOR i:= 0 TO pstPath^.PathCount - 1 DO
	nodeTableIndex := pstPath^.Path[i].TableIndex;
	IF MAIN.mainStateMachine.asmTableManagers[nodeTableIndex].config_bCanRotate THEN
		pathHasRotateOption := TRUE;
		RETURN;
	END_IF
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="postProcess" Id="{e52be110-5b4d-47d5-9fae-195b283f292e}">
      <Declaration><![CDATA[METHOD postProcess
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.postProcess();
cmd_bAbort := FALSE;
cmd_bRotate			:= FALSE;
cmd_bSelfCenter			:= FALSE;	
cmd_bExternal		:= FALSE;	
cmd_bInternal			:= FALSE;	
cmd_bFeedinStarted	:= FALSE;
cmd_bFeedinCompleted := FALSE;
cmd_bFeedoutStarted := FALSE;
cmd_bFeedoutCompleted := FALSE;
cmd_bDoorTransferInStarted := FALSE;
cmd_bDoorTransferInCompleted := FALSE;
cmd_bDoorTransferOutCompleted := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="preProcess" Id="{1f65a54a-6f32-4b36-9e02-6acf916d497e}">
      <Declaration><![CDATA[(* this method is run before the doState is run*)
METHOD preProcess]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.preProcess();

// Jamb kickover
IF (config_pstHcTransferTableHardware <> 0) THEN
	tofJambKickOverTimer(IN:=config_bCanFeedinFromSideA AND config_pstHcTransferTableHardware^.di_JambKickoverEye, PT:=T#2.0S);
	config_pstHcTransferTableHardware^.do_jambKickover := tofJambKickOverTimer.Q AND (NOT config_pstHcTransferTableHardware^.di_JambKickoverEye);
END_IF

// persist configs to disk
rtrigPersistentDataChanged(CLK:=
	config_bManualControlEnabled <> cmd_bManualControlEnabled);
IF rtrigPersistentDataChanged.Q THEN
	config_bManualControlEnabled := cmd_bManualControlEnabled;
END_IF
bExternal := anyChildExternal();
status_bBusy := anyChildBusy() OR smDoorDasher.status_bBusy;
status_bMoving := psmHcFeedMotor^.status_bMoving;
bReadyToRotate := 
	NOT (smC234FeedManager.smRotateManager.psmDoorLiftCyl^.status_bFloating OR smC234FeedManager.smRotateManager.psmRotateCyl^.status_bFloating) AND
	(smC234FeedManager.smSelfCenterManager.psmSelfCenterCyl^.status_bRetracted OR NOT config_bCanSelfCenter);
bOkToSelfCenter := smC234FeedManager.smRotateManager.bDoorLiftCylRetracted OR NOT config_bCanRotate;

bHasDoor := bDoorInMachine;
ftrigHasDoor(CLK:=bHasDoor);

rtrigAutofeedOn(CLK:=cmd_bAutoFeedOn);
IF rtrigAutofeedOn.Q THEN
	autofeedOn();
END_IF

// Eye blowoff
IF (config_pstHcTransferTableHardware <> 0) THEN
	IF rtrigAutofeedOn.Q OR ftrigHasDoor.Q THEN
		config_pstHcTransferTableHardware^.do_eyeBlowoff := TRUE;
	END_IF
	tonEyeBlowoffTimer(IN:=config_pstHcTransferTableHardware^.do_eyeBlowoff, PT:=T#1S);
	IF tonEyeBlowoffTimer.Q THEN
		config_pstHcTransferTableHardware^.do_eyeBlowoff := FALSE;
	END_IF
END_IF

ftrigAnyChildNotAutofeedOn(CLK:=allChildrenAutoFeedOn());
IF ftrigAnyChildNotAutofeedOn.Q THEN
	cmd_bAutoFeedOn := FALSE;
END_IF

ftrigAutofeedOn(CLK:=cmd_bAutoFeedOn);
IF ftrigAutofeedOn.Q THEN
	autofeedOff();
END_IF


rtrigExternal(CLK:=cmd_bExternal);
IF rtrigExternal.Q THEN
	setExternal();
END_IF

rtrigExternal(CLK:=cmd_bInternal);
IF rtrigExternal.Q THEN
	setInternal();
END_IF

rtrigTableIndexNotExistInDoorTrackTargetPath(CLK:= 
	bHasDoor AND 
	stDoorTrack.Target <> -1 AND 
	stDoorTrack.TargetPath.PathCount > 0 AND 
	NOT existTableIndexInDoorTrackTargetPath());

rtrigRequestNewRoute(CLK:=cmd_bRequestNewRoute);

// cmd_bIncomingDoorHandValid := di_IncomingDoorLH XOR di_IncomingDoorRH
cmd_bIncomingDoorHandValid := cmd_eIncomingDoorHand <> E_DOORHAND.DOORHAND_NO_HAND;

// Monitor cmd_bIncomingDoorHandValid on falling edge. The feeding machine (ie, 994-X) clears LH/RH inputs on completion of its feed-out seq. 
ftrigIncomingDoorHandValid(CLK:=cmd_bIncomingDoorHandValid);

// Monitor on rising edge. The feeding machine (ie, 994-X) sets LH/RH inputs at start of its feed-out seq. 
rtrigIncomingDoorHandChanged(CLK:=cmd_bIncomingDoorHandValid AND cmd_eIncomingDoorHandLast <> cmd_eIncomingDoorHand);

cmd_eIncomingDoorHandLast := cmd_eIncomingDoorHand;

bSelectedDestinationIndexChanged := cmd_iSelectedDestinationIndexLast <> cmd_iSelectedDestinationIndex;
cmd_iSelectedDestinationIndexLast := cmd_iSelectedDestinationIndex;


bAutoDataReadyConfigChanged := bAutoDataReadyConfigLast <> config_bAutoDataReady;
bAutoDataReadyConfigLast := config_bAutoDataReady;

rtrigAutoDataReadyChanged(clk:=bAutoDataReadyConfigChanged);

IF bSelectedDestinationIndexChanged OR bAutoDataReadyConfigChanged THEN
	setDoorDataReadyLatch(FALSE);
END_IF

tofSelectedDestinationIndexChangedTimer(IN := bSelectedDestinationIndexChanged, PT := T#100MS);

// Detect falling edge of the input signal
ftrigSelectedDestinationIndexChanged(CLK := tofSelectedDestinationIndexChangedTimer.Q);

IF ftrigSelectedDestinationIndexChanged.Q THEN	
	bAnySourceDestinationIndexFeedoutPortEnabled := anySourceDestinationIndexFeedoutPortEnabled(UINT_TO_INT(cmd_iSelectedDestinationIndex));
	cmd_bRetry := config_bAutoDataReady AND bWaitingForClearRoute AND NOT bHasDoor AND bAnySourceDestinationIndexFeedoutPortEnabled;
	IF NOT bAnySourceDestinationIndexFeedoutPortEnabled THEN
		logger.fbFString(sFormat := 'Table [%s]: No feed-out ports found for the selected destination index [%d].', 
			arg1 := F_STRINGEx(MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[config_iTableArrayIndex].Name), 
			arg2 := F_UINT(cmd_iSelectedDestinationIndex));	
		logger(sMessage := logger.fbFString.sOut, ePriority := LOGPRIORITY_ALERT);
	END_IF
END_IF

IF config_bAutoDataReady THEN
	// When table is configured as an input and 'hungry-mode' with destination index 0 mapped to 2 or more feed-out ports,
	// and config_bAutoDataReady is True, the physical Destination Index switch and Door Ready button are not used, cmd_bDoorDataReady is not used and always False.
	
	IF ftrigIncomingDoorHandValid.Q THEN
		setDoorDataReadyLatch(FALSE);
	ELSIF rtrigIncomingDoorHandChanged.Q OR 
		ftrigSelectedDestinationIndexChanged.Q OR
		rtrigAutoDataReadyChanged.Q THEN
		bAnySourceDestinationIndexFeedoutPortEnabled := anySourceDestinationIndexFeedoutPortEnabled(UINT_TO_INT(cmd_iSelectedDestinationIndex));
		IF cmd_bIncomingDoorHandValid AND bAnySourceDestinationIndexFeedoutPortEnabled THEN
			cmd_iSelectedDestinationIndexLatched	:= cmd_iSelectedDestinationIndex;
			cmd_eIncomingDoorHandLatched			:= cmd_eIncomingDoorHand;
			cmd_sJobNameLatched						:= cmd_sJobName;
			
			// Set cmd_bDoorDataReadyLatched = True. 
			// The feeding machine (ie 994-X) automatically clears LH and RH inputs when its feed-out seq completes.
			setDoorDataReadyLatch(TRUE); 
		ELSE
			setDoorDataReadyLatch(FALSE); 
		END_IF
		
	END_IF
ELSE
	// manual simple-rounting mode. 
	rtrigDoorDataReady(CLK:=cmd_bDoorDataReady);
	IF rtrigDoorDataReady.Q THEN
		IF NOT cmd_bDoorDataReadyLatched THEN
			cmd_iSelectedDestinationIndexLatched	:= cmd_iSelectedDestinationIndex;
			cmd_sJobNameLatched						:= cmd_sJobName;
			setDoorDataReadyLatch(TRUE);
		ELSE
			setDoorDataReadyLatch(FALSE);	
		END_IF
	END_IF
	
	IF ftrigIncomingDoorHandValid.Q THEN
		setDoorDataReadyLatch(FALSE);
	ELSIF rtrigIncomingDoorHandChanged.Q THEN
		cmd_eIncomingDoorHandLatched			:= cmd_eIncomingDoorHand;
	END_IF
END_IF

IF 	rtrigRequestNewRoute.Q OR 
	rtrigTableIndexNotExistInDoorTrackTargetPath.Q 
	THEN
	// this will filter out stDoorTrack.Target in the DestinationIndex Feedout-port popup
	cmd_bNewRouteRequested := bHasDoor;  
END_IF

bCurrentTargetFeedoutPortEnabled := currentTargetFeedoutPortEnabled();
rtrigTargetFeedoutPortsDisabled(CLK:=NOT bCurrentTargetFeedoutPortEnabled);
ftrigTargetFeedoutPortsDisabled(CLK:=NOT bCurrentTargetFeedoutPortEnabled);

bAnyCurrentTargetFeedoutPortEnabled := anyCurrentTargetFeedoutPortEnabled();
bAllCurrentTargetFeedoutPortsEnabled := allCurrentTargetFeedoutPortsEnabled();
rtrigAllCurrentTargetFeedoutPortsEnabled(CLK:=bAllCurrentTargetFeedoutPortsEnabled);
ftrigAllCurrentTargetFeedoutPortsEnabled(CLK:=bAllCurrentTargetFeedoutPortsEnabled);

bAnyDestinationIndexFeedoutPortEnabled := anyDestinationIndexFeedoutPortEnabled();
_bAllTargetFeedoutPortsDisabled := 
	bHasDoor AND 
	NOT (cmd_bNewRouteRequestedFromDoorHasNoTarget OR bAnyDestinationIndexFeedoutPortEnabled OR bAnyCurrentTargetFeedoutPortEnabled) 
	;  
rtrigAllTargetFeedoutPortsDisabled(CLK:=_bAllTargetFeedoutPortsDisabled);
ftrigAllTargetFeedoutPortsDisabled(CLK:=_bAllTargetFeedoutPortsDisabled);

_bDoorHasNoTarget := cmd_bInitialized AND bHasDoor AND (stDoorTrack.Target = -1);
rtrigDoorHasNoTarget(CLK:=_bDoorHasNoTarget);
ftrigDoorHasNoTarget(CLK:=_bDoorHasNoTarget);

IF rtrigDoorHasNoTarget.Q THEN
	cmd_bDoorHasNoTarget := TRUE;
END_IF

bRequestNewRouteComplete := machineState = TABLEMANAGER_DOOR_TRACKER_FINDPATH_REQUEST_NEW_ROUTE_COMPLETE;
bWaitingForClearRoute := machineState = TABLEMANAGER_DOOR_TRACKER_FINDPATH_WAITING_FOR_CLEAR_ROUTE;
bWaitForDataReadyOrTransferredIn := machineState = TABLEMANAGER_DOOR_TRACKER_WAIT_FOR_DATA_READY_OR_TRANSFERRED_IN;
bDoorTransferringIn := machineState = TABLEMANAGER_DOOR_TRACKER_TRANSFERRING_IN;
bRouteReadyWaitForFeedIn := machineState = TABLEMANAGER_DOOR_TRACKER_ROUTE_READY_WAIT_FOR_FEED_IN;
bDoorFeedingIn := machineState = TABLEMANAGER_DOOR_TRACKER_DOOR_FEEDING_IN;
bDoorFeedingOut  := machineState = TABLEMANAGER_DOOR_TRACKER_DOOR_FEEDING_OUT;				
bDoorInMachineIdle := machineState = TABLEMANAGER_DOOR_TRACKER_DOOR_IN_MACHINE_IDLE;
bDoorWaitingForFeedOut := machineState = TABLEMANAGER_DOOR_TRACKER_WAIT_FOR_FEED_OUT;
bWaitAllTablesReady := machineState = TABLEMANAGER_DOOR_TRACKER_WAIT_ALL_TABLES_READY;
bAllTargetFeedoutPortsDisabled  := machineState = TABLEMANAGER_DOOR_TRACKER_ALL_TARGET_FEEDOUT_PORTS_DISABLED;	
bDoorHasNoTarget := machineState = TABLEMANAGER_DOOR_TRACKER_DOOR_HAS_NO_TARGET;

rtrigDoorDataReadyLatched(CLK:=cmd_bDoorDataReadyLatched);
ftrigDoorDataReadyLatched(CLK:=cmd_bDoorDataReadyLatched);
IF rtrigDoorDataReadyLatched.Q THEN
	cmd_bReroutePending := FALSE;
END_IF
IF ftrigDoorDataReadyLatched.Q THEN
	cmd_bReroutePending := TRUE;
END_IF

bAnyTableBusy := anyTableBusy();
rtrigRerouteAllTablesWaitingTransferredOut(CLK:=cmd_bReroutePending AND NOT bAnyTableBusy);
 
IF rtrigRerouteAllTablesWaitingTransferredOut.Q THEN
	cmd_bReroutePending := FALSE;
	bAnyFeedoutTableEmptyAndReady := anyFeedoutTableEmptyAndReady();
	IF bAnyFeedoutTableEmptyAndReady THEN
		// send reroute request to all tables who were blocked by the Data Ready Latch.
		// For example, SN6 layout has 5 tables and 2 columns. 
		// T1 has Data Ready Latch active, doors on T2 or T3 cannot go to T5 when T5 became empty, then Data Ready latch is turned off.
		rerouteAllTablesWaitingTransferredOut();
	END_IF	
END_IF

bReadyToFeedout := 
	bHasDoor AND 
	stDoorTrack.Target = config_iTableArrayIndex AND 
	bAnyCurrentTargetFeedoutPortEnabled AND
	NOT (stDoorTrack.DoorRotateRequired XOR stDoorTrack.DoorWasRotated);
			
rtrigReadyToFeedout(CLK:=bReadyToFeedout);
ftrigReadyToFeedout(CLK:=bReadyToFeedout);



rtrigAnyCurrentTargetFeedoutPortEnabled(CLK:=
	bAnyCurrentTargetFeedoutPortEnabled);
ftrigAnyCurrentTargetFeedoutPortEnabled(CLK:= 	 
	bAnyCurrentTargetFeedoutPortEnabled);

rtrigAnyDestinationIndexFeedoutPortEnabled(CLK:=
 	bAnyDestinationIndexFeedoutPortEnabled);

ftrigAnyDestinationIndexFeedoutPortEnabled(CLK:=
 	bAnyDestinationIndexFeedoutPortEnabled);		
	
rtrigAnyTableDoorTrackTargetChanged(CLK:=
	pStatus_bAnyTableDoorTrackTargetChanged^
	);
IF rtrigAnyTableDoorTrackTargetChanged.Q OR 
	//rtrigAnyCurrentTargetFeedoutPortEnabled.Q OR
	//rtrigAnyDestinationIndexFeedoutPortEnabled.Q OR 
	ftrigTargetFeedoutPortsDisabled.Q OR
	rtrigDoorDataReady.Q 
	THEN
	cmd_bRetry := TRUE;
END_IF

ftrigNewRouteRequestedFromAllTargetFeedoutPortsDisabled(CLK:=cmd_bNewRouteRequestedFromAllTargetFeedoutPortsDisabled);
ftrigNewRouteRequestedFromDoorHasNoTarget(CLK:=cmd_bNewRouteRequestedFromDoorHasNoTarget);

IF downstream.status_bDownstreamError THEN
	iErrorId := TABLEMANAGER_DOWNSTREAM_ERROR;
END_IF

IF iErrorId <> 0 THEN
	raiseError(FALSE);
END_IF

IF NOT cmd_bEnable THEN
	IF machineState > TABLEMANAGER_ENABLING AND
		machineState <= TABLEMANAGER_ERROR THEN
		machineState := TABLEMANAGER_DISABLED;
	END_IF	
ELSIF bError THEN
	IF machineState > TABLEMANAGER_ENABLING AND
		machineState < TABLEMANAGER_ERROR THEN
		machineState := TABLEMANAGER_ERROR;
	END_IF	
ELSIF ftrigNewRouteRequestedFromDoorHasNoTarget.Q OR 
	cmd_bDoorHasNoTarget THEN
	IF machineState >= TABLEMANAGER_DOOR_TRACKER_START AND
		machineState < TABLEMANAGER_DOOR_TRACKER_DOOR_HAS_NO_TARGET THEN
		machineState := TABLEMANAGER_DOOR_TRACKER_DOOR_HAS_NO_TARGET;
	END_IF
ELSIF ftrigNewRouteRequestedFromAllTargetFeedoutPortsDisabled.Q OR
	rtrigAllTargetFeedoutPortsDisabled.Q THEN
	IF machineState >= TABLEMANAGER_DOOR_TRACKER_START AND
		machineState < TABLEMANAGER_DOOR_TRACKER_ALL_TARGET_FEEDOUT_PORTS_DISABLED THEN
		machineState := TABLEMANAGER_DOOR_TRACKER_ALL_TARGET_FEEDOUT_PORTS_DISABLED;
	END_IF
ELSIF NOT cmd_bAutoFeedOn THEN
	IF machineState > TABLEMANAGER_AUTOFEED_OFF AND
		machineState < TABLEMANAGER_ERROR THEN
		machineState := TABLEMANAGER_AUTOFEED_OFF;
	END_IF
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="raiseError" Id="{f5d9d67f-ab61-44a6-9451-bbf2e0261b43}">
      <Declaration><![CDATA[METHOD raiseError
VAR_INPUT
	bSetError : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE iErrorId OF
	TABLEMANAGER_DOWNSTREAM_ERROR: 
		formatError('Downstream error', 'Reset machine');
END_CASE
SUPER^.raiseError(bSetError);]]></ST>
      </Implementation>
    </Method>
    <Method Name="readInputs" Id="{92f8e551-5cc4-4394-850e-c9bc17fa3ca5}">
      <Declaration><![CDATA[METHOD readInputs
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//smC234FeedManager
IF (config_pstHcTransferTableHardware <> 0) THEN
	// 00 - 07
	smC234FeedManager.di_DoorDataReady 			:= config_pstHcTransferTableHardware^.di_DoorDataReady 		;
	smC234FeedManager.di_IncomingDoorLH			:= config_pstHcTransferTableHardware^.di_IncomingDoorLH		;
	smC234FeedManager.di_IncomingDoorRH			:= config_pstHcTransferTableHardware^.di_IncomingDoorRH		;
	smC234FeedManager.di_DestinationBit0		:= config_pstHcTransferTableHardware^.di_DestinationBit0	;
	smC234FeedManager.di_DestinationBit1		:= config_pstHcTransferTableHardware^.di_DestinationBit1	;
	smC234FeedManager.di_DestinationBit2		:= config_pstHcTransferTableHardware^.di_DestinationBit2	;
	smC234FeedManager.di_InMachineEye			:= config_pstHcTransferTableHardware^.di_InMachineEye		;
	smC234FeedManager.di_DoorStop1Eye			:= config_pstHcTransferTableHardware^.di_DoorStop1Eye		;

	// 10 - 17           
	smC234FeedManager.di_DoorStop3Eye			:= config_pstHcTransferTableHardware^.di_DoorStop3Eye		;
	//di_JambKickoverEye - in SM_TableManager
	smC234FeedManager.di_ASideDoorSenseEye		:= config_pstHcTransferTableHardware^.di_DoorSenseEyeSideA	;
	smC234FeedManager.di_OkToFeedOutSideA		:= config_pstHcTransferTableHardware^.di_OkToFeedOutSideA	;
	smC234FeedManager.di_DisableFeedoutSideA	:= config_pstHcTransferTableHardware^.di_DisableFeedoutSideA;
	smC234FeedManager.di_BSideDoorSenseEye		:= config_pstHcTransferTableHardware^.di_DoorSenseEyeSideB	;
	smC234FeedManager.di_OkToFeedOutSideB		:= config_pstHcTransferTableHardware^.di_OkToFeedOutSideB	;
	smC234FeedManager.di_DisableFeedoutSideB	:= config_pstHcTransferTableHardware^.di_DisableFeedoutSideB;

	// 20 - 27           
	smC234FeedManager.di_CSideDoorFeedEye		:= config_pstHcTransferTableHardware^.di_DoorSenseEyeSideC	;
	smC234FeedManager.di_OkToFeedOutSideC		:= config_pstHcTransferTableHardware^.di_OkToFeedOutSideC	;
	smC234FeedManager.di_DisableFeedoutSideC	:= config_pstHcTransferTableHardware^.di_DisableFeedoutSideC;
	smC234FeedManager.di_DSideDoorFeedEye		:= config_pstHcTransferTableHardware^.di_DoorSenseEyeSideD	;
	smC234FeedManager.di_OkToFeedOutSideD		:= config_pstHcTransferTableHardware^.di_OkToFeedOutSideD	;
	smC234FeedManager.di_DisableFeedoutSideD	:= config_pstHcTransferTableHardware^.di_DisableFeedoutSideD;
	smC234FeedManager.di_AtFarFenceEye			:= config_pstHcTransferTableHardware^.di_AtFenceEyeSideC	; // "far" side
	smC234FeedManager.di_AtNearFenceEye			:= config_pstHcTransferTableHardware^.di_AtFenceEyeSideD	; // "near" side

// smC235FeedManager
ELSIF (config_pstHcConveyorHardware <> 0) THEN
	smC235FeedManager.di_CSideDoorFeedEye := config_pstHcConveyorHardware^.di_DoorSenseEyeSideC;
	smC235FeedManager.di_DSideDoorFeedEye := config_pstHcConveyorHardware^.di_DoorSenseEyeSideD;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="recordStateCallHistory" Id="{1a6710e9-87c6-4b9f-92fa-ab90bada326b}" FolderPath="uml\">
      <Declaration><![CDATA[(* base implementation to record state calling history. 
 	Derrived FB's should override this method to replace the machine' specific type of eState *)
	
METHOD recordStateCallHistory
VAR_INPUT
	iState				: INT;
	iSubState			: INT;
END_VAR
VAR
	sCurTaskCycle 		: STRING;
    eState       		: E_TableManager_States; // todo: replace with the derrived STRUCT type (ie, E_HeadManager_States)
    eSubState			: E_SubState;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// DO NOT CHANGE BELOW!!!
// This was auto-generated by a Kval's UML tool.

sCurTaskCycle := TO_STRING(mainStateCallingData[iState, iSubState].nCycleIdFirstCall);
eState := iState;
eSubState := iSubState;

// Enter the state name into array
mainStateCallHistory[iStateCallHistoryIndex].sTaskCycle := sCurTaskCycle;
mainStateCallHistory[iStateCallHistoryIndex].sStateId := TO_STRING(iState);
mainStateCallHistory[iStateCallHistoryIndex].sStateDesc := TO_STRING(eState);
mainStateCallHistory[iStateCallHistoryIndex].sSubStateId := TO_STRING(iSubState);
mainStateCallHistory[iStateCallHistoryIndex].sSubStateDesc := TO_STRING(eSubState);

iStateCallHistoryIndex := iStateCallHistoryIndex + 1;
IF iStateCallHistoryIndex = MAX_STATE_CALL_HISTORY THEN
	iStateCallHistoryIndex := 0;
END_IF

// mark next index to record state call history
mainStateCallHistory[iStateCallHistoryIndex].sTaskCycle := '--';
mainStateCallHistory[iStateCallHistoryIndex].sStateId := '--';
mainStateCallHistory[iStateCallHistoryIndex].sStateDesc := '--';
mainStateCallHistory[iStateCallHistoryIndex].sSubStateId := '--';
mainStateCallHistory[iStateCallHistoryIndex].sSubStateDesc := '--';]]></ST>
      </Implementation>
    </Method>
    <Method Name="rerouteAllTablesWaitingTransferredOut" Id="{4b35eabe-6151-4122-80f5-943515c0eb02}">
      <Declaration><![CDATA[METHOD rerouteAllTablesWaitingTransferredOut
VAR 
	i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i:=0 TO MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.TablesCount-1 DO
	IF NOT MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].IsFunctionalTable THEN
		CONTINUE;
	END_IF
	IF (//MAIN.mainStateMachine.asmTableManagers[i].bDoorTransferringIn OR 
		MAIN.mainStateMachine.asmTableManagers[i].bDoorInMachineIdle) AND 
		
		// any of these is true, skip sending reroute.		
		NOT (//MAIN.mainStateMachine.asmTableManagers[i].status_bBusy OR
			MAIN.mainStateMachine.asmTableManagers[i].stDoorTrack.Target = i)

		THEN
		MAIN.mainStateMachine.asmTableManagers[i].cmd_bReroute := TRUE;
	END_IF
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="resetDoorTrack" Id="{172a9df1-dab2-4e9c-9477-cb7888ba8ea9}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD resetDoorTrack
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stDoorTrack.Source := config_iTableArrayIndex;
stDoorTrack.DestinationIndex := UINT_TO_INT(cmd_iSelectedDestinationIndexLatched);
stDoorTrack.DoorHand := cmd_eIncomingDoorHandLatched;
stDoorTrack.Name := cmd_sJobNameLatched;


]]></ST>
      </Implementation>
    </Method>
    <Method Name="resetTriggers" Id="{2057ce01-c973-4eda-a7a3-55f5fbd5ddd3}" FolderPath="uml\">
      <Declaration><![CDATA[(* Any trigger that caused state transition (ie, cmd_bHome, cmd_bStartSequence, etc..) that
 	needs to be reset should go in here.
	 
	NOTE: The derived function block of KvalStateMachineBase_UmlSC should override/extend this method. *)
METHOD resetTriggers

]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER ^.resetTriggers();
//TODO: reset all triggers (ie, cmd_bHome, cmd_bPark, etc...) here...
]]></ST>
      </Implementation>
    </Method>
    <Method Name="setDestinationIndex" Id="{1213f6b9-4eea-436f-806f-174981d9f48d}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD setDestinationIndex
VAR_INPUT
	iDestinationIndex : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[cmd_iSelectedDestinationIndex := iDestinationIndex;]]></ST>
      </Implementation>
    </Method>
    <Method Name="setDoorDataReady" Id="{bfcad898-487a-4556-af42-a3716dcf441d}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD setDoorDataReady
VAR_INPUT
	bDoorDataReady : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[cmd_bDoorDataReady := bDoorDataReady;]]></ST>
      </Implementation>
    </Method>
    <Method Name="setDoorDataReadyLatch" Id="{eae2fcb4-a4c0-4f64-b7cc-987f86c7d37f}">
      <Declaration><![CDATA[METHOD setDoorDataReadyLatch
VAR_INPUT
	bLatched : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[cmd_bDoorDataReadyLatched := bLatched;
smC234FeedManager.setDoorDataAck(bLatched);	]]></ST>
      </Implementation>
    </Method>
    <Method Name="setDoorTrack" Id="{dc11f6be-65db-4a9c-b496-5effd4aafce7}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD setDoorTrack
VAR_INPUT
	stDoorTrackOther : ST_DoorTrack;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// is the target's door-dasher busy?
IF smDoorDasher.bTransferring THEN
	stDoorTrackLast := stDoorTrackOther;
	bDoorTrackDirty := TRUE;
ELSE
	stDoorTrack := stDoorTrackOther;
	setTableEmptyStatus(FALSE);
END_IF

]]></ST>
      </Implementation>
    </Method>
