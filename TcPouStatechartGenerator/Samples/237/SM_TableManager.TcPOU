westNeighborIndex := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[config_iTableArrayIndex].NeighborWestIndex;

IF northNeighborIndex <> -1 THEN
	IF (MAIN.mainStateMachine.asmTableManagers[northNeighborIndex].bHasDoor AND
		MAIN.mainStateMachine.asmTableManagers[northNeighborIndex].cmd_bDoorDataReadyLatched
			) THEN
		anyNeighboringTableHasDoorAndDataReadyActive := TRUE;
		RETURN;
	END_IF
END_IF
IF southNeighborIndex <> -1 THEN
	IF (MAIN.mainStateMachine.asmTableManagers[southNeighborIndex].bHasDoor AND
		MAIN.mainStateMachine.asmTableManagers[southNeighborIndex].cmd_bDoorDataReadyLatched
			) THEN
		anyNeighboringTableHasDoorAndDataReadyActive := TRUE;
		RETURN;
	END_IF
END_IF
IF eastNeighborIndex <> -1 THEN
