(ID := 25, Name := 'TABLEMANAGER_DOOR_TRACKER_FINDPATH_RESET', StateType := _UML_SC_StateTypes.SlowState, StartOfTransitionIndex := 134, OutGoingTransitionsCount := 8, RegionCount := 0, RegionStartIndex := 0, RegionEndIndex := 0, CompletionTransitionID := 0, MaxDoCycles := 32766, HasEntryAction := True, HasDoAction := True, HasExitAction := True) , 
