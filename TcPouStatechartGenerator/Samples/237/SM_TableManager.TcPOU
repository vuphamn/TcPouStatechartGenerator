    <Method Name="anyFeedoutTableEmptyAndReady" Id="{ee556320-a2ce-4102-9eb3-715bd6daaac6}">
      <Declaration><![CDATA[METHOD anyFeedoutTableEmptyAndReady : bool
VAR 
	i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[anyFeedoutTableEmptyAndReady := FALSE;	
FOR i:=0 TO MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.TablesCount-1 DO
	IF NOT (MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].IsFunctionalTable AND
		MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].IsOutputPort AND 
		MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].OutputPortEnabled) THEN
		CONTINUE;
	END_IF
	IF  //MAIN.mainStateMachine.asmTableManagers[i].bWaitForDataReadyOrTransferredIn AND
		NOT (MAIN.mainStateMachine.asmTableManagers[i].bHasDoor OR 
			MAIN.mainStateMachine.asmTableManagers[i].status_bBusy OR
			MAIN.mainStateMachine.asmTableManagers[i].cmd_bDoorDataReadyLatched) THEN
		anyFeedoutTableEmptyAndReady := TRUE;
		RETURN;		
	END_IF
END_FOR	]]></ST>
      </Implementation>
    </Method>
    <Method Name="anyNeighboringTableBusy" Id="{7bb14e94-bfdb-45d0-a989-283d70e92cf8}">
      <Declaration><![CDATA[METHOD anyNeighboringTableBusy : bool
VAR 
	northNeighborIndex : INT;
	southNeighborIndex : INT;
	eastNeighborIndex : INT;
	westNeighborIndex : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[anyNeighboringTableBusy := FALSE;
northNeighborIndex := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[config_iTableArrayIndex].NeighborNorthIndex;
southNeighborIndex := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[config_iTableArrayIndex].NeighborSouthIndex;
eastNeighborIndex := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[config_iTableArrayIndex].NeighborEastIndex;
westNeighborIndex := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[config_iTableArrayIndex].NeighborWestIndex;

IF northNeighborIndex <> -1 THEN
	IF MAIN.mainStateMachine.asmTableManagers[northNeighborIndex].status_bBusy THEN
		anyNeighboringTableBusy := TRUE;
		RETURN;
	END_IF
END_IF
IF southNeighborIndex <> -1 THEN
	IF MAIN.mainStateMachine.asmTableManagers[southNeighborIndex].status_bBusy THEN
		anyNeighboringTableBusy := TRUE;
		RETURN;
	END_IF
END_IF
IF eastNeighborIndex <> -1 THEN
	IF MAIN.mainStateMachine.asmTableManagers[eastNeighborIndex].status_bBusy THEN
		anyNeighboringTableBusy := TRUE;
		RETURN;
	END_IF
END_IF
IF westNeighborIndex <> -1 THEN
	IF MAIN.mainStateMachine.asmTableManagers[westNeighborIndex].status_bBusy THEN
		anyNeighboringTableBusy := TRUE;
		RETURN;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
