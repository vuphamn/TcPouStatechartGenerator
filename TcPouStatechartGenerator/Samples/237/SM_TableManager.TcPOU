    <Method Name="blinkReadyToFeedoutSides" Id="{41d4f0b5-5c58-4523-9be3-4127591d0332}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD blinkReadyToFeedoutSides
VAR_INPUT	
END_VAR
VAR 
	i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i:=0 TO stDoorTrack.TargetFeedoutPorts.FeedoutPortsCount -1 DO
	IF stDoorTrack.TargetFeedoutPorts.FeedoutPorts[i].Side = E_FeedoutSideType.A THEN
		blinkReadyToFeedoutSideA();
	ELSIF stDoorTrack.TargetFeedoutPorts.FeedoutPorts[i].Side = E_FeedoutSideType.B THEN
		blinkReadyToFeedoutSideB();
	ELSIF stDoorTrack.TargetFeedoutPorts.FeedoutPorts[i].Side = E_FeedoutSideType.C THEN
		blinkReadyToFeedoutSideC();
	ELSIF stDoorTrack.TargetFeedoutPorts.FeedoutPorts[i].Side = E_FeedoutSideType.D THEN
		blinkReadyToFeedoutSideD();
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
