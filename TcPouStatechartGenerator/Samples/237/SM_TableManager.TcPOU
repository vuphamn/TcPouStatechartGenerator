    <Method Name="computeDirectionalChanges" Id="{7a81d0e5-e764-4e97-8ad2-e86baa26fc5e}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD computeDirectionalChanges : INT
VAR_INPUT
	pstPath : POINTER TO ST_PathInfo;
END_VAR
VAR
	i : INT;
	directionalChanges : INT;
	curDirection : E_Direction;
	tempDirection : E_Direction;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pstPath = 0 THEN
	computeDirectionalChanges := MAX_INT;
	RETURN;
END_IF

IF pstPath^.PathCount <= 1 THEN
	computeDirectionalChanges := 0;
	RETURN;
END_IF

curDirection := pstPath^.Path[0].Direction;

FOR i:=1 TO pstPath^.PathCount - 1 DO
	tempDirection := pstPath^.Path[i].Direction;
	IF tempDirection <> E_Direction.None AND curDirection <> tempDirection THEN
		curDirection := tempDirection;
		directionalChanges := directionalChanges + 1;
	END_IF
	
END_FOR

computeDirectionalChanges := directionalChanges;]]></ST>
      </Implementation>
    </Method>
    <Method Name="computeDoorsInPath" Id="{ad297419-b722-47ac-9a42-76e356776bf5}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD computeDoorsInPath : INT
VAR_INPUT
	pstPath : POINTER TO ST_PathInfo;
END_VAR
VAR
	i : INT;
	doorsInPath : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pstPath = 0 THEN
	computeDoorsInPath := MAX_INT;
	RETURN;
END_IF

FOR i:= 0 TO pstPath^.PathCount - 1 DO
	IF MAIN.mainStateMachine.asmTableManagers[pstPath^.Path[i].TableIndex].bHasDoor THEN
		doorsInPath := doorsInPath + 1;
	END_IF
END_FOR

computeDoorsInPath := doorsInPath;]]></ST>
      </Implementation>
    </Method>
    <Method Name="computeFinalScore" Id="{75c159b4-96a0-4001-b0b0-9e9b3f8a8942}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[// compute the score for each of the search result. The result with highest final score is selected and its target is saved in DoorTrack.Target.
METHOD computeFinalScore
VAR
	numberOfHopsWeight : LREAL;
	directionChangesWeight : LREAL;
	doorsInPathWeight : LREAL;
	numberOfHopsMin : LREAL;
	directionChangesMin : LREAL;
	doorsInPathMin : LREAL;
	hasEmptyTableInPathWeight : LREAL;
	hasIncomingDoorInPathWeight : LREAL;
	pstSearchResults : POINTER TO ST_SearchResults;
	pstSearchResult : POINTER TO ST_SearchResult;
	pstPathInfo : pointer to ST_PathInfo;
	pstSearchResultWithMaxFinalScore : POINTER TO ST_SearchResult;
	i : INT;
	target : INT;
	stRejectedFeedoutPort : ST_FeedoutPort;
	stReroutableFeedoutPort : ST_FeedoutPort;
	stTargetFeedoutPorts : ST_FeedoutPortsConfig;
	stAllEnabledFeedoutPorts : ST_FeedoutPortsConfig;
	stRejectedFeedoutPorts : ST_FeedoutPortsConfig;
	stReroutableFeedoutPorts : ST_ReroutableFeedoutPortsConfig;
	stCandidateRoutes : ST_CandidateRoutes;
	stSearchResults : ST_SearchResults;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pstSearchResults := ADR(stDoorTrack.SearchResults);
numberOfHopsWeight := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.PathFindingConfig.NumberHopsWeight;
directionChangesWeight := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.PathFindingConfig.DirectionalChangesWeight;
doorsInPathWeight := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.PathFindingConfig.DoorsInPathWeight;
hasEmptyTableInPathWeight := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.PathFindingConfig.HasEmptyTableInPathWeight;
hasIncomingDoorInPathWeight := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.PathFindingConfig.HasIncomingDoorInPathWeight;
stDoorTrack.RejectedFeedoutPorts.FeedoutPortsCount := 0; // Reset to 0 for counting the rejected feed-out ports for re-routing.
stDoorTrack.ReroutableFeedoutPorts.FeedoutPortsCount := 0; // Reset to 0 for counting the reroutable feed-out ports for re-routing.
bFoundValidRoute := FALSE;

FOR i := 0 TO pstSearchResults^.SearchResultsCount -1 DO
	pstSearchResult := ADR(pstSearchResults^.SearchResults[i]);
	pstPathInfo := ADR(pstSearchResult^.PathIno);
	pstSearchResult^.NumberOfHops := pstSearchResult^.PathIno.PathCount;
	pstSearchResult^.DirectionalChanges := computeDirectionalChanges(pstPathInfo);
	pstSearchResult^.DoorsInPath := computeDoorsInPath(pstPathInfo);
	pstSearchResult^.HasEmptyTableInPath := hasEmptyTableInPath(pstPathInfo);
	pstSearchResult^.HasDoorGoingOppositeDirection := hasDoorGoingOppositeDirection(pstPathInfo);
	pstSearchResult^.HasIncomingDoorInPath := hasIncomingDoorInPath(pstPathInfo);
	pstSearchResult^.HasDeadlockedDoorInPath := hasDeadlockedDoorInPath(pstPathInfo);
	pstSearchResult^.RotationRequired := doesPathRequireRotation(pstPathInfo, stDoorTrack.Source, stDoorTrack.DoorHand, pstSearchResult^.TargetFeedoutSide);
	pstSearchResult^.PathHasRotateOption := pathHasRotateOption(pstPathInfo);
END_FOR

numberOfHopsMin := minNumberOfHops(pstSearchResults);
directionChangesMin := minDirectionalChanges(pstSearchResults);
doorsInPathMin := minDoorsInPath(pstSearchResults);

FOR i := 0 TO pstSearchResults^.SearchResultsCount -1 DO
	pstSearchResult := ADR(pstSearchResults^.SearchResults[i]);
	
	pstSearchResult^.NumberOfHopsSubScore := numberOfHopsMin / pstSearchResult^.NumberOfHops * numberOfHopsWeight;
	
	IF pstSearchResult^.DirectionalChanges = 0 THEN
		pstSearchResult^.DirectionChangesSubScore := directionChangesWeight;
	ELSE
		pstSearchResult^.DirectionChangesSubScore := directionChangesMin / pstSearchResult^.DirectionalChanges * directionChangesWeight;
	END_IF
	
	IF pstSearchResult^.DoorsInPath = 0 THEN
		pstSearchResult^.DoorsInPathSubScore :=  doorsInPathWeight;
	ELSE
		pstSearchResult^.DoorsInPathSubScore :=  doorsInPathMin / pstSearchResult^.DoorsInPath * doorsInPathWeight;
	END_IF
 
	pstSearchResult^.HasEmptyTableInPathSubScore :=  BOOL_TO_INT(pstSearchResult^.HasEmptyTableInPath) * hasEmptyTableInPathWeight;
	
	pstSearchResult^.HasIncomingDoorInPathSubScore :=  BOOL_TO_INT(pstSearchResult^.HasIncomingDoorInPath) * hasIncomingDoorInPathWeight;
	
	pstSearchResult^.FinalScore := pstSearchResult^.NumberOfHopsSubScore + pstSearchResult^.DirectionChangesSubScore + pstSearchResult^.DoorsInPathSubScore + pstSearchResult^.HasEmptyTableInPathSubScore + pstSearchResult^.HasIncomingDoorInPathSubScore;
	
	IF pstSearchResult^.HasDoorGoingOppositeDirection OR
		pstSearchResult^.HasDeadlockedDoorInPath OR		
		((pstSearchResult^.RotationRequired XOR stDoorTrackLast.DoorWasRotated) AND NOT pstSearchResult^.PathHasRotateOption) 
	THEN
		IF cmd_bRequestNewRoute THEN
			stRejectedFeedoutPort.TableIndex := pstSearchResult^.PathIno.Path[pstSearchResult^.PathIno.PathCount - 1].TableIndex;
			stRejectedFeedoutPort.Side := pstSearchResult^.TargetFeedoutSide;
			addToRejectedFeedoutPorts(stRejectedFeedoutPort);
		END_IF
		CONTINUE;
	END_IF
	
	IF cmd_bRequestNewRoute THEN
		stReroutableFeedoutPort.TableIndex := pstSearchResult^.PathIno.Path[pstSearchResult^.PathIno.PathCount - 1].TableIndex;
		stReroutableFeedoutPort.Side := pstSearchResult^.TargetFeedoutSide;
		addToReroutableFeedoutPorts(stReroutableFeedoutPort);
	ELSE 	
		IF pstSearchResultWithMaxFinalScore = 0 THEN
			pstSearchResultWithMaxFinalScore := pstSearchResult;
		ELSIF pstSearchResult^.FinalScore > pstSearchResultWithMaxFinalScore^.FinalScore THEN
			pstSearchResultWithMaxFinalScore := pstSearchResult;
		END_IF
	END_IF
END_FOR

IF cmd_bRequestNewRoute THEN
	// save these before restoring to last door-track.	
	stAllEnabledFeedoutPorts := stDoorTrack.AllEnabledFeedoutPorts;
	stRejectedFeedoutPorts := stDoorTrack.RejectedFeedoutPorts;
	stReroutableFeedoutPorts := stDoorTrack.ReroutableFeedoutPorts;
	stCandidateRoutes := stDoorTrack.CandidateRoutes;
	stSearchResults := stDoorTrack.SearchResults;
	
	// restore to last door track. 
	stDoorTrack := stDoorTrackLast;
	
	// restore these for oeprator's manual rerouting.
	stDoorTrack.AllEnabledFeedoutPorts := stAllEnabledFeedoutPorts;
	stDoorTrack.RejectedFeedoutPorts := stRejectedFeedoutPorts;
	stDoorTrack.ReroutableFeedoutPorts := stReroutableFeedoutPorts;	
	stDoorTrack.CandidateRoutes := stCandidateRoutes;
	stDoorTrack.SearchResults := stSearchResults;
ELSE	
	IF pstSearchResultWithMaxFinalScore <> 0 THEN
		IF pstSearchResultWithMaxFinalScore^.PathIno.PathCount > 0 THEN
			stDoorTrack.Target := pstSearchResultWithMaxFinalScore^.PathIno.Path[pstSearchResultWithMaxFinalScore^.PathIno.PathCount - 1].TableIndex;
			stDoorTrack.TargetName := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[stDoorTrack.Target].Name;
			stDoorTrack.TargetPath := pstSearchResultWithMaxFinalScore^.PathIno;
			stDoorTrack.TargetFeedoutSide := pstSearchResultWithMaxFinalScore^.TargetFeedoutSide;
			stDoorTrack.DoorRotateRequired := pstSearchResultWithMaxFinalScore^.RotationRequired;
			stDoorTrack.DoorWasRotated := stDoorTrackLast.DoorWasRotated;
			stDoorTrack.HasEmptyTableInPath := pstSearchResultWithMaxFinalScore^.HasEmptyTableInPath;
			stDoorTrack.HasDoorGoingOppositeDirection := pstSearchResultWithMaxFinalScore^.HasDoorGoingOppositeDirection;
			stDoorTrack.HasIncomingDoorInPath := pstSearchResultWithMaxFinalScore^.HasIncomingDoorInPath;
			stDoorTrack.HasDeadlockedDoorInPath := pstSearchResultWithMaxFinalScore^.HasDeadlockedDoorInPath;
		END_IF
	ELSE
		// Failed to find new route. Set to default to clear TargetDoorTrackInfo on HMI.
		stDoorTrack := stDoorTrackDefault;
	END_IF
END_IF

IF cmd_bNewRouteRequestedFromDoorHasNoTarget AND stDoorTrack.Target = -1 THEN
	stDoorTrack.TargetFeedoutPorts := stAllEnabledFeedoutPorts;
ELSE
	bFoundValidRoute := stDoorTrack.Target <> -1 AND stDoorTrack.TargetPath.PathCount > 0;
	IF NOT bFoundValidRoute THEN
		stTargetFeedoutPorts := stDoorTrack.TargetFeedoutPorts;
		// restore to last door track. 
		stDoorTrack := stDoorTrackLast;		
		stDoorTrack.TargetFeedoutPorts := stTargetFeedoutPorts;
	END_IF
END_IF





]]></ST>
      </Implementation>
    </Method>
    <Method Name="currentTargetFeedoutPortEnabled" Id="{fd5f3e03-c897-44c1-8236-b5182b87fd5c}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD currentTargetFeedoutPortEnabled : BOOL
VAR_INPUT
END_VAR
VAR
	i : INT;
	j : INT;
	k : INT;
	stFeedoutPort : ST_FeedoutPort;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[currentTargetFeedoutPortEnabled := TRUE; // default true to only check after Target and DestinationIndex were assigned.
IF 	stDoorTrack.DestinationIndex <> -1 THEN
	// the table has a Target table, now check if any of the feed-out port is enabled.
	currentTargetFeedoutPortEnabled := FALSE;
	i := stDoorTrack.Source;
	IF MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappingsCount > 0 THEN
		FOR j:=0 TO MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappingsCount - 1 DO
			IF MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappings[j].DestinationIndex = stDoorTrack.DestinationIndex THEN
				IF MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappings[j].FeedoutPortsCount > 0 THEN
					FOR k:=0 TO MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappings[j].FeedoutPortsCount - 1 DO
						stFeedoutPort := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappings[j].FeedoutPorts[k];
						IF stDoorTrack.Target = stFeedoutPort.TableIndex AND 
							stDoorTrack.TargetFeedoutSide = stFeedoutPort.Side AND 
							MAIN.mainStateMachine.asmTableManagers[stFeedoutPort.TableIndex].isFeedoutSideEnabled(stFeedoutPort.Side) THEN
							currentTargetFeedoutPortEnabled := TRUE;
							RETURN;
						END_IF
					END_FOR
				END_IF
				EXIT;
			END_IF
		END_FOR
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="doesPathRequireRotation" Id="{0b327541-31ff-4a5c-86bd-9d0f3be5970e}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD doesPathRequireRotation : BOOL
VAR_INPUT
	pstPath : POINTER TO ST_PathInfo;
	iOriginalSource : INT; // the original table index where the door first fed in.
	eDoorHand : E_DOORHAND;
	eTargetFeedoutSide : E_FeedoutSideType;
END_VAR
VAR
	targetTableIndex : INT;
	sourceBypassInfeedSideA_IsLockEdgeRightOfAB : BOOL;
	sourceDoorOrientationConfig : ST_DoorOrientationConfig;
	targetDoorOrientationConfig : ST_DoorOrientationConfig;
	sourceDoorMachineOrientation : ST_DoorMachineOrientation;
	targetDoorMachineOrientation : ST_DoorMachineOrientation;
	isSourceAndTargetDoorMachineOrientationMatched : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[doesPathRequireRotation := FALSE;
IF pstPath = 0 THEN	
	RETURN;
END_IF

targetTableIndex := pstPath^.Path[pstPath^.PathCount - 1].TableIndex;
sourceDoorOrientationConfig := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[iOriginalSource].InOutfeedDoorOrientationConfig.InfeedSideA;
sourceBypassInfeedSideA_IsLockEdgeRightOfAB := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[iOriginalSource].InOutfeedDoorOrientationConfig.BypassInfeedSideA_IsLockEdgeRightOfAB;

IF eTargetFeedoutSide = E_FeedoutSideType.A THEN
	targetDoorOrientationConfig := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[targetTableIndex].InOutfeedDoorOrientationConfig.OutfeedSideA;
ELSIF eTargetFeedoutSide = E_FeedoutSideType.B THEN
	targetDoorOrientationConfig := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[targetTableIndex].InOutfeedDoorOrientationConfig.OutfeedSideB;
ELSIF eTargetFeedoutSide = E_FeedoutSideType.C THEN
	targetDoorOrientationConfig := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[targetTableIndex].InOutfeedDoorOrientationConfig.OutfeedSideC;
ELSIF eTargetFeedoutSide = E_FeedoutSideType.D THEN
	targetDoorOrientationConfig := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[targetTableIndex].InOutfeedDoorOrientationConfig.OutfeedSideD;
END_IF

IF eDoorHand = E_DOORHAND.DOORHAND_LEFT THEN
	sourceDoorMachineOrientation := sourceDoorOrientationConfig.LeftHand;
	targetDoorMachineOrientation := targetDoorOrientationConfig.LeftHand;
ELSIF eDoorHand = E_DOORHAND.DOORHAND_RIGHT THEN
	sourceDoorMachineOrientation := sourceDoorOrientationConfig.RightHand;
	targetDoorMachineOrientation := targetDoorOrientationConfig.RightHand;
ELSIF eDoorHand = E_DOORHAND.DOORHAND_LEFT_REVERSE THEN
	sourceDoorMachineOrientation := sourceDoorOrientationConfig.LeftHandReverse;
	targetDoorMachineOrientation := targetDoorOrientationConfig.LeftHandReverse;
ELSIF eDoorHand = E_DOORHAND.DOORHAND_RIGHT_REVERSE THEN
	sourceDoorMachineOrientation := sourceDoorOrientationConfig.RightHandReverse;
	targetDoorMachineOrientation := targetDoorOrientationConfig.RightHandReverse;
END_IF
isSourceAndTargetDoorMachineOrientationMatched := 
	(sourceBypassInfeedSideA_IsLockEdgeRightOfAB OR 
	(sourceDoorMachineOrientation.IsLockEdgeRightOfAB = targetDoorMachineOrientation.IsLockEdgeRightOfAB)) AND
	sourceDoorMachineOrientation.IsTopEdgeOnASide = targetDoorMachineOrientation.IsTopEdgeOnASide;
doesPathRequireRotation := NOT isSourceAndTargetDoorMachineOrientationMatched;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="doState" Id="{6a4cbce2-2fc3-4e59-823c-ed92f85a8b31}">
      <Declaration><![CDATA[METHOD doState
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE (machineState) OF	
	TABLEMANAGER_DISABLED:
		IF bFirstPass THEN
			downstream.setAllDownstreamDisabled();
			status_bBusy := FALSE;
			bError := FALSE;
			status_bReady := FALSE;
			cmd_bAutoFeedOn := FALSE;
			bExternal := FALSE;
			setJobProcessingPhase(E_JobProcessingPhases.JOB_PHASE_NOT_ACCEPTING);
		END_IF
                
	TABLEMANAGER_ENABLING:
		downstream.setAllDownstreamEnabled();
		IF downstream.status_bDownstreamAllReady THEN
			machineState := TABLEMANAGER_AUTOFEED_OFF;
		END_IF

	TABLEMANAGER_INLINE_JOGGING:
		status_bBusy := TRUE;
		smC234FeedManager.cmd_bInlineTransferFwd := cmd_bInlineTransferFwd;
		smC234FeedManager.cmd_bInlineTransferRev := cmd_bInlineTransferRev;
		smC234FeedManager.cmd_bJogSlow := cmd_bJogSlow;
		IF NOT (cmd_bInlineTransferFwd OR cmd_bInlineTransferRev) THEN
			machineState := TABLEMANAGER_AUTOFEED_OFF;
		END_IF
		
	TABLEMANAGER_CROSS_JOGGING:
		status_bBusy := TRUE;
		IF config_bIsConveyorTable THEN
			smC235FeedManager.cmd_bCrossTransferFwd := cmd_bCrossTransferFwd;
			smC235FeedManager.cmd_bCrossTransferRev := cmd_bCrossTransferRev;
			smC235FeedManager.cmd_bJogSlow := cmd_bJogSlow;
		ELSE
			smC234FeedManager.cmd_bCrossTransferFwd := cmd_bCrossTransferRev;
			smC234FeedManager.cmd_bCrossTransferRev := cmd_bCrossTransferFwd;
			smC234FeedManager.cmd_bJogSlow := cmd_bJogSlow;
		END_IF
		IF NOT (cmd_bCrossTransferFwd OR cmd_bCrossTransferRev) THEN
			machineState := TABLEMANAGER_AUTOFEED_OFF;
		END_IF
		
	TABLEMANAGER_TO_FENCE_JOGGING:
		status_bBusy := TRUE;
		smC234FeedManager.cmd_bToFenceFwd := cmd_bToFenceRev;
		smC234FeedManager.cmd_bToFenceRev := cmd_bToFenceFwd;
		smC234FeedManager.cmd_bJogSlow := cmd_bJogSlow;
		
		IF NOT (cmd_bToFenceFwd OR cmd_bToFenceRev) THEN
			machineState := TABLEMANAGER_AUTOFEED_OFF;
		END_IF
	
	TABLEMANAGER_ROTATE:
		IF bFirstPass THEN
			status_bBusy := TRUE;
			smC234FeedManager.cmd_bRotate := TRUE;
		END_IF
		ftrigRotateComplete(CLK:=smC234FeedManager.status_bBusy);
		IF ftrigRotateComplete.Q THEN
			machineState := TABLEMANAGER_AUTOFEED_OFF;
		END_IF
		
	TABLEMANAGER_SELF_CENTER:
		IF bFirstPass THEN
			status_bBusy := TRUE;
			smC234FeedManager.cmd_bSelfCenter := TRUE;
		END_IF
		ftrigSelfCenterComplete(CLK:=smC234FeedManager.status_bBusy);
		IF ftrigSelfCenterComplete.Q THEN
			machineState := TABLEMANAGER_AUTOFEED_OFF;
		END_IF
		
	TABLEMANAGER_AUTOFEED_OFF:
		IF bFirstPass THEN
			status_bBusy := FALSE;
			status_bReady := TRUE;
			bExternal := FALSE;
			cmd_bInitialized := FALSE;
			bFindingPath := FALSE;
			cmd_bRequestNewRoute := FALSE;
			setReadyToFeedoutSides(FALSE);
			setJobProcessingPhase(E_JobProcessingPhases.JOB_PHASE_NOT_ACCEPTING);
		END_IF

		IF cmd_bSelfCenter AND
			bOkToSelfCenter AND
			config_bCanSelfCenter AND
			cmd_bManualControlEnabled THEN
			machineState := TABLEMANAGER_SELF_CENTER;
		ELSIF cmd_bRotate AND
			bReadyToRotate AND
			config_bCanRotate AND
			cmd_bManualControlEnabled THEN
			machineState := TABLEMANAGER_ROTATE;
		ELSIF (cmd_bInlineTransferFwd OR cmd_bInlineTransferRev) AND cmd_bManualControlEnabled THEN
			machineState := TABLEMANAGER_INLINE_JOGGING;
		ELSIF (cmd_bCrossTransferFwd OR cmd_bCrossTransferRev) AND 
				(config_bIsConveyorTable OR NOT config_bIsBufferTable) AND 
				cmd_bManualControlEnabled THEN
			machineState := TABLEMANAGER_CROSS_JOGGING;	
		ELSIF (cmd_bToFenceFwd OR cmd_bToFenceRev) AND
				NOT (config_bIsBufferTable OR config_bIsConveyorTable) AND
				cmd_bManualControlEnabled THEN
			machineState := TABLEMANAGER_TO_FENCE_JOGGING;
		ELSIF cmd_bAutoFeedOn THEN
			machineState := TABLEMANAGER_AUTOFEED_ON;		
		END_IF
		
	TABLEMANAGER_AUTOFEED_ON:
		IF bFirstPass THEN			
			status_bBusy := FALSE;
			bExternal := FALSE;
			cmd_bRequestNewRoute := FALSE;
			cmd_bDoorHasNoTarget := FALSE;
			setJobProcessingPhase(E_JobProcessingPhases.JOB_PHASE_NOT_ACCEPTING);
		ELSE
			IF cmd_bInitialized THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_START;
			ELSIF NOT cmd_bAutoFeedOn THEN
				machineState := TABLEMANAGER_AUTOFEED_OFF;
			END_IF
		END_IF
		
	TABLEMANAGER_DOOR_TRACKER_START:
		IF bFirstPass THEN			
			setReadyToFeedoutSides(FALSE);	
			setJobProcessingPhase(E_JobProcessingPhases.JOB_PHASE_NOT_ACCEPTING);
		END_IF
		
		IF cmd_bRequestNewRoute THEN
			machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_INIT;
		ELSIF cmd_bNewTargetFeedoutPortSelected THEN
			machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_INIT;
		ELSIF bHasDoor AND NOT bAnyCurrentTargetFeedoutPortEnabled THEN
			machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_INIT;
		ELSIF bHasDoor THEN
			machineState := TABLEMANAGER_DOOR_TRACKER_DOOR_IN_MACHINE_IDLE;
		ELSIF cmd_bNext THEN
			machineState := TABLEMANAGER_DOOR_TRACKER_WAIT_FOR_DATA_READY_OR_TRANSFERRED_IN;
		END_IF

	TABLEMANAGER_DOOR_TRACKER_WAIT_FOR_DATA_READY_OR_TRANSFERRED_IN:
		IF bFirstPass THEN
			cmd_bRequestNewRoute := FALSE;
			cmd_bNewTargetFeedoutPortSelected := FALSE;
			cmd_bNewRouteRequested := FALSE;
			initDoorTrack();
			resetDoorTrack();
			clearDoorTrackDoorIdAndTarget();
			setJobProcessingPhase(E_JobProcessingPhases.JOB_PHASE_NONE_PENDING);	
		END_IF
		IF cmd_bDoorDataReadyLatched THEN
			machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_INIT;
		ELSIF cmd_bDoorTransferInStarted THEN
			machineState := TABLEMANAGER_DOOR_TRACKER_TRANSFERRING_IN;
		END_IF

	TABLEMANAGER_DOOR_TRACKER_TRANSFERRING_IN:
		IF bFirstPass THEN
			;
		END_IF
		IF cmd_bDoorTransferInCompleted THEN
			machineState := TABLEMANAGER_DOOR_TRACKER_DOOR_IN_MACHINE_IDLE;
		END_IF
	
	TABLEMANAGER_DOOR_TRACKER_ROUTE_READY_WAIT_FOR_FEED_IN:
		IF bFirstPass THEN
			clearNextDoorId();
			setJobProcessingPhase(E_JobProcessingPhases.JOB_PHASE_PENDING);
		ELSE
			cmd_bReroute := rtrigIncomingDoorHandChanged.Q;
			IF cmd_bReroute THEN
				cmd_bReroute := FALSE;
				machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_INIT;
			ELSIF rtrigTargetFeedoutPortsDisabled.Q THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_INIT;
			ELSIF NOT cmd_bDoorDataReadyLatched THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_WAIT_FOR_DATA_READY_OR_TRANSFERRED_IN;			
			ELSIF cmd_bFeedinStarted THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_DOOR_FEEDING_IN;
			END_IF
		END_IF
		
	TABLEMANAGER_DOOR_TRACKER_DOOR_FEEDING_IN:
		IF bFirstPass THEN
			setNextDoorId();
			iSourceDestinationIndexFeedoutPortsCount := getSourceAndDestinationIndexFeedoutPortsCount();
			bIsHungryModeRouting := iSourceDestinationIndexFeedoutPortsCount > 1;
			setJobProcessingPhase(E_JobProcessingPhases.JOB_PHASE_PRE_PROCESSING);
		ELSE
			IF cmd_bFeedinCompleted THEN
				bAnyFeedoutTableEmptyAndReady := anyFeedoutTableEmptyAndReady();
				IF bIsHungryModeRouting AND (cmd_bDoorDataReadyLatched OR bAnyFeedoutTableEmptyAndReady) 
				THEN
					machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_INIT;
				ELSE
					machineState := TABLEMANAGER_DOOR_TRACKER_DOOR_IN_MACHINE_IDLE;
				END_IF
			END_IF
		END_IF
		
	TABLEMANAGER_DOOR_TRACKER_DOOR_IN_MACHINE_IDLE:
		IF bFirstPass THEN
			cmd_bRequestNewRoute := FALSE;
			cmd_bNewTargetFeedoutPortSelected := FALSE;
			cmd_bDoorTransferOutStarted := FALSE;
			cmd_bDoorTransferOutStartedFromIdle := FALSE;
			iSourceDestinationIndexFeedoutPortsCount := getSourceAndDestinationIndexFeedoutPortsCount();
			bIsHungryModeRouting := iSourceDestinationIndexFeedoutPortsCount > 1;
			setReadyToFeedoutSides(FALSE);
			rtrigDoorDasherReady(CLK:=FALSE);
			rtrigAnyFeedoutTableEmptyAndReady(CLK:=FALSE);
			setJobProcessingPhase(E_JobProcessingPhases.JOB_PHASE_PROCESSING);
		ELSE
			IF rtrigDoorDataReadyLatched.Q AND bIsHungryModeRouting THEN
				rerouteAllTablesWaitingTransferredOut();
			END_IF 		
			

			bAnyNeighboringTableEmpty := anyNeighboringTableEmpty();
			bAnyFeedoutTableEmptyAndReady := anyFeedoutTableEmptyAndReady();
			bAnyNeighboringTableHasDoorAndDataReadyActive := anyNeighboringTableHasDoorAndDataReadyActive();
			
			rtrigAnyFeedoutTableEmptyAndReady(CLK:=	bIsHungryModeRouting AND
													( 
													// Do not handle this case. For SN6, this causes door to move around T2 and T3 if T1's Data Ready Latch is active.
													// T5 just fed out door, T4 has door.
													//(bAnyFeedoutTableEmptyAndReady AND NOT stDoorTrack.HasIncomingDoorInPath) OR 
				
													(bAnyNeighboringTableEmpty AND bAnyNeighboringTableHasDoorAndDataReadyActive) OR
													
													// Only apply to input table.  If the Data Ready Latch is on while the the neighboring table's DoorDasher seq
													// is running, the door dasher seq of this current table might not allow to run. So this
													// check will look for an empty neighboring table periodically to move door out and clear for new incoming door. 
													(cmd_bDoorDataReadyLatched AND bAnyNeighboringTableEmpty))
													
													AND
    
													NOT status_bBusy AND
													
													// Prevent rapidly triggering reroute by waiting 1 sec before looking for an empty feed-out table to route the door to.
													tTimeInState>T#1.0S
												);
			IF rtrigAnyFeedoutTableEmptyAndReady.Q THEN
				cmd_bReroute := TRUE;
			END_IF	
				

						
			rtrigDoorDasherReady(CLK:= 
				NOT bReadyToFeedout AND
				(rtrigAnyTableDoorTrackTargetChanged.Q OR		
				NOT status_bBusy)
				);

			IF rtrigReadyToFeedout.CLK THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_WAIT_FOR_FEED_OUT;			
			ELSIF rtrigTableIndexNotExistInDoorTrackTargetPath.CLK THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_INIT;
			ELSIF ftrigAllCurrentTargetFeedoutPortsEnabled.Q THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_INIT;
			ELSIF cmd_bRequestNewRoute THEN
				cmd_bNewRouteRequestedFromDoorInMachineIdle := TRUE;
				machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_INIT;
			ELSIF cmd_bNewTargetFeedoutPortSelected THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_INIT;
			ELSIF cmd_bDoorTransferOutStartedFromIdle THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_TRANSFERRING_OUT;			
			ELSIF cmd_bReroute AND bIsHungryModeRouting THEN
				cmd_bReroute := FALSE;				
				machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_INIT;
			ELSIF rtrigDoorDasherReady.Q OR (NOT bIsHungryModeRouting AND rtrigDoorDasherReady.CLK) THEN
				smDoorDasher.doorDash();
			END_IF			
		END_IF
		
	TABLEMANAGER_DOOR_TRACKER_WAIT_FOR_FEED_OUT:
		IF bFirstPass THEN
			cmd_bRequestNewRoute := FALSE;
			cmd_bNewTargetFeedoutPortSelected := FALSE;
			cmd_bDoorTransferOutStarted := FALSE;
			cmd_bDoorTransferOutStartedFromIdle := FALSE;
			iSourceDestinationIndexFeedoutPortsCount := getSourceAndDestinationIndexFeedoutPortsCount();
			bIsHungryModeRouting := iSourceDestinationIndexFeedoutPortsCount > 1;
			setReadyToFeedoutSides(FALSE);
			rtrigAnyFeedoutTableEmptyAndReady(CLK:=FALSE);
		END_IF
		
		blinkReadyToFeedoutSides();
		bAnyTableEmpty := anyTableEmpty();
		bAnyNeighboringTableEmpty := anyNeighboringTableEmpty();
		bAnyFeedoutTableEmptyAndReady := anyFeedoutTableEmptyAndReady();
		bAnyTableWithDoorHasNoTarget := anyTableWithDoorHasNoTarget();
		rtrigAnyFeedoutTableEmptyAndReady(CLK:=
			(bAnyNeighboringTableEmpty OR bAnyFeedoutTableEmptyAndReady) AND
				cmd_bDoorDataReadyLatched AND
				NOT bAnyTableWithDoorHasNoTarget
			);
				
		IF 
			bIsHungryModeRouting AND // true if source+destination index feedout ports count > 1			
			(rtrigDoorDataReadyLatched.Q OR 
			rtrigAnyFeedoutTableEmptyAndReady.Q OR 
			
			// Data-ready latch is active. 
			// Periodically send out reroute request to all tables with doors. 
			(cmd_bDoorDataReadyLatched AND 
			tTimeInState>T#1.0S AND 
			(bAnyTableEmpty
			))) 
			THEN
			rerouteAllTablesWaitingTransferredOut();
			cmd_bReroute := TRUE;
		END_IF 
		
		IF ftrigReadyToFeedout.Q THEN
			machineState := TABLEMANAGER_DOOR_TRACKER_DOOR_IN_MACHINE_IDLE;
		ELSIF cmd_bReroute AND bIsHungryModeRouting THEN
			cmd_bReroute := FALSE;
			machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_INIT;
		ELSIF ftrigAllCurrentTargetFeedoutPortsEnabled.Q THEN
			machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_INIT;
		ELSIF cmd_bRequestNewRoute THEN
			cmd_bNewRouteRequestedFromWaitForFeedout := TRUE;
			machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_INIT;
		ELSIF cmd_bNewTargetFeedoutPortSelected THEN
			machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_INIT;
		ELSIF cmd_bFeedoutStarted THEN
			machineState := TABLEMANAGER_DOOR_TRACKER_DOOR_FEEDING_OUT;
		ELSIF cmd_bDoorTransferOutStarted THEN
			machineState := TABLEMANAGER_DOOR_TRACKER_TRANSFERRING_OUT;
		END_IF
	
	TABLEMANAGER_DOOR_TRACKER_DOOR_FEEDING_OUT:
		IF bFirstPass THEN
			setReadyToFeedoutSides(FALSE);
			setReadyToFeedoutSide(TRUE);
			setJobProcessingPhase(E_JobProcessingPhases.JOB_PHASE_POST_PROCESSING);
		END_IF
		IF cmd_bFeedoutCompleted THEN
			machineState := TABLEMANAGER_DOOR_TRACKER_WAIT_ALL_TABLES_READY;
		END_IF
		
	TABLEMANAGER_DOOR_TRACKER_WAIT_ALL_TABLES_READY:
		IF bFirstPass THEN
			tonAllTablesReady(IN:=FALSE, PT:=config_tRerouteWaitTime);
			rtrigAllTablesReady(CLK:=FALSE);
		END_IF
		bAllTablesReady := allTablesReady();
		tonAllTablesReady(IN:=bAllTablesReady);
		rtrigAllTablesReady(CLK:=tonAllTablesReady.Q);
		IF rtrigAllTablesReady.Q THEN
			IF NOT bHasDoor THEN
				// while waiting for all tables to be ready, a new door might be transferred in from the feed-in port (ie, SN6, T1->T5).
				// So only send reroute request to all tables with 'Door-In-Machine' state if this table has no door.
				rerouteAllTablesWaitingTransferredOut();
			END_IF
			machineState := TABLEMANAGER_DOOR_TRACKER_COMPLETE;
		END_IF
		
	TABLEMANAGER_DOOR_TRACKER_TRANSFERRING_OUT:        
		IF bFirstPass THEN
			setReadyToFeedoutSides(FALSE);
			ftrigDoorTransferredOut(CLK:=FALSE);
			setJobProcessingPhase(E_JobProcessingPhases.JOB_PHASE_POST_PROCESSING);
		ELSE
			ftrigDoorTransferredOut(CLK:=smDoorDasher.status_bBusy);
			IF ftrigDoorTransferredOut.Q THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_COMPLETE;
			END_IF
		END_IF

	TABLEMANAGER_DOOR_TRACKER_COMPLETE:        
		IF bFirstPass THEN			
			setJobProcessingPhase(E_JobProcessingPhases.JOB_PHASE_FINISHED);
			IF config_bNoHardwareTestMode THEN
			   smC234FeedManager.di_InMachineEye := FALSE;
			END_IF			
		END_IF
		IF cmd_bNext THEN
			machineState := TABLEMANAGER_DOOR_TRACKER_START;		
		END_IF
		
	TABLEMANAGER_DOOR_TRACKER_FINDPATH_INIT:
		IF bFirstPass THEN			
			bFindingPath := TRUE;
			initDoorTrack();
			setReadyToFeedoutSides(FALSE);
		ELSIF cmd_bNext THEN
			IF bHasDoor AND stDoorTrack.Source <> -1 THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_FIND_ENABLED_FEEDOUT_PORTS;
			ELSE
				machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_RESET;
			END_IF
		END_IF
		
	TABLEMANAGER_DOOR_TRACKER_FINDPATH_RESET:
		IF bFirstPass THEN
			resetDoorTrack();
		ELSIF cmd_bNext THEN
			machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_FIND_ENABLED_FEEDOUT_PORTS;
		END_IF
		
	TABLEMANAGER_DOOR_TRACKER_FINDPATH_FIND_ENABLED_FEEDOUT_PORTS:
		IF bFirstPass THEN
			bHasEnabledFeedoutPorts := findAllEnabledFeedoutPorts();
		ELSIF cmd_bNext THEN
			IF bHasEnabledFeedoutPorts THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_FIND_CANDIDATE_ROUTES;
			ELSIF cmd_bNewRouteRequested THEN
				// restore to last door track. 
				stDoorTrack := stDoorTrackLast;
				machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_COMPLETE;
			ELSE
				machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_WAITING_FOR_CLEAR_ROUTE;
			END_IF
		END_IF
		
	TABLEMANAGER_DOOR_TRACKER_FINDPATH_WAITING_FOR_CLEAR_ROUTE:
		IF bFirstPass THEN
			bFindingPath := FALSE;
			cmd_bRequestNewRoute := FALSE;	
			cmd_bNewTargetFeedoutPortSelected := FALSE;
			// restore to last door track. 
			stDoorTrack := stDoorTrackLast;
			stDoorTrack.Target := -1;
			stDoorTrack.TargetName := '--';
		ELSE
			IF NOT cmd_bDoorDataReadyLatched THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_COMPLETE;
			ELSIF cmd_bRequestNewRoute THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_INIT;
				cmd_bNewRouteRequestedFromWaitingForClearRoute:=TRUE;
			ELSIF cmd_bNewTargetFeedoutPortSelected THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_INIT;
			ELSIF cmd_bRetry THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_INIT;
			END_IF
		END_IF
		
	TABLEMANAGER_DOOR_TRACKER_FINDPATH_FIND_CANDIDATE_ROUTES:
		IF bFirstPass THEN
			findAllCandidateRoutes();
		ELSIF cmd_bNext THEN
			machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_FIND_SEARCH_RESULTS;
		END_IF
		
	TABLEMANAGER_DOOR_TRACKER_FINDPATH_FIND_SEARCH_RESULTS:
		IF bFirstPass THEN
			findSearchResults();
		ELSIF cmd_bNext THEN
			machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_COMPUTE_FINAL_SCORE;
		END_IF
	
	TABLEMANAGER_DOOR_TRACKER_FINDPATH_COMPUTE_FINAL_SCORE:
		IF bFirstPass THEN
			computeFinalScore();
		ELSIF cmd_bNext THEN
			IF bFoundValidRoute THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_COMPLETE;
			ELSIF cmd_bNewRouteRequested THEN
				IF NOT (cmd_bNewRouteRequestedFromDoorHasNoTarget AND stDoorTrack.Target = -1) THEN
					// restore to last door track. 
					stDoorTrack := stDoorTrackLast;
				END_IF
				machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_COMPLETE;
			ELSE				
				machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_WAITING_FOR_CLEAR_ROUTE;
			END_IF			
		END_IF
	
	TABLEMANAGER_DOOR_TRACKER_FINDPATH_REQUEST_NEW_ROUTE_COMPLETE:
		IF bFirstPass THEN
			cmd_bRequestNewRoute := FALSE;			
		ELSE
			IF cmd_bNewRouteRequestedFromWaitingForClearRoute THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_WAITING_FOR_CLEAR_ROUTE;
			ELSIF cmd_bNewRouteRequestedFromAllTargetFeedoutPortsDisabled THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_ALL_TARGET_FEEDOUT_PORTS_DISABLED;
			ELSIF cmd_bNewRouteRequestedFromDoorHasNoTarget THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_DOOR_HAS_NO_TARGET;
			ELSIF cmd_bNewRouteRequestedFromDoorInMachineIdle OR 
				cmd_bNewRouteRequestedFromWaitForFeedout THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_DOOR_IN_MACHINE_IDLE;
			ELSIF cmd_bNext THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_COMPLETE;				
			END_IF
			cmd_bNewRouteRequestedFromWaitingForClearRoute := FALSE;
			cmd_bNewRouteRequestedFromAllTargetFeedoutPortsDisabled := FALSE;
			cmd_bNewRouteRequestedFromDoorHasNoTarget := FALSE;
			cmd_bNewRouteRequestedFromDoorInMachineIdle := FALSE;
			cmd_bNewRouteRequestedFromWaitForFeedout := FALSE;					
		END_IF
	
	TABLEMANAGER_DOOR_TRACKER_FINDPATH_COMPLETE:
		IF bFirstPass THEN
			bFindingPath := FALSE;
			cmd_bNewTargetFeedoutPortSelected := FALSE;
			cmd_bNewRouteRequested := FALSE;	
			IF cmd_bRequestNewRoute THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_FINDPATH_REQUEST_NEW_ROUTE_COMPLETE;
			ELSIF cmd_bNext THEN
				IF bHasDoor THEN
					machineState := TABLEMANAGER_DOOR_TRACKER_DOOR_IN_MACHINE_IDLE;
				ELSE
					machineState := TABLEMANAGER_DOOR_TRACKER_ROUTE_READY_WAIT_FOR_FEED_IN;
				END_IF
			END_IF
		END_IF
		
	TABLEMANAGER_DOOR_TRACKER_ALL_TARGET_FEEDOUT_PORTS_DISABLED:
		IF bFirstPass THEN
			bFindingPath := FALSE;
			cmd_bRequestNewRoute := FALSE;
			cmd_bNewTargetFeedoutPortSelected := FALSE;
			setReadyToFeedoutSides(FALSE);
		ELSE
			IF cmd_bRequestNewRoute THEN
				cmd_bNewRouteRequestedFromAllTargetFeedoutPortsDisabled:=TRUE;
				machineState := TABLEMANAGER_DOOR_TRACKER_START;
			ELSIF cmd_bNewTargetFeedoutPortSelected THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_START;
			ELSIF ftrigAllTargetFeedoutPortsDisabled.Q THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_START;
			ELSIF NOT cmd_bAutoFeedOn THEN
				machineState := TABLEMANAGER_AUTOFEED_OFF;
			END_IF
		END_IF
	
	TABLEMANAGER_DOOR_TRACKER_DOOR_HAS_NO_TARGET:
		IF bFirstPass THEN
			bFindingPath := FALSE;
			cmd_bRequestNewRoute := FALSE;
			cmd_bNewTargetFeedoutPortSelected := FALSE;
			setReadyToFeedoutSides(FALSE);	
			setNextDoorId();	
			initInputSourceAndDestinationIndexWithHighestFeedoutPortsCount(stDoorTrack.Source, stDoorTrack.DestinationIndex);
		ELSE
			IF cmd_bRequestNewRoute THEN
				cmd_bDoorHasNoTarget := FALSE;
				cmd_bNewRouteRequestedFromDoorHasNoTarget:=TRUE;
				machineState := TABLEMANAGER_DOOR_TRACKER_START;
			ELSIF cmd_bNewTargetFeedoutPortSelected THEN
				machineState := TABLEMANAGER_DOOR_TRACKER_START;
			ELSIF ftrigDoorHasNoTarget.Q THEN
				cmd_bDoorHasNoTarget := FALSE;
				machineState := TABLEMANAGER_DOOR_TRACKER_START;
			ELSIF NOT cmd_bAutoFeedOn THEN
				machineState := TABLEMANAGER_AUTOFEED_OFF;
			END_IF
		END_IF
		
	TABLEMANAGER_ERROR:
		IF (bFirstPass) THEN
			bError := TRUE;	
			status_bBusy := FALSE;
			cmd_bAutoFeedOn := FALSE;
			bExternal := FALSE;
		END_IF
		IF cmd_bReset THEN
			smDoorDasher.cmd_bReset := TRUE;
			smC234FeedManager.cmd_bReset := TRUE;
			smC235FeedManager.cmd_bReset := TRUE;
			clearLastError();
			machineState := TABLEMANAGER_AUTOFEED_OFF;
		END_IF




END_CASE

]]></ST>
      </Implementation>
    </Method>
