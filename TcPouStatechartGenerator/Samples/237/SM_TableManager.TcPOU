    <Method Name="anySourceDestinationIndexFeedoutPortEnabled" Id="{9634d36c-8dae-42cf-afd4-bcabe9ec781c}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD anySourceDestinationIndexFeedoutPortEnabled : BOOL
VAR_INPUT
	selectedDestinationIndex : INT;
END_VAR
VAR
	j : INT;
	k : INT;
	stFeedoutPort : ST_FeedoutPort;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[anySourceDestinationIndexFeedoutPortEnabled := FALSE; 
IF MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[config_iTableArrayIndex].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappingsCount > 0 THEN
	FOR j:=0 TO MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[config_iTableArrayIndex].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappingsCount - 1 DO
		IF MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[config_iTableArrayIndex].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappings[j].FeedoutPortsCount > 0 THEN
			FOR k:=0 TO MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[config_iTableArrayIndex].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappings[j].FeedoutPortsCount - 1 DO
				IF MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[config_iTableArrayIndex].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappings[j].DestinationIndex = selectedDestinationIndex THEN
					stFeedoutPort := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[config_iTableArrayIndex].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappings[j].FeedoutPorts[k];
					IF MAIN.mainStateMachine.asmTableManagers[stFeedoutPort.TableIndex].isFeedoutSideEnabled(stFeedoutPort.Side) THEN
						anySourceDestinationIndexFeedoutPortEnabled := TRUE;
						RETURN;
					END_IF
				END_IF
			END_FOR
		END_IF
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Method>
