<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.14">
  <POU Name="SM_TableManager" Id="{174d8473-0e60-42e3-8b03-499b71e99b59}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK SM_TableManager EXTENDS  KvalStateMachineBaseExt IMPLEMENTS I_DoorTracker
VAR_INPUT
	pStatus_bAnyTableDoorTrackTargetChanged : POINTER TO BOOL;
	cmd_bReset							: BOOL; // reset from error state
	cmd_bAbort							: BOOL; // trigger event to abort any motion.
	// Job Sync (v1.0)
    fbJobSync							: FB_JobSynchronizer;
	cmd_sJobName 						: STRING;
	cmd_sJobNameLatched					: STRING;
	// commands
	cmd_bToFenceFwd						: BOOL;
	cmd_bToFenceRev						: BOOL;
	cmd_bCrossTransferFwd				: BOOL;
	cmd_bCrossTransferRev				: BOOL;
	cmd_bInlineTransferFwd				: BOOL;
	cmd_bInlineTransferRev				: BOOL;
	cmd_bJogSlow						: BOOL;
	cmd_bManualControlEnabled			: BOOL;
	cmd_bOutputPortEnabled				: BOOL;
	cmd_bRotate							: BOOL;
	cmd_bSelfCenter						: BOOL;	
	cmd_bExternal						: BOOL;
	cmd_bInternal						: BOOL;
	
	cmd_bDoorHasNoTarget 					: BOOL;
	cmd_bInitialized 						: BOOL;
	cmd_bDoorTransferInStarted 				: BOOL;
	cmd_bDoorDataReady 						: BOOL;
	cmd_bDoorDataReadyLatched 				: BOOL;
	cmd_bNewRouteRequested 					: BOOL;	
	cmd_bReroute							: BOOL;
	cmd_bReroutePending						: BOOL;
	cmd_bNewRouteRequestedFromDoorInMachineIdle : BOOL;
	cmd_bNewRouteRequestedFromWaitForFeedout : BOOL;
	cmd_bNewRouteRequestedFromAllTargetFeedoutPortsDisabled : BOOL;
	cmd_bNewRouteRequestedFromDoorHasNoTarget : BOOL;
	cmd_bNewRouteRequestedFromWaitingForClearRoute : BOOL;
	cmd_bDoorTransferInCompleted 			: BOOL;
	cmd_bFeedinStarted 						: BOOL;
	cmd_bFeedinCompleted 					: BOOL;

	cmd_bReadyToFeedOut : BOOL;
	cmd_bDoorTransferOutStartedFromIdle 	: BOOL;
	cmd_bDoorTransferOutStarted 			: BOOL;
	cmd_bDoorTransferOutCompleted 			: BOOL;
	cmd_bFeedoutStarted 					: BOOL;
	cmd_bFeedoutCompleted 					: BOOL;
	
	cmd_iSelectedDestinationIndexLast		: UINT;
	cmd_iSelectedDestinationIndex			: UINT;
	cmd_eIncomingDoorHand					: E_DOORHAND;
	cmd_eIncomingDoorHandLast				: E_DOORHAND;
	cmd_bIncomingDoorHandValid				: BOOL;
	cmd_iSelectedDestinationIndexLatched	: UINT;
	cmd_eIncomingDoorHandLatched			: E_DOORHAND;
	
	cmd_bNewTargetFeedoutPortSelected		: BOOL;
	cmd_stNewTargetFeedoutPort				: ST_FeedoutPort;
	config_bAutoDataReady					: BOOL; // true if table is an input port and the input port is configured for 'hungry-mode' where destination index 0 is mapped to 2 or more feed-out ports. 
													// On rising edge of LH/RH input valid, 'Data Ready' input is latched automatically, instead of user needs to press the 'Data Ready' button.
													// The physical 'Data Ready' button and the 'Destination Index' switch on the control box are not needed.
													
	config_bIsInputPortEnabled				: BOOL; // true if the table's input port is enabled and can receive door data from KvalCAM's job such as destination index and doorHand.
	config_bIsConveyorTable					: BOOL; // true if it's a conveyor table (class code 235); false = auto-cross transfer table (class code 234)
	config_bCanSelfCenter					: BOOL; // true if table has the self-centering option (Option S)
	config_bCanRotate						: BOOL; // true if table has the Auto-rotate option (Option A)
	cmd_bRequestNewRoute					: BOOL;
	config_bCanFeedinFromSideA				: BOOL; // true if it's an input port and its side A is available to feed-in door.
	config_bIsBufferTable					: BOOL; // true table is a T1 option, which can only do inline-transfer and not (cross-transfer or self-center)
	
	// --- Pointers to hot connect hardware --
	config_pstHcTransferTableHardware		: POINTER TO ST_HcTable;
	config_pstHcConveyorHardware			: POINTER TO ST_HcConveyor;
	
	// each table can have either a conveyor or a cross-and-straight manager, but not both.
	smC235FeedManager						: SM_235FeedManager; // manage cross feeding of the door in and out the machine.
	smC234FeedManager						: SM_234FeedManager; // manage cross-feeding of the door in and out the machine. 
	
	smDoorDasher							: SM_DoorDasher; // a door-dasher for DTS.
	
{IF defined (noHW) OR defined (noHW_UML)}
	psmHcFeedMotor							: POINTER TO SM_KMotorVFDEtherCATi550Ext; // balvm3539 1140 RPM 1/2 HP
{ELSE}
	psmHcFeedMotor							: POINTER TO SM_KMotorVFDEtherCATi550; // balvm3539 1140 RPM 1/2 HP
{END_IF}
	
	config_tRerouteWaitTime			: TIME := T#1.0S;
	
	// feed system configs
	// these are initialized from table topology sent by KvalCAM when press Ctrl+Shift+S key combination on the Main tab:
	config_iFeedFastSpeedFPM		: UINT := 150;				// Fast Feed Speed in Feet Per Minute
	config_iFeedSlowSpeedFPM		: UINT := 50;				// Slow Feed Speed in Feet Per Minute
	config_iFeedOutSpeedFPM			: UINT := 100;				// the speed at which the system feed's out.
	config_iCrossFeedFastSpeedFPM	: UINT := 75;				// Fast CrossFeed Speed in Feet Per Minute
	config_iCrossFeedSlowSpeedFPM	: UINT := 25;				// Slow CrossFeed Speed in Feet Per Minute
	config_iTableArrayIndex					: INT;						// The array table index.
	bDoorTrackDirty							: BOOL;
END_VAR
VAR_OUTPUT
	bTableReady : BOOL; // true if the table is ready to receive door.
	bTableIsEmpty : BOOL; // true if table is empty.
	bDoorInMachine				: BOOL; // true if NOT bTableIsEmpty AND door is completely inside machine (ie, not on C234's di_C or di_D eye)
	bOkToFeedOut		: BOOL;				// depending on the direction, is it ok to feed out?
	bHasDoor			: BOOL;		// true if bDoorInMachine is true.
	
	bReadyToRotate				: BOOL;
	bOkToSelfCenter : BOOL;
	bExternal: BOOL;
	status_bMoving		: BOOL;
	
	_bAllTargetFeedoutPortsDisabled : BOOL; // true if all of the Target's feedout ports are disabled.
	bAllTargetFeedoutPortsDisabled : BOOL; // true if all of the Target's feedout ports are disabled.
	_bDoorHasNoTarget : BOOL; // true if the init seq found a door on table but no Target is assigned.
	bDoorHasNoTarget : BOOL; // true if the init seq found a door on table but no Target is assigned.
	bCurrentTargetFeedoutPortEnabled : BOOL; // true if any of the Target's feed-out port is enabled.
	bAnyCurrentTargetFeedoutPortEnabled : BOOL;
	bAllCurrentTargetFeedoutPortsEnabled : BOOL;
	bAnySourceDestinationIndexFeedoutPortEnabled : BOOL;
	
	bAnyDestinationIndexFeedoutPortEnabled : BOOL; // true if any of the feed-out port is enabled from the DestinationIndexFeedoutPortsMapping.
	bDoorInMachineIdle : BOOL;
	bDoorWaitingForFeedOut: BOOL;
	bWaitForDataReadyOrTransferredIn : BOOL;
	bDoorTransferringIn : BOOL;
	bRouteReadyWaitForFeedIn : BOOL;
	bDoorFeedingIn : BOOL;
	bDoorFeedingOut : BOOL;
	bWaitAllTablesReady : BOOL;
	bWaitingForClearRoute: BOOL;
	bRequestNewRouteComplete : BOOL;
	bFindingPath: BOOL;
END_VAR
VAR CONSTANT
END_VAR
VAR_INPUT PERSISTENT
	stDoorTrack									: ST_DoorTrack;
END_VAR
VAR PERSISTENT
	config_bManualControlEnabled				: BOOL;
END_VAR
VAR
	tonEyeBlowoffTimer							: TON;
	tofJambKickOverTimer						: TOF;
	ftrigHasDoor								: F_TRIG;
	stDoorTrackLast								: ST_DoorTrack;
	rtrigPersistentDataChanged					: R_TRIG; // triggered when any of the persistent data (feedout aligned/manual control enabled/disabled changed)	
	rtrigAutofeedOn								: R_TRIG; // rising edge of cmd_bAutofeedOn.
	ftrigAutofeedOn								: F_TRIG; // falling edge of cmd_bAutofeedOn.		
	ftrigAnyChildNotAutofeedOn					: F_TRIG; // falling edge of cmd_bAutofeedOn.
	fbVfdSetupData								: FB_VfdSetupData;
	ftrigRotateComplete							: F_TRIG; // trigger to indicate the rotate sequence is completed.
	ftrigSelfCenterComplete						: F_TRIG; // trigger to indicate the self-center sequence is completed.
	rtrigExternal								: R_TRIG;
	rtrigInternal								: R_TRIG; 
	rtrigTargetFeedoutPortsDisabled				: R_TRIG; // On rising edge, all Target table's feed-out ports were turned off by operator. 
	ftrigTargetFeedoutPortsDisabled				: F_TRIG; // On falling edge, at least 1 of the table's feed-out ports was re-enabled or operator selected a new Target feed-out port. 
	rtrigAllTargetFeedoutPortsDisabled			: R_TRIG; // Door is in-machine. On rising edge, all Target's feedout ports are disabled.
	ftrigAllTargetFeedoutPortsDisabled			: F_TRIG; // Door is in-machine. On falling edge, at least one of Target's feedout ports is enabled.
	ftrigAnyNeighboringTableBusy				: F_TRIG;
	
	rtrigDoorHasNoTarget						: R_TRIG; // On rising edge, door is detected after init but has not Target set (ie, Target = -1). Might be data persistent is corrupted.
	ftrigDoorHasNoTarget						: F_TRIG; // On falling edge, door is assigned new Target by operator.
	
	ftrigSelectedDestinationIndexChanged		: F_TRIG;
	rtrigIncomingDoorHandChanged				: R_TRIG;
	ftrigIncomingDoorHandValid					: F_TRIG;
	rtrigAutoDataReadyChanged					: R_TRIG;
	
	rtrigRequestNewRoute						: R_TRIG; // on rising edge, set cmd_bNewRouteRequested:=true to filter out stDoorTrack.Target so it does not show up in the DestinationIndex popup.
	rtrigDoorDataReady							: R_TRIG; // On rising edge while waiting for feeding out or operator selected new feed-out port, a re-route is request.
	rtrigDoorDataReadyLatched					: R_TRIG;
	ftrigDoorDataReadyLatched					: F_TRIG;
	rtrigAnyFeedoutTableEmptyAndReady			: R_TRIG;
	rtrigAnyTableWithDoorInMachineAndIdle		: R_TRIG;
	
	ftrigDoorTransferredOut						: F_TRIG;
	rtrigTableIndexNotExistInDoorTrackTargetPath		: R_TRIG;
	
	rtrigAnyTableDoorTrackTargetChanged 		: R_TRIG;
	
	rtrigAllCurrentTargetFeedoutPortsEnabled	: R_TRIG;
	ftrigAllCurrentTargetFeedoutPortsEnabled	: F_TRIG;
	
	rtrigAnyCurrentTargetFeedoutPortEnabled 	: R_TRIG;
	ftrigAnyCurrentTargetFeedoutPortEnabled 	: F_TRIG;
	
	rtrigAnyDestinationIndexFeedoutPortEnabled 	: R_TRIG;
	ftrigAnyDestinationIndexFeedoutPortEnabled 	: F_TRIG;
	rtrigDoorDasherReady 						: R_TRIG; // rising edge the door is in-machine and is ready to be transferred out. 
	rtrigRerouteAllTablesWaitingTransferredOut  : R_TRIG;
	bReadyToFeedout								: BOOL;
	rtrigReadyToFeedout							: R_TRIG; 
	ftrigReadyToFeedout							: F_TRIG;
	ftrigAnyDoorDasherBusy						: F_TRIG;
	ftrigNewRouteRequestedFromAllTargetFeedoutPortsDisabled : F_TRIG;
	ftrigNewRouteRequestedFromDoorHasNoTarget 	: F_TRIG;
	
	iFeedFastSpeedRPM		: UINT;
	iFeedSlowSpeedRPM		: UINT;
	iFeedOutSpeedRPM		: UINT;
	iCrossFeedFastSpeedRPM	: UINT;
	iCrossFeedSlowSpeedRPM	: UINT;
	bHasTrackingInfo : BOOL;
	bHasEnabledFeedoutPorts : BOOL;
	bFoundValidRoute : BOOL;
	iSourceDestinationIndexFeedoutPortsCount : UINT;
	bIsHungryModeRouting : BOOL;	
	bAnyTableBusy : BOOL;
	bAllTablesReady : BOOL;	
	bAnyNeighboringTableHasDoorAndDataReadyActive : BOOL;
	bAnyFeedoutTableEmptyAndReady: BOOL;
	bAnyNeighboringTableEmpty: BOOL;
	bAnyTableEmpty : BOOL;
	bAnyTableWithDoorHasNoTarget : BOOL;
	bSelectedDestinationIndexChanged : BOOL;
    tofSelectedDestinationIndexChangedTimer : TOF;
	bAutoDataReadyConfigChanged : BOOL;
	bAutoDataReadyConfigLast : BOOL;
	
	tonAllTablesReady	: TON;
	rtrigAllTablesReady : R_TRIG;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[{IF defined (noHW) OR defined (noHW_UML)}
	runMachine();
{ELSE}
	readInputs();
	runMachine();
	writeOutputs();
{END_IF}]]></ST>
    </Implementation>
    <Folder Name="DoorTracker" Id="{50b69c24-2b46-43e3-b36d-b1d70cbe5b58}" />
    <Folder Name="test" Id="{0084e85f-cd3b-4f14-9299-47ac4407d6d3}" />
    <Folder Name="uml" Id="{b233606c-76f3-41a1-888b-a52054d89419}" />
    <Method Name="addCandidateRouteToDoorTrack" Id="{8c7f58ec-3e89-4dd4-a089-fedc2436e767}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD addCandidateRouteToDoorTrack
VAR_INPUT
	pstCandidateRoute : POINTER TO ST_Route;
	eTargetFeedoutSide : E_FeedoutSideType;	
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pstCandidateRoute = 0 THEN
	RETURN;
END_IF

// Commented out to include duplicate table indices. This is because each duplicate table index can have up to 3 different feed-out sides, each can have
// different OutfeedDoorOrientation. 
//IF NOT isTableIndexExistInCandidateRoutes(pstCandidateRoute^.TargetTableIndex) THEN
	stDoorTrack.CandidateRoutes.CandidateRoutes[stDoorTrack.CandidateRoutes.CandidateRoutesCount] := pstCandidateRoute^;
	stDoorTrack.CandidateRoutes.CandidateRoutes[stDoorTrack.CandidateRoutes.CandidateRoutesCount].TargetFeedoutSide := eTargetFeedoutSide;
	stDoorTrack.CandidateRoutes.CandidateRoutesCount := stDoorTrack.CandidateRoutes.CandidateRoutesCount + 1;
//END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="addSearchResultToDoorTrack" Id="{b8af4a55-7728-432a-9950-e14343bd6d88}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD addSearchResultToDoorTrack
VAR_INPUT
	searchResult : ST_SearchResult;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stDoorTrack.SearchResults.SearchResults[stDoorTrack.SearchResults.SearchResultsCount] := searchResult;
stDoorTrack.SearchResults.SearchResultsCount := stDoorTrack.SearchResults.SearchResultsCount + 1;]]></ST>
      </Implementation>
    </Method>
    <Method Name="addToAllEnabledFeedoutPorts" Id="{554e2fc3-9d5d-4d26-9e50-2f48d062c7b7}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD addToAllEnabledFeedoutPorts
VAR_INPUT
	stFeedoutPort : ST_FeedoutPort;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF stDoorTrack.AllEnabledFeedoutPorts.FeedoutPortsCount >= 0 AND
	stDoorTrack.AllEnabledFeedoutPorts.FeedoutPortsCount < MAX_FEEDOUT_PORTS THEN
	stDoorTrack.AllEnabledFeedoutPorts.FeedoutPorts[stDoorTrack.AllEnabledFeedoutPorts.FeedoutPortsCount] := stFeedoutPort;
	stDoorTrack.AllEnabledFeedoutPorts.FeedoutPortsCount := stDoorTrack.AllEnabledFeedoutPorts.FeedoutPortsCount + 1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="addToRejectedFeedoutPorts" Id="{d5b4eb84-451f-4e54-b76e-7943fbdb78c0}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD addToRejectedFeedoutPorts
VAR_INPUT
	stFeedoutPort : ST_FeedoutPort;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF stDoorTrack.RejectedFeedoutPorts.FeedoutPortsCount >= 0 AND
	stDoorTrack.RejectedFeedoutPorts.FeedoutPortsCount < MAX_FEEDOUT_PORTS THEN
	stDoorTrack.RejectedFeedoutPorts.FeedoutPorts[stDoorTrack.RejectedFeedoutPorts.FeedoutPortsCount] := stFeedoutPort;
	stDoorTrack.RejectedFeedoutPorts.FeedoutPortsCount := stDoorTrack.RejectedFeedoutPorts.FeedoutPortsCount + 1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="addToReroutableFeedoutPorts" Id="{a3b4532f-b9e9-4082-9659-e3431dedea73}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD addToReroutableFeedoutPorts
VAR_INPUT
	stFeedoutPort : ST_FeedoutPort;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF stDoorTrack.ReroutableFeedoutPorts.FeedoutPortsCount >= 0 AND
	stDoorTrack.ReroutableFeedoutPorts.FeedoutPortsCount < MAX_SEARCH_RESULTS THEN
	stDoorTrack.ReroutableFeedoutPorts.FeedoutPorts[stDoorTrack.ReroutableFeedoutPorts.FeedoutPortsCount] := stFeedoutPort;
	stDoorTrack.ReroutableFeedoutPorts.FeedoutPortsCount := stDoorTrack.ReroutableFeedoutPorts.FeedoutPortsCount + 1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="addToTargetFeedoutPorts" Id="{0e331e33-4cbf-43b3-9477-7af6b8f5d636}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD addToTargetFeedoutPorts
VAR_INPUT
	stFeedoutPort : ST_FeedoutPort;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF stDoorTrack.TargetFeedoutPorts.FeedoutPortsCount >= 0 AND
	stDoorTrack.TargetFeedoutPorts.FeedoutPortsCount < MAX_FEEDOUT_PORTS THEN
	stDoorTrack.TargetFeedoutPorts.FeedoutPorts[stDoorTrack.TargetFeedoutPorts.FeedoutPortsCount] := stFeedoutPort;
	stDoorTrack.TargetFeedoutPorts.FeedoutPortsCount := stDoorTrack.TargetFeedoutPorts.FeedoutPortsCount + 1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="allChildrenAutoFeedOn" Id="{daf1b790-c780-47ce-a169-64f8884225d5}">
      <Declaration><![CDATA[METHOD allChildrenAutoFeedOn : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF config_bIsConveyorTable THEN
	allChildrenAutoFeedOn := smC235FeedManager.cmd_bAutoFeedOn AND smDoorDasher.cmd_bAutofeedOn;
ELSE
	allChildrenAutoFeedOn := smC234FeedManager.cmd_bAutoFeedOn AND smDoorDasher.cmd_bAutofeedOn;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="allCurrentTargetFeedoutPortsEnabled" Id="{f2006f4e-4f1d-446d-84a2-0b39c5c3a97e}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD allCurrentTargetFeedoutPortsEnabled : BOOL
VAR_INPUT
END_VAR
VAR
	i : INT;
	j : INT;
	k : INT;
	stFeedoutPort : ST_FeedoutPort;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[allCurrentTargetFeedoutPortsEnabled := TRUE; // default true to only check after Target and DestinationIndex were assigned.
IF 	stDoorTrack.DestinationIndex <> -1 
	AND stDoorTrack.TargetFeedoutPorts.FeedoutPortsCount > 0 
	THEN		
	FOR i:=0 TO stDoorTrack.TargetFeedoutPorts.FeedoutPortsCount - 1 DO
		stFeedoutPort := stDoorTrack.TargetFeedoutPorts.FeedoutPorts[i];
		IF NOT MAIN.mainStateMachine.asmTableManagers[stFeedoutPort.TableIndex].isFeedoutSideEnabled(stFeedoutPort.Side) THEN
			allCurrentTargetFeedoutPortsEnabled := FALSE;
			RETURN;
		END_IF
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="allTablesReady" Id="{2be8f198-4a7b-479e-8439-d0483fd5d5e1}">
      <Declaration><![CDATA[METHOD allTablesReady : BOOL
VAR 
	i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[allTablesReady := TRUE;

FOR i:=0 TO  MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.TablesCount-1 DO
	IF NOT MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].IsFunctionalTable THEN
		CONTINUE;
	END_IF
	
	IF  MAIN.mainStateMachine.asmTableManagers[i].bDoorFeedingIn OR
		MAIN.mainStateMachine.asmTableManagers[i].bDoorFeedingOut OR
		MAIN.mainStateMachine.asmTableManagers[i].bDoorWaitingForFeedOut OR 
		(MAIN.mainStateMachine.asmTableManagers[i].bDoorInMachineIdle AND 
		MAIN.mainStateMachine.asmTableManagers[i].stDoorTrack.Target = i) THEN
		// door is at the Target feed-out port, skip checking.
		CONTINUE;
	END_IF
	
	IF MAIN.mainStateMachine.asmTableManagers[i].status_bBusy THEN
		allTablesReady := FALSE;
		RETURN;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="anyChildAutofeedOn" Id="{c1a08391-408e-45a6-b34d-10e5a7ada541}">
      <Declaration><![CDATA[METHOD anyChildAutofeedOn : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF config_bIsConveyorTable THEN
	anyChildAutofeedOn :=   smC235FeedManager.cmd_bAutoFeedOn OR smDoorDasher.cmd_bAutofeedOn;
ELSE
	anyChildAutofeedOn :=   smC234FeedManager.cmd_bAutoFeedOn OR smDoorDasher.cmd_bAutofeedOn;
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="anyChildBusy" Id="{3aa41549-7841-4207-b717-924a8b446692}">
      <Declaration><![CDATA[METHOD anyChildBusy : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF config_bIsConveyorTable THEN
	anyChildBusy := smC235FeedManager.status_bBusy;
ELSE
	anyChildBusy := smC234FeedManager.status_bBusy;
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="anyChildExternal" Id="{f97a57f3-2094-4d29-9be5-cfab42b82825}">
      <Declaration><![CDATA[METHOD anyChildExternal : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF config_bIsConveyorTable THEN
	anyChildExternal :=   smC235FeedManager.bExternal;
ELSE
	anyChildExternal :=   smC234FeedManager.bExternal;
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="anyCurrentTargetFeedoutPortEnabled" Id="{3c837b95-e21c-4e93-ae8b-779a6f9902c6}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD anyCurrentTargetFeedoutPortEnabled : BOOL
VAR_INPUT
END_VAR
VAR
	i : INT;
	j : INT;
	k : INT;
	stFeedoutPort : ST_FeedoutPort;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[anyCurrentTargetFeedoutPortEnabled := FALSE;
IF 	stDoorTrack.DestinationIndex <> -1 
	AND stDoorTrack.TargetFeedoutPorts.FeedoutPortsCount > 0 
	THEN		
	FOR i:=0 TO stDoorTrack.TargetFeedoutPorts.FeedoutPortsCount - 1 DO
		stFeedoutPort := stDoorTrack.TargetFeedoutPorts.FeedoutPorts[i];
		IF MAIN.mainStateMachine.asmTableManagers[stFeedoutPort.TableIndex].isFeedoutSideEnabled(stFeedoutPort.Side) THEN
			anyCurrentTargetFeedoutPortEnabled := TRUE;
			RETURN;
		END_IF
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="anyDestinationIndexFeedoutPortEnabled" Id="{12b3bad6-2022-4e0e-a42d-a3610a5beab4}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD anyDestinationIndexFeedoutPortEnabled : BOOL
VAR_INPUT
END_VAR
VAR
	i : INT;
	j : INT;
	k : INT;
	stFeedoutPort : ST_FeedoutPort;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[anyDestinationIndexFeedoutPortEnabled := TRUE; // default true to only check after Target and DestinationIndex were assigned.
IF 	stDoorTrack.DestinationIndex <> -1 
	THEN
	// the table has a Target table, now check if any of the feed-out port is enabled from the DestinationIndexFeedoutPortsMapping.
	anyDestinationIndexFeedoutPortEnabled := FALSE;
	i := stDoorTrack.Source;
	IF MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappingsCount > 0 THEN
		FOR j:=0 TO MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappingsCount - 1 DO
			IF MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappings[j].DestinationIndex = stDoorTrack.DestinationIndex THEN
				IF MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappings[j].FeedoutPortsCount > 0 THEN
					FOR k:=0 TO MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappings[j].FeedoutPortsCount - 1 DO
						stFeedoutPort := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappings[j].FeedoutPorts[k];
						IF MAIN.mainStateMachine.asmTableManagers[stFeedoutPort.TableIndex].isFeedoutSideEnabled(stFeedoutPort.Side) THEN
							anyDestinationIndexFeedoutPortEnabled := TRUE;
							RETURN;
						END_IF
					END_FOR
				END_IF
				EXIT;
			END_IF
		END_FOR
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="anyDoorDasherBusy" Id="{0bafcac9-6d4d-4eb2-9d39-51241300d7cb}">
      <Declaration><![CDATA[METHOD anyDoorDasherBusy : bool
VAR 
	i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[anyDoorDasherBusy := FALSE;	
FOR i:=0 TO MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.TablesCount-1 DO
	IF NOT MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].IsFunctionalTable THEN
		CONTINUE;
	END_IF
	IF MAIN.mainStateMachine.asmTableManagers[i].smDoorDasher.status_bBusy THEN
		anyDoorDasherBusy := TRUE;
		RETURN;		
	END_IF
END_FOR	]]></ST>
      </Implementation>
