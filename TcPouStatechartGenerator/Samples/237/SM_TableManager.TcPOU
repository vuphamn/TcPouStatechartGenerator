    <Method Name="writeOutputs" Id="{88c29df7-8dd2-4bc4-abbb-3520d3674425}">
      <Declaration><![CDATA[METHOD writeOutputs
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//smC234FeedManager
IF (config_pstHcTransferTableHardware <> 0) THEN
	config_pstHcTransferTableHardware^.do_DoorDataAck 			:= smC234FeedManager.do_DoorDataAck			;
	config_pstHcTransferTableHardware^.do_OkToFeedInSideA		:= smC234FeedManager.do_OkToFeedInSideA		;
	config_pstHcTransferTableHardware^.do_ReadyToFeedoutSideA	:= smC234FeedManager.do_ReadyToFeedoutSideA	;
	config_pstHcTransferTableHardware^.do_ReadyToFeedoutSideB	:= smC234FeedManager.do_ReadyToFeedoutSideB	;
	config_pstHcTransferTableHardware^.do_ReadyToFeedoutSideC	:= smC234FeedManager.do_ReadyToFeedoutSideC	;
	config_pstHcTransferTableHardware^.do_ReadyToFeedoutSideD	:= smC234FeedManager.do_ReadyToFeedoutSideD	;
// smC235FeedManager - has no outputs
END_IF
]]></ST>
      </Implementation>
    </Method>
