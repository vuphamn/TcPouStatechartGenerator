(ID := 23, Name := 'ChoiceElement2', StateType := _UML_SC_StateTypes.FastState, StartOfTransitionIndex := 123, OutGoingTransitionsCount := 10, RegionCount := 0, RegionStartIndex := 0, RegionEndIndex := 0, CompletionTransitionID := 0, MaxDoCycles := 0, HasEntryAction := False, HasDoAction := False, HasExitAction := False) , 
