    <Method Name="anyNeighboringTableEmptyAndNotInPath" Id="{09776181-5163-48bc-9ad2-53d2f67d6d60}">
      <Declaration><![CDATA[METHOD anyNeighboringTableEmptyAndNotInPath : bool
