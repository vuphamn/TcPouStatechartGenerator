    <Method Name="existTableIndexInDoorTrackTargetPath" Id="{07bb07fc-e9b4-4b09-be22-83530d508919}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD existTableIndexInDoorTrackTargetPath : BOOL
VAR
	i : INT;
	pstPath : POINTER TO ST_PathInfo;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[existTableIndexInDoorTrackTargetPath := FALSE;

pstPath := ADR(stDoorTrack.TargetPath);

FOR i:= 0 TO pstPath^.PathCount - 1 DO
	IF pstPath^.Path[i].TableIndex = config_iTableArrayIndex THEN
		existTableIndexInDoorTrackTargetPath := TRUE;
		EXIT;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="findAllCandidateRoutes" Id="{777404d9-c9f9-4229-aa62-02f204a97067}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD findAllCandidateRoutes
VAR_INPUT
END_VAR
VAR
	i : INT;
	pstRoute : POINTER TO ST_Route; 
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF cmd_bRequestNewRoute THEN
	FOR i:=0 TO stDoorTrack.AllEnabledFeedoutPorts.FeedoutPortsCount - 1 DO
		pstRoute := findCandidateRoute(config_iTableArrayIndex, stDoorTrack.AllEnabledFeedoutPorts.FeedoutPorts[i].TableIndex);	
		addCandidateRouteToDoorTrack(pstRoute, stDoorTrack.AllEnabledFeedoutPorts.FeedoutPorts[i].Side);
	END_FOR
ELSE
	FOR i:=0 TO stDoorTrack.TargetFeedoutPorts.FeedoutPortsCount - 1 DO
		pstRoute := findCandidateRoute(config_iTableArrayIndex, stDoorTrack.TargetFeedoutPorts.FeedoutPorts[i].TableIndex);	
		addCandidateRouteToDoorTrack(pstRoute, stDoorTrack.TargetFeedoutPorts.FeedoutPorts[i].Side);
	END_FOR
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="findAllEnabledFeedoutPorts" Id="{02d3a3c2-6e9d-4d52-a9fc-fd4c54c43222}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[// find all the enabled feed-out ports that are mapped to the selected DestinationIndex.
// The route planner will select the shortest path from this list in later stage.
METHOD findAllEnabledFeedoutPorts : BOOL
VAR_INPUT
END_VAR
VAR
	i : INT;
	j : INT;
	k : INT;
	stFeedoutPort : ST_FeedoutPort;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[findAllEnabledFeedoutPorts := FALSE;
IF  stDoorTrack.DestinationIndex <> -1 AND
	stDoorTrack.Source <> -1
	THEN
	
	IF cmd_bRequestNewRoute THEN
		FOR i:=0 TO MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.FeedoutPortsConfig.FeedoutPortsCount - 1 DO
			stFeedoutPort := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.FeedoutPortsConfig.FeedoutPorts[i];
			IF stDoorTrack.Target <> -1 AND stDoorTrack.Target = stFeedoutPort.TableIndex AND stDoorTrack.TargetFeedoutSide = stFeedoutPort.Side THEN
				CONTINUE;
			END_IF
			IF MAIN.mainStateMachine.asmTableManagers[stFeedoutPort.TableIndex].isFeedoutSideEnabled(stFeedoutPort.Side) THEN
				addToAllEnabledFeedoutPorts(stFeedoutPort);
			END_IF
		END_FOR
		findAllEnabledFeedoutPorts := stDoorTrack.AllEnabledFeedoutPorts.FeedoutPortsCount > 0;
	ELSIF cmd_bNewTargetFeedoutPortSelected THEN
		IF MAIN.mainStateMachine.asmTableManagers[cmd_stNewTargetFeedoutPort.TableIndex].isFeedoutSideEnabled(cmd_stNewTargetFeedoutPort.Side) THEN
			addToTargetFeedoutPorts(cmd_stNewTargetFeedoutPort);
		END_IF
		findAllEnabledFeedoutPorts := stDoorTrack.TargetFeedoutPorts.FeedoutPortsCount > 0;
	ELSIF NOT isCurrentTargetFeedoutPortExistInDestinationIndexFeedoutPorts() AND isCurrentTargetFeedoutPortEnabled() THEN
		// the current Target was a re-route, its Target's feed-out side was disabled and then re-enabled.
		stFeedoutPort.TableIndex := stDoorTrack.Target;
		stFeedoutPort.Side := stDoorTrack.TargetFeedoutSide;
		addToTargetFeedoutPorts(stFeedoutPort);
		findAllEnabledFeedoutPorts := stDoorTrack.TargetFeedoutPorts.FeedoutPortsCount > 0; 
	ELSE
		// new door wants to come in or all of Target's feed-out ports were disabled.
		i := stDoorTrack.Source;
		IF MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappingsCount > 0 THEN
			FOR j:=0 TO MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappingsCount - 1 DO
				IF MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappings[j].DestinationIndex = stDoorTrack.DestinationIndex THEN
					IF MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappings[j].FeedoutPortsCount > 0 THEN
						FOR k:=0 TO MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappings[j].FeedoutPortsCount - 1 DO
							stFeedoutPort := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[i].DestinationsFeedoutPortsMappingConfig.DestinationsFeedoutPortsMappings[j].FeedoutPorts[k];
							IF cmd_bNewRouteRequested AND stDoorTrackLast.Target = stFeedoutPort.TableIndex THEN
								CONTINUE;
							END_IF
							IF MAIN.mainStateMachine.asmTableManagers[stFeedoutPort.TableIndex].isFeedoutSideEnabled(stFeedoutPort.Side) THEN
								addToTargetFeedoutPorts(stFeedoutPort);
							END_IF
						END_FOR
					END_IF
					EXIT;
				END_IF
			END_FOR
		END_IF
		findAllEnabledFeedoutPorts := stDoorTrack.TargetFeedoutPorts.FeedoutPortsCount > 0;
	END_IF
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="findCandidateRoute" Id="{5c12861c-70f7-41d8-b3df-46a2a0c2735f}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD findCandidateRoute : POINTER TO ST_Route
VAR_INPUT
	source : INT;
	target : INT;
END_VAR
VAR
	i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[findCandidateRoute := 0;
FOR i:=0 TO MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.RoutingTable.RoutesCount - 1 DO
	IF MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.RoutingTable.Routes[i].SourceTableIndex = source AND
		MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.RoutingTable.Routes[i].TargetTableIndex = target AND
		MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.RoutingTable.Routes[i].PathsInfoCount > 0 THEN
		findCandidateRoute := ADR(MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.RoutingTable.Routes[i]);
		RETURN;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="findSearchResults" Id="{bd51969a-c2df-4d6f-8ba6-d74e19005115}" FolderPath="DoorTracker\">
      <Declaration><![CDATA[METHOD findSearchResults
VAR_INPUT
END_VAR
VAR
	i : INT;
	j : INT;
	searchResult : ST_SearchResult;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i:=0 TO stDoorTrack.CandidateRoutes.CandidateRoutesCount - 1 DO
	FOR j:=0 TO stDoorTrack.CandidateRoutes.CandidateRoutes[i].PathsInfoCount - 1 DO
		searchResult := stSearchResultDefault;
		searchResult.PathIno := stDoorTrack.CandidateRoutes.CandidateRoutes[i].PathsInfo[j];
		searchResult.TargetFeedoutSide := stDoorTrack.CandidateRoutes.CandidateRoutes[i].TargetFeedoutSide;
		addSearchResultToDoorTrack(searchResult);
	END_FOR
END_FOR


]]></ST>
      </Implementation>
    </Method>
    <Method Name="getFeedMgrStateDescription" Id="{dd4f8096-e826-44c5-a4b8-964b0c5c1cdc}">
      <Declaration><![CDATA[METHOD getFeedMgrStateDescription : STRING

]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF config_bIsConveyorTable THEN
	getFeedMgrStateDescription := smC235FeedManager.getStateDescription();
ELSE
	getFeedMgrStateDescription := smC234FeedManager.getStateDescription();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="getSourceAndDestinationIndexFeedoutPortsCount" Id="{07e1c1da-b6a8-43fe-9ff3-344650038134}">
      <Declaration><![CDATA[METHOD getSourceAndDestinationIndexFeedoutPortsCount : UINT
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF stDoorTrack.Source < 0 OR stDoorTrack.Source >= MAX_TABLES_COUNT OR
	stDoorTrack.DestinationIndex < 0 OR stDoorTrack.DestinationIndex >= MAX_FEEDOUT_PORTS THEN
	getSourceAndDestinationIndexFeedoutPortsCount := 0;
	RETURN;
END_IF
getSourceAndDestinationIndexFeedoutPortsCount := 
	MAIN.mainStateMachine.smCtrlInterface.
		config_stTransferTableConfig.PrimaryTable.
		Tables[stDoorTrack.Source].DestinationsFeedoutPortsMappingConfig.
		DestinationsFeedoutPortsMappings[stDoorTrack.DestinationIndex].FeedoutPortsCount;]]></ST>
      </Implementation>
    </Method>
    <Method Name="getStateDescription" Id="{ae6ca58b-2396-47fd-8ebe-ee8f2a4fd647}">
      <Declaration><![CDATA[METHOD getStateDescription : STRING

]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE machineState OF

	TABLEMANAGER_DISABLED:
		getStateDescription := 'Disabled';
			
	TABLEMANAGER_ENABLING:
		getStateDescription := 'Enabling';
			
	TABLEMANAGER_INLINE_JOGGING:
		getStateDescription := 'Inline Jogging';
			
	TABLEMANAGER_CROSS_JOGGING:
		getStateDescription := 'Cross Jogging';
		
	TABLEMANAGER_TO_FENCE_JOGGING:
		getStateDescription := 'To-Fence Jogging';
	
	TABLEMANAGER_ROTATE:
		getStateDescription := 'Rotating';
			
	TABLEMANAGER_SELF_CENTER:
		getStateDescription := 'Centering';
			
	TABLEMANAGER_AUTOFEED_OFF:
		getStateDescription := 'Autofeed Off';
			
	TABLEMANAGER_AUTOFEED_ON:
		getStateDescription := 'Autofeed On';
		
	TABLEMANAGER_DOOR_TRACKER_START:
		getStateDescription := 'Door Track Starting';
			
	TABLEMANAGER_DOOR_TRACKER_WAIT_FOR_DATA_READY_OR_TRANSFERRED_IN:
		IF config_bCanFeedinFromSideA THEN
			getStateDescription := 'Waiting for Door Data Ready or Transferred In';
		ELSE
			getStateDescription := 'Waiting for Door Transferred In';
		END_IF
		
	TABLEMANAGER_DOOR_TRACKER_TRANSFERRING_IN:
		getStateDescription := 'Transferring In';
			
	TABLEMANAGER_DOOR_TRACKER_ROUTE_READY_WAIT_FOR_FEED_IN:
		getStateDescription := 'Route Ready - Waiting for Feed In';
			
	TABLEMANAGER_DOOR_TRACKER_DOOR_FEEDING_IN:
		getStateDescription := 'Door Feeding In';
		
	TABLEMANAGER_DOOR_TRACKER_DOOR_IN_MACHINE_IDLE:
		getStateDescription := 'Door in Machine - Waiting for Transferred Out';

	TABLEMANAGER_DOOR_TRACKER_WAIT_FOR_FEED_OUT:
		IF cmd_bDoorDataReadyLatched THEN
			getStateDescription := 'Waiting for Feed Out. Data Ready Latch Active';
		ELSE
			getStateDescription := 'Waiting for Feed Out';
		END_IF
		
			
	TABLEMANAGER_DOOR_TRACKER_DOOR_FEEDING_OUT:
		getStateDescription := 'Feeding Out';
		
	TABLEMANAGER_DOOR_TRACKER_WAIT_ALL_TABLES_READY:
		getStateDescription := 'Waiting for All Tables Ready';
		
	TABLEMANAGER_DOOR_TRACKER_TRANSFERRING_OUT:
		getStateDescription := 'Transferring Out';
			
	TABLEMANAGER_DOOR_TRACKER_COMPLETE:
		getStateDescription := 'Completed';			
		
	TABLEMANAGER_DOOR_TRACKER_FINDPATH_INIT:
		getStateDescription := 'Finding Path Init';
	
	TABLEMANAGER_DOOR_TRACKER_FINDPATH_RESET:
		getStateDescription := 'Resetting Door Tracker';
		
	TABLEMANAGER_DOOR_TRACKER_FINDPATH_FIND_ENABLED_FEEDOUT_PORTS:
		getStateDescription := 'Finding Enabled Feedout Ports';
		
	TABLEMANAGER_DOOR_TRACKER_FINDPATH_WAITING_FOR_CLEAR_ROUTE:
		getStateDescription := 'Waiting for Clear Route';
	
	TABLEMANAGER_DOOR_TRACKER_FINDPATH_FIND_CANDIDATE_ROUTES:
		getStateDescription := 'Finding Candidate Routes';
		
	TABLEMANAGER_DOOR_TRACKER_FINDPATH_FIND_SEARCH_RESULTS:
		getStateDescription := 'Finding Search Results';
		
	TABLEMANAGER_DOOR_TRACKER_FINDPATH_COMPUTE_FINAL_SCORE:
		getStateDescription := 'Computing Final Score';
		
	TABLEMANAGER_DOOR_TRACKER_FINDPATH_REQUEST_NEW_ROUTE_COMPLETE:
		getStateDescription := 'Request New Route Complete';
		
	TABLEMANAGER_DOOR_TRACKER_FINDPATH_COMPLETE:
		getStateDescription := 'Finding Path Complete';
	
	TABLEMANAGER_DOOR_TRACKER_ALL_TARGET_FEEDOUT_PORTS_DISABLED:
		getStateDescription := 'All of Target Feed-out Ports Disabled';	

	TABLEMANAGER_DOOR_TRACKER_DOOR_HAS_NO_TARGET:
		getStateDescription := 'Door Has No Target';
		
	TABLEMANAGER_ERROR:
		getStateDescription := 'Error';
		
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="getTargetNodeDirection" Id="{03a0f889-dd12-4ae3-9914-2ae956fdcf7d}">
      <Declaration><![CDATA[METHOD getTargetNodeDirection : E_Direction
VAR 
	i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[getTargetNodeDirection := E_Direction.None;
IF NOT bHasDoor THEN
	RETURN;
END_IF

FOR i:= 0 TO stDoorTrack.TargetPath.PathCount - 1 DO
	// do we have the source from TargetPath?
	IF stDoorTrack.TargetPath.Path[i].TableIndex = config_iTableArrayIndex THEN
		getTargetNodeDirection := stDoorTrack.TargetPath.Path[i].Direction;
		RETURN;
	END_IF
END_FOR
	]]></ST>
      </Implementation>
    </Method>
