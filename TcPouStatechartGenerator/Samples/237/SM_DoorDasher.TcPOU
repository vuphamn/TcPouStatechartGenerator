    <Method Name="stop" Id="{f8663887-c05e-4c8e-b2c2-a08da262ddab}">
      <Declaration><![CDATA[METHOD stop
VAR 
	i : INT;
	
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF cmd_iSource <> cmd_iTarget THEN
	FOR i:=iSourcePathIndex TO iTargetPathIndex DO
		bStoppingSource := FALSE;
		bStoppingTarget := FALSE;
		iStopTableIndex := stTargetPath.Path[i].TableIndex;
		IF iStopTableIndex = cmd_iSource THEN
			// only stop the source if any of the following conditions is true...
			
			IF iSourceTrailingNeighborIndex = -1 THEN // no trailing neighbor
				bStoppingSource := TRUE;
			ELSE
				IF  // has trailing neighbor but it has no door 
					NOT MAIN.mainStateMachine.asmTableManagers[iSourceTrailingNeighborIndex].bHasDoor OR
					
					// has trailing neighbor but it has no door
					NOT (MAIN.mainStateMachine.asmTableManagers[iSourceTrailingNeighborIndex].smDoorDasher.bCrossTransferSeqRunning OR 
						MAIN.mainStateMachine.asmTableManagers[iSourceTrailingNeighborIndex].smDoorDasher.bInlineTransferSeqRunning) OR
						
					// trailing neighbor is transferring but not in the same direction as source's.
					stCurrentTargetNode.Direction <> eSourceTrailingNeighborNodeDirection
					THEN
					bStoppingSource := TRUE;
				END_IF
			END_IF
		ELSIF iStopTableIndex = cmd_iTarget THEN
			// always stop the target.
			bStoppingTarget := TRUE;
		END_IF
		IF bStoppingSource THEN
			MAIN.mainStateMachine.asmTableManagers[cmd_iSource].stop();			
		END_IF
		IF bStoppingTarget THEN
			MAIN.mainStateMachine.asmTableManagers[cmd_iTarget].stop();			
		END_IF
	END_FOR
END_IF
]]></ST>
      </Implementation>
    </Method>
