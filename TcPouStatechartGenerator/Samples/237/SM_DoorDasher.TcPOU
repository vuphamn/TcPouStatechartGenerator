    <Method Name="feedinDoorAtTarget" Id="{2697d187-c404-48b5-ade9-6f7007186497}">
      <Declaration><![CDATA[METHOD feedinDoorAtTarget
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bIsConveyorAtTarget THEN
	MAIN.mainStateMachine.asmTableManagers[cmd_iTarget].smC234FeedManager.cmd_bFeedIn := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="findSourceLeadingNeighborTableIndex" Id="{3c7cab24-48bf-4c0c-80fb-90b5cf81a0f3}">
      <Declaration><![CDATA[METHOD findSourceLeadingNeighborTableIndex : INT
VAR
	iSourceLeadingNeighborTableIndex : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[findSourceLeadingNeighborTableIndex := -1;
IF bMovingFwd THEN
	IF cmd_bCrossTransfer THEN
		iSourceLeadingNeighborTableIndex := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[cmd_iSource].NeighborNorthIndex;
	ELSIF cmd_bInlineTransfer THEN
		iSourceLeadingNeighborTableIndex := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[cmd_iSource].NeighborEastIndex;
	END_IF
ELSE
	IF cmd_bCrossTransfer THEN
		iSourceLeadingNeighborTableIndex := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[cmd_iSource].NeighborSouthIndex;
	ELSIF cmd_bInlineTransfer THEN
		iSourceLeadingNeighborTableIndex := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[cmd_iSource].NeighborWestIndex;
	END_IF
END_IF
findSourceLeadingNeighborTableIndex := iSourceLeadingNeighborTableIndex;]]></ST>
      </Implementation>
    </Method>
    <Method Name="findSourceTrailingNeighborTableIndex" Id="{dec4e9b5-762f-4a71-9c04-6a90498c1d18}">
      <Declaration><![CDATA[METHOD findSourceTrailingNeighborTableIndex : INT
VAR
	iSourceTrailingNeighborTableIndex : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[findSourceTrailingNeighborTableIndex := -1;
IF bMovingFwd THEN
	IF cmd_bCrossTransfer THEN
		iSourceTrailingNeighborTableIndex := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[cmd_iSource].NeighborSouthIndex;
	ELSIF cmd_bInlineTransfer THEN
		iSourceTrailingNeighborTableIndex := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[cmd_iSource].NeighborWestIndex;
	END_IF
ELSE
	IF cmd_bCrossTransfer THEN
		iSourceTrailingNeighborTableIndex := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[cmd_iSource].NeighborNorthIndex;
	ELSIF cmd_bInlineTransfer THEN
		iSourceTrailingNeighborTableIndex := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[cmd_iSource].NeighborEastIndex;
	END_IF
END_IF
findSourceTrailingNeighborTableIndex := iSourceTrailingNeighborTableIndex;]]></ST>
      </Implementation>
    </Method>
    <Method Name="findTargetPathIndex" Id="{666dcba6-c038-44f2-a7f0-7e385b1cf250}">
      <Declaration><![CDATA[METHOD findTargetPathIndex : INT
VAR_INPUT
	iSourceOrTargetIndex : INT;
END_VAR
VAR
	i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[findTargetPathIndex := -1;
FOR i:= 0 TO pstDoorTrack^.TargetPath.PathCount - 1 DO
	IF pstDoorTrack^.TargetPath.Path[i].TableIndex = iSourceOrTargetIndex THEN
		findTargetPathIndex := i;
		RETURN;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="getStateDescription" Id="{d62e3e46-7fa6-442f-af47-0f43e46466c3}">
      <Declaration><![CDATA[METHOD getStateDescription : STRING

]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE (machineState) OF

	DOOR_DASHER_DISABLED:
		getStateDescription := 'Disabled';
		
	DOOR_DASHER_ENABLING:
		getStateDescription := 'Enabling';
		
	DOOR_DASHER_AUTOFEED_OFF:
		getStateDescription := 'Autofeed Off';
		
	DOOR_DASHER_AUTOFEED_ON:
		getStateDescription := 'Autofeed On';
		
	DOOR_DASHER_START:
		getStateDescription := 'Starting';
			
	DOOR_DASHER_WAIT_FOR_SOURCE_TABLE_READY:
		getStateDescription := 'Wait for Source Ready';
			
	DOOR_DASHER_WAIT_FOR_SOURCE_AND_TARGET_EXTERNAL:
		getStateDescription := 'Waiting for Source and Target External';
			
	DOOR_DASHER_CENTER_DOOR_PRE_ROTATE:
		getStateDescription := 'Center Door Pre-Rotate';
			
	DOOR_DASHER_ROTATE_DOOR:
		getStateDescription := 'Rotate Door';
			
	DOOR_DASHER_ALIGN_DOOR:
		getStateDescription := 'Align Door';
			
	
	DOOR_DASHER_READY_TO_TRANSFER:
		getStateDescription := 'Ready to Transfer';
			
		
	DOOR_DASHER_CROSS_TRANSFER_START:
		getStateDescription := 'Cross Transfer Starting';
	
	DOOR_DASHER_CROSS_TRANSFER_ACTIVATE_CROSS_CYLS:
		getStateDescription := 'Activating Source and Target Cross Cylinders';


	DOOR_DASHER_CROSS_TRANSFER_START_SOURCE_MOTOR:
		getStateDescription := 'Starting Source Motor';

	DOOR_DASHER_CROSS_TRANSFER_FIND_SOURCE_EYE_RISING_EDGE:
		getStateDescription := 'Finding Source Eye Rising Edge';

	DOOR_DASHER_CROSS_TRANSFER_STOP_SOURCE_MOTOR:
		getStateDescription := 'Stopping Source Motor';
		
	DOOR_DASHER_CROSS_TRANSFER_WAIT_FOR_ALL_DOORDASHERS_READY:
		getStateDescription := 'Waiting for All Door Dashers Ready';
		
	DOOR_DASHER_CROSS_TRANSFER_START_MOTORS:
		getStateDescription := 'Starting Motors';
	
	DOOR_DASHER_CROSS_TRANSFER_FIND_TARGET_EYE_RISING_EDGE_PRE:
		getStateDescription := 'Finding Target Eye Rising Edge - Pre';
			
	DOOR_DASHER_CROSS_TRANSFER_FIND_TARGET_EYE_RISING_EDGE_POST:
		getStateDescription := 'Finding (Conveyor) Target Eye Rising Edge - POST';
	
	DOOR_DASHER_CROSS_TRANSFER_FIND_RISING_OR_FALLING_EDGE_OF_TARGET_EYE:
		getStateDescription := 'Finding (Non-Conveyor) Target Eye';
	
	DOOR_DASHER_CROSS_TRANSFER_STOP_MOTORS:
		getStateDescription := 'Stopping Motors';
		
	DOOR_DASHER_CROSS_TRANSFER_RESTART_TARGET_MOTOR:
		getStateDescription := 'Restarting Target and Reverse Direction for Wide Door';
	
	DOOR_DASHER_CROSS_TRANSFER_FIND_RISING_EDGE_OF_TARGET_FENCE_EYE:
		getStateDescription := 'Finding Rising Edge of Target-Fence Eye';
		
	DOOR_DASHER_CROSS_TRANSFER_STOP_MOTORS_ON_TARGET_FENCE_EYE:
		getStateDescription := 'Stopping Motors on Target Fence Eye';
		
	DOOR_DASHER_CROSS_TRANSFER_DEACTIVATE_CROSS_CYLS:
		getStateDescription := 'Deactivating Cross Cylinders';
		
	DOOR_DASHER_CROSS_TRANSFER_ALIGN_DOOR_AT_TARGET:
		getStateDescription := 'Aligning Door at Target';
		
	DOOR_DASHER_CROSS_TRANSFER_WAIT_FOR_ALIGN_DOOR_AT_TARGET_COMPLETE:
		getStateDescription := 'Wait for Align Door at Target Complete';
		
	DOOR_DASHER_CROSS_TRANSFER_WAIT_FOR_ALL_DOORDASHERS_COMPLETE:
		getStateDescription := 'Wait for All Door Dashers Complete';
	
	DOOR_DASHER_CROSS_TRANSFER_COMPLETE:
		getStateDescription := 'Cross Transfer Complete';
		
	DOOR_DASHER_SET_SOURCE_AND_TARGET_INTERNAL:
		getStateDescription := 'Setting Source and Target in Internal State';
	
	DOOR_DASHER_COMPLETE:
		getStateDescription := 'Door Dasher Complete';
	
	DOOR_DASHER_INLINE_TRANSFER_START:
		getStateDescription := 'Inline Transfer Starting';
	
	DOOR_DASHER_INLINE_TRANSFER_DEACTIVATE_CROSS_CYLS:
		getStateDescription := 'Deactivating Source and Target Cross Cylinders';
		
	DOOR_DASHER_INLINE_TRANSFER_START_SOURCE_MOTOR:
		getStateDescription := 'Starting Source Motor';
		
	DOOR_DASHER_INLINE_TRANSFER_FIND_SOURCE_EYE_RISING_EDGE:
		getStateDescription := 'Finding Source Eye Rising Edge';
		
	DOOR_DASHER_INLINE_TRANSFER_STOP_SOURCE_MOTOR:
		getStateDescription := 'Stopping Source Motor';
		
	DOOR_DASHER_INLINE_TRANSFER_WAIT_FOR_ALL_DOORDASHERS_READY:
		getStateDescription := 'Waiting for All Door Dashers Ready';
		
	DOOR_DASHER_INLINE_TRANSFER_START_MOTORS:
		getStateDescription := 'Starting Motors';
		
	DOOR_DASHER_INLINE_TRANSFER_FIND_TARGET_EYE_RISING_EDGE:
		getStateDescription := 'Finding Target Eye Rising Edge';
		
	DOOR_DASHER_INLINE_TRANSFER_FIND_TARGET_EYE_FALLING_EDGE:
		getStateDescription := 'Finding Target Eye Falling Edge';
		
	DOOR_DASHER_INLINE_TRANSFER_STOP_MOTORS:
		getStateDescription := 'Stopping Motors';
		
	DOOR_DASHER_INLINE_TRANSFER_FEEDIN_DOOR_AT_TARGET:
		getStateDescription := 'Feedin Door at Target';
		
	DOOR_DASHER_INLINE_TRANSFER_WAIT_FOR_FEEDIN_DOOR_AT_TARGET_COMPLETE:
		getStateDescription := 'Wait for Feedin Door at Target Complete';
		
	DOOR_DASHER_INLINE_TRANSFER_WAIT_FOR_ALL_DOORDASHERS_COMPLETE:
		getStateDescription := 'Wait for All Door Dashers Complete';
		
	DOOR_DASHER_INLINE_TRANSFER_COMPLETE:
		getStateDescription := 'Inline Transfer Complete';
		
	DOOR_DASHER_ERROR:
		getStateDescription := 'Error';
		
END_CASE

IF status_bBusy THEN
	fbTaskMaster.fbFormatString(sFormat:='[%s->%s] ', 
		arg1:= F_STRINGEX(sSource),
		arg2:= F_STRINGEX(sTarget));
	getStateDescription := concat(fbTaskMaster.fbFormatString.sOut, getStateDescription);
END_IF

// Call this last to pick up any unassigned descriptions
SUPER^.getStateDescription();]]></ST>
      </Implementation>
    </Method>
    <Method Name="getTableName" Id="{1a362300-1194-41b5-809c-e76c2125118f}">
      <Declaration><![CDATA[METHOD getTableName : STRING
VAR_INPUT
	tableIndex : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF tableIndex >= 0 AND tableIndex < MAX_TABLES_COUNT THEN
	getTableName := MAIN.mainStateMachine.smCtrlInterface.config_stTransferTableConfig.PrimaryTable.Tables[tableIndex].Name;
ELSE
	getTableName := '---';
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="goFast" Id="{43e26be5-9790-4965-8177-59396cfd0591}">
      <Declaration><![CDATA[METHOD goFast
VAR 
	i : INT;
	tableIndex : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i:=iSourcePathIndex TO iTargetPathIndex DO
	tableIndex := stTargetPath.Path[i].TableIndex;
	MAIN.mainStateMachine.asmTableManagers[tableIndex].psmHcFeedMotor^.cmd_iSpeedRPM := MAIN.mainStateMachine.asmTableManagers[tableIndex].iFeedFastSpeedRPM;
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="goFwd" Id="{09b2cea7-6ab5-4ed3-adc1-08d18652be8f}">
      <Declaration><![CDATA[METHOD goFwd
VAR 
	i : INT;
	tableIndex : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i:=iSourcePathIndex TO iTargetPathIndex DO
	tableIndex := stTargetPath.Path[i].TableIndex;
	MAIN.mainStateMachine.asmTableManagers[tableIndex].goFwd();
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="goRev" Id="{53396d2f-a5a3-4c1c-b252-c98352c1f119}">
