(ID := 7, Name := 'DOOR_DASHER_CROSS_TRANSFER_START_SOURCE_MOTOR', StateType := _UML_SC_StateTypes.SlowState, StartOfTransitionIndex := 18, OutGoingTransitionsCount := 4, RegionCount := 0, RegionStartIndex := 0, RegionEndIndex := 0, CompletionTransitionID := 0, MaxDoCycles := 32766, HasEntryAction := True, HasDoAction := True, HasExitAction := True) , 
(ID := 8, Name := 'DOOR_DASHER_CROSS_TRANSFER_RESTART_TARGET_MOTOR', StateType := _UML_SC_StateTypes.SlowState, StartOfTransitionIndex := 22, OutGoingTransitionsCount := 4, RegionCount := 0, RegionStartIndex := 0, RegionEndIndex := 0, CompletionTransitionID := 0, MaxDoCycles := 32766, HasEntryAction := True, HasDoAction := True, HasExitAction := True) , 
(ID := 9, Name := 'DOOR_DASHER_INLINE_TRANSFER_FEEDIN_DOOR_AT_TARGET', StateType := _UML_SC_StateTypes.SlowState, StartOfTransitionIndex := 26, OutGoingTransitionsCount := 4, RegionCount := 0, RegionStartIndex := 0, RegionEndIndex := 0, CompletionTransitionID := 0, MaxDoCycles := 32766, HasEntryAction := True, HasDoAction := True, HasExitAction := True) , 
(ID := 10, Name := 'StartState1', StateType := _UML_SC_StateTypes.FastState, StartOfTransitionIndex := 30, OutGoingTransitionsCount := 1, RegionCount := 0, RegionStartIndex := 0, RegionEndIndex := 0, CompletionTransitionID := 0, MaxDoCycles := 32766, HasEntryAction := False, HasDoAction := False, HasExitAction := False) , 
(ID := 11, Name := 'EndState1', StateType := _UML_SC_StateTypes.FastState, StartOfTransitionIndex := 31, OutGoingTransitionsCount := 1, RegionCount := 0, RegionStartIndex := 0, RegionEndIndex := 0, CompletionTransitionID := 0, MaxDoCycles := 32766, HasEntryAction := False, HasDoAction := False, HasExitAction := False) , 
(ID := 12, Name := 'DOOR_DASHER_AUTOFEED_OFF', StateType := _UML_SC_StateTypes.SlowState, StartOfTransitionIndex := 32, OutGoingTransitionsCount := 3, RegionCount := 0, RegionStartIndex := 0, RegionEndIndex := 0, CompletionTransitionID := 0, MaxDoCycles := 32766, HasEntryAction := True, HasDoAction := True, HasExitAction := True) , 
(ID := 13, Name := 'DOOR_DASHER_CROSS_TRANSFER_DEACTIVATE_CROSS_CYLS', StateType := _UML_SC_StateTypes.SlowState, StartOfTransitionIndex := 35, OutGoingTransitionsCount := 4, RegionCount := 0, RegionStartIndex := 0, RegionEndIndex := 0, CompletionTransitionID := 0, MaxDoCycles := 32766, HasEntryAction := True, HasDoAction := True, HasExitAction := True) , 
(ID := 14, Name := 'DOOR_DASHER_INLINE_TRANSFER_WAIT_FOR_ALL_DOORDASHERS_COMPLETE', StateType := _UML_SC_StateTypes.SlowState, StartOfTransitionIndex := 39, OutGoingTransitionsCount := 4, RegionCount := 0, RegionStartIndex := 0, RegionEndIndex := 0, CompletionTransitionID := 0, MaxDoCycles := 32766, HasEntryAction := True, HasDoAction := True, HasExitAction := True) , 
(ID := 15, Name := 'ChoiceElement4', StateType := _UML_SC_StateTypes.FastState, StartOfTransitionIndex := 43, OutGoingTransitionsCount := 6, RegionCount := 0, RegionStartIndex := 0, RegionEndIndex := 0, CompletionTransitionID := 0, MaxDoCycles := 0, HasEntryAction := False, HasDoAction := False, HasExitAction := False) , 
(ID := 16, Name := 'StartState5', StateType := _UML_SC_StateTypes.FastState, StartOfTransitionIndex := 49, OutGoingTransitionsCount := 1, RegionCount := 0, RegionStartIndex := 0, RegionEndIndex := 0, CompletionTransitionID := 0, MaxDoCycles := 32766, HasEntryAction := False, HasDoAction := False, HasExitAction := False) , 
(ID := 17, Name := 'DOOR_DASHER_CROSS_TRANSFER_FIND_TARGET_EYE_RISING_EDGE_POST', StateType := _UML_SC_StateTypes.SlowState, StartOfTransitionIndex := 50, OutGoingTransitionsCount := 4, RegionCount := 0, RegionStartIndex := 0, RegionEndIndex := 0, CompletionTransitionID := 0, MaxDoCycles := 32766, HasEntryAction := True, HasDoAction := True, HasExitAction := True) , 
(ID := 18, Name := 'StartState3', StateType := _UML_SC_StateTypes.FastState, StartOfTransitionIndex := 54, OutGoingTransitionsCount := 1, RegionCount := 0, RegionStartIndex := 0, RegionEndIndex := 0, CompletionTransitionID := 0, MaxDoCycles := 32766, HasEntryAction := False, HasDoAction := False, HasExitAction := False) , 
(ID := 19, Name := 'DOOR_DASHER_CROSS_TRANSFER_ACTIVATE_CROSS_CYLS', StateType := _UML_SC_StateTypes.SlowState, StartOfTransitionIndex := 55, OutGoingTransitionsCount := 4, RegionCount := 0, RegionStartIndex := 0, RegionEndIndex := 0, CompletionTransitionID := 0, MaxDoCycles := 32766, HasEntryAction := True, HasDoAction := True, HasExitAction := True) , 
(ID := 20, Name := 'DOOR_DASHER_COMPLETE', StateType := _UML_SC_StateTypes.SlowState, StartOfTransitionIndex := 59, OutGoingTransitionsCount := 4, RegionCount := 0, RegionStartIndex := 0, RegionEndIndex := 0, CompletionTransitionID := 0, MaxDoCycles := 32766, HasEntryAction := True, HasDoAction := True, HasExitAction := True) , 
(ID := 21, Name := 'DOOR_DASHER_INLINE_TRANSFER_STOP_MOTORS', StateType := _UML_SC_StateTypes.SlowState, StartOfTransitionIndex := 63, OutGoingTransitionsCount := 4, RegionCount := 0, RegionStartIndex := 0, RegionEndIndex := 0, CompletionTransitionID := 0, MaxDoCycles := 32766, HasEntryAction := True, HasDoAction := True, HasExitAction := True) , 
(ID := 22, Name := 'ChoiceElement3', StateType := _UML_SC_StateTypes.FastState, StartOfTransitionIndex := 67, OutGoingTransitionsCount := 5, RegionCount := 0, RegionStartIndex := 0, RegionEndIndex := 0, CompletionTransitionID := 0, MaxDoCycles := 0, HasEntryAction := False, HasDoAction := False, HasExitAction := False) , 
(ID := 23, Name := 'ChoiceElement5', StateType := _UML_SC_StateTypes.FastState, StartOfTransitionIndex := 72, OutGoingTransitionsCount := 6, RegionCount := 0, RegionStartIndex := 0, RegionEndIndex := 0, CompletionTransitionID := 0, MaxDoCycles := 0, HasEntryAction := False, HasDoAction := False, HasExitAction := False) , 
(ID := 24, Name := 'DOOR_DASHER_CROSS_TRANSFER_ALIGN_DOOR_AT_TARGET', StateType := _UML_SC_StateTypes.SlowState, StartOfTransitionIndex := 78, OutGoingTransitionsCount := 4, RegionCount := 0, RegionStartIndex := 0, RegionEndIndex := 0, CompletionTransitionID := 0, MaxDoCycles := 32766, HasEntryAction := True, HasDoAction := True, HasExitAction := True) , 
(ID := 25, Name := 'DOOR_DASHER_INLINE_TRANSFER_STOP_SOURCE_MOTOR', StateType := _UML_SC_StateTypes.SlowState, StartOfTransitionIndex := 82, OutGoingTransitionsCount := 4, RegionCount := 0, RegionStartIndex := 0, RegionEndIndex := 0, CompletionTransitionID := 0, MaxDoCycles := 32766, HasEntryAction := True, HasDoAction := True, HasExitAction := True) , 
