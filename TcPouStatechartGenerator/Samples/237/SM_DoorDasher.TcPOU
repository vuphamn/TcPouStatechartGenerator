    <Method Name="sourceCrossFwd" Id="{cc886053-d6ca-4d54-b227-99c9eea0c2be}">
      <Declaration><![CDATA[METHOD sourceCrossFwd
VAR 
	tableIndex : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tableIndex := stTargetPath.Path[iSourcePathIndex].TableIndex;
IF MAIN.mainStateMachine.asmTableManagers[tableIndex].config_bIsConveyorTable THEN
	MAIN.mainStateMachine.asmTableManagers[tableIndex].goFwd();
ELSE
	// inverted direction when crossing for the C234 feed.
	MAIN.mainStateMachine.asmTableManagers[tableIndex].goRev();
END_IF
]]></ST>
      </Implementation>
