END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i:=iSourcePathIndex TO iTargetPathIndex DO
	tableIndex := stTargetPath.Path[i].TableIndex;
	MAIN.mainStateMachine.asmTableManagers[tableIndex].goRev();
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="goSlow" Id="{9cf1f864-cdce-4bd3-b98d-0c131cde0809}">
      <Declaration><![CDATA[METHOD goSlow
VAR 
	i : INT;
	tableIndex : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i:=iSourcePathIndex TO iTargetPathIndex DO
	tableIndex := stTargetPath.Path[i].TableIndex;
	MAIN.mainStateMachine.asmTableManagers[tableIndex].psmHcFeedMotor^.cmd_iSpeedRPM := MAIN.mainStateMachine.asmTableManagers[tableIndex].iFeedSlowSpeedRPM;
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="initialize" Id="{42e574aa-665f-46e4-94cc-e2c18b58dd9d}">
      <Declaration><![CDATA[METHOD initialize

]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.initialize();		// must run first
descriptor.sModuleClass := 'Door Dasher';
]]></ST>
      </Implementation>
    </Method>
    <Method Name="inlineTransferStart" Id="{4325a22b-dc77-4bc5-873c-873090d7b1a4}">
      <Declaration><![CDATA[METHOD inlineTransferStart
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tFindTargetEyeTimeout := LREAL_TO_TIME((ABS(iSourcePathIndex - iTargetPathIndex) * config_fFindTargetEyeTimeSec) * 1000);
sSource := getTableName(cmd_iSource);
sTarget := getTableName(cmd_iTarget);
bDoorInMachineAtSource		:= MAIN.mainStateMachine.asmTableManagers[cmd_iSource].bDoorInMachine;
bDoorInMachineAtTarget		:= MAIN.mainStateMachine.asmTableManagers[cmd_iTarget].bDoorInMachine;
MAIN.mainStateMachine.asmTableManagers[cmd_iSource].setTransferOutStarted();
MAIN.mainStateMachine.asmTableManagers[cmd_iTarget].setDoorTransferredInStarted();
bIsTargetBufferTable := MAIN.mainStateMachine.asmTableManagers[cmd_iTarget].config_bIsBufferTable;

IF bMovingFwd THEN
	pdi_inlineSourceFeedEyeRisingEdge := ADR( MAIN.mainStateMachine.asmTableManagers[cmd_iSource].smC234FeedManager.di_BSideDoorSenseEye);
	pdi_inlineTargetFeedEyeRisingEdge := ADR( MAIN.mainStateMachine.asmTableManagers[cmd_iTarget].smC234FeedManager.di_ASideDoorSenseEye);
	pdi_inlineTargetFeedEyeFallingEdge := ADR( MAIN.mainStateMachine.asmTableManagers[cmd_iTarget].smC234FeedManager.di_ASideDoorSenseEye);
ELSE
	pdi_inlineSourceFeedEyeRisingEdge := ADR( MAIN.mainStateMachine.asmTableManagers[cmd_iSource].smC234FeedManager.di_ASideDoorSenseEye);
	pdi_inlineTargetFeedEyeRisingEdge := ADR( MAIN.mainStateMachine.asmTableManagers[cmd_iTarget].smC234FeedManager.di_BSideDoorSenseEye);
	pdi_inlineTargetFeedEyeFallingEdge := ADR( MAIN.mainStateMachine.asmTableManagers[cmd_iTarget].smC234FeedManager.di_BSideDoorSenseEye);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="isAligningDoorAtTarget" Id="{7ddeca58-cf37-4adb-98fa-b0f17771e6e5}">
      <Declaration><![CDATA[METHOD isAligningDoorAtTarget : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[isAligningDoorAtTarget := TRUE;
IF NOT bIsConveyorAtTarget THEN
	isAligningDoorAtTarget := MAIN.mainStateMachine.asmTableManagers[cmd_iTarget].smC234FeedManager.bAlignRunning;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="isAligningDoorAtTargetComplete" Id="{3f5da155-c190-42a2-87ea-f4343c2b9a59}">
      <Declaration><![CDATA[METHOD isAligningDoorAtTargetComplete : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[isAligningDoorAtTargetComplete := TRUE;
IF NOT bIsConveyorAtTarget THEN
	isAligningDoorAtTargetComplete := NOT MAIN.mainStateMachine.asmTableManagers[cmd_iTarget].smC234FeedManager.bAlignRunning;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="isFeedingInDoorAtTarget" Id="{36f59534-59ab-4f74-8c2b-494ed014886b}">
      <Declaration><![CDATA[METHOD isFeedingInDoorAtTarget : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bIsConveyorAtTarget THEN
	isFeedingInDoorAtTarget := MAIN.mainStateMachine.asmTableManagers[cmd_iTarget].smC234FeedManager.bFeedinRunning;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="isFeedingInDoorAtTargetComplete" Id="{f6f874ce-e2c4-43c5-b34f-9a91699ad3fe}">
      <Declaration><![CDATA[METHOD isFeedingInDoorAtTargetComplete : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bIsConveyorAtTarget THEN
	isFeedingInDoorAtTargetComplete := 
		NOT (MAIN.mainStateMachine.asmTableManagers[cmd_iTarget].smC234FeedManager.bFeedinRunning OR
		 MAIN.mainStateMachine.asmTableManagers[cmd_iTarget].smC234FeedManager.bAlignRunning OR
		 MAIN.mainStateMachine.asmTableManagers[cmd_iTarget].smC234FeedManager.status_bBusy);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="isSourceLeadingNeighborComplete" Id="{06d85f6b-3b83-47f1-a365-539c88860708}">
      <Declaration><![CDATA[METHOD isSourceLeadingNeighborComplete : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF iSourceLeadingNeighborIndex = -1 THEN
	isSourceLeadingNeighborComplete := TRUE;
	RETURN;
END_IF

IF NOT MAIN.mainStateMachine.asmTableManagers[iSourceLeadingNeighborIndex].bHasDoor THEN
	isSourceLeadingNeighborComplete := TRUE;
	RETURN;
END_IF

// At this point, the 'leading' neighbor has a door.
IF NOT (MAIN.mainStateMachine.asmTableManagers[iSourceLeadingNeighborIndex].smDoorDasher.bCrossTransferSeqRunning OR 
	MAIN.mainStateMachine.asmTableManagers[iSourceLeadingNeighborIndex].smDoorDasher.bInlineTransferSeqRunning) THEN
	isSourceLeadingNeighborComplete := TRUE;
	RETURN;
END_IF

// At this point, the 'leading' neighbor has a door and its DoorDasher's transferring seq is running.


// Finally, the source leading neighbor is complete if both the source's and the leading neighbor has door are going in the same direction.
isSourceLeadingNeighborComplete := 
	(MAIN.mainStateMachine.asmTableManagers[iSourceLeadingNeighborIndex].smDoorDasher.bCrossTransferWaitingForAllDoorDashersComplete OR 
	 MAIN.mainStateMachine.asmTableManagers[iSourceLeadingNeighborIndex].smDoorDasher.bInlineTransferWaitingForAllDoorDashersComplete) AND
	stCurrentTargetNode.Direction = eSourceLeadingNeighborNodeDirection;]]></ST>
      </Implementation>
    </Method>
    <Method Name="isSourceLeadingNeighborReady" Id="{ee07c25e-f095-4069-8bea-7c4fff07673e}">
      <Declaration><![CDATA[METHOD isSourceLeadingNeighborReady : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF iSourceLeadingNeighborIndex = -1 THEN
	isSourceLeadingNeighborReady := TRUE;
	RETURN;
END_IF

IF NOT MAIN.mainStateMachine.asmTableManagers[iSourceLeadingNeighborIndex].bHasDoor THEN
	isSourceLeadingNeighborReady := TRUE;
	RETURN;
END_IF

// At this point, the 'leading' neighbor has a door.
IF NOT (MAIN.mainStateMachine.asmTableManagers[iSourceLeadingNeighborIndex].smDoorDasher.bCrossTransferSeqRunning OR 
	MAIN.mainStateMachine.asmTableManagers[iSourceLeadingNeighborIndex].smDoorDasher.bInlineTransferSeqRunning) THEN
	isSourceLeadingNeighborReady := TRUE;
	RETURN;
END_IF

// At this point, the 'leading' neighbor has a door and its DoorDasher's transferring seq is running.


// Finally, the source leading neighbor is ready if both the source's and the leading neighbor has door are going in the same direction.
isSourceLeadingNeighborReady := 
	(MAIN.mainStateMachine.asmTableManagers[iSourceLeadingNeighborIndex].smDoorDasher.bCrossTransferWaitingForAllDoorDashersReady OR 
	 MAIN.mainStateMachine.asmTableManagers[iSourceLeadingNeighborIndex].smDoorDasher.bInlineTransferWaitingForAllDoorDashersReady) AND
	stCurrentTargetNode.Direction = eSourceLeadingNeighborNodeDirection;]]></ST>
      </Implementation>
    </Method>
    <Method Name="isSourceMotorMoving" Id="{ee24516f-3065-4bf7-83cb-d5b4659d9d2c}">
      <Declaration><![CDATA[METHOD isSourceMotorMoving : BOOL
VAR 
	tableIndex : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[tableIndex := stTargetPath.Path[iSourcePathIndex].TableIndex;
isSourceMotorMoving := MAIN.mainStateMachine.asmTableManagers[tableIndex].status_bMoving;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="isSourceTableReady" Id="{12c486f8-2b58-4cfa-a970-c38acf203ad7}">
      <Declaration><![CDATA[METHOD isSourceTableReady : BOOL
VAR 
	tableIndex : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tableIndex := stTargetPath.Path[iSourcePathIndex].TableIndex;
isSourceTableReady := 
	NOT (MAIN.mainStateMachine.asmTableManagers[tableIndex].anyChildBusy()
	) AND 
	MAIN.mainStateMachine.asmTableManagers[tableIndex].cmd_bAutoFeedOn;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="isSourceTrailingNeighborComplete" Id="{0ad6aae9-52f4-4a43-aec4-1abdd58064ea}">
      <Declaration><![CDATA[METHOD isSourceTrailingNeighborComplete : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF iSourceTrailingNeighborIndex = -1 THEN
	isSourceTrailingNeighborComplete := TRUE;
	RETURN;
END_IF

IF NOT MAIN.mainStateMachine.asmTableManagers[iSourceTrailingNeighborIndex].bHasDoor THEN
	isSourceTrailingNeighborComplete := TRUE;
	RETURN;
END_IF

// At this point, the 'trailing' neighbor has a door.
IF NOT (MAIN.mainStateMachine.asmTableManagers[iSourceTrailingNeighborIndex].smDoorDasher.bCrossTransferSeqRunning OR 
	MAIN.mainStateMachine.asmTableManagers[iSourceTrailingNeighborIndex].smDoorDasher.bInlineTransferSeqRunning) THEN
	isSourceTrailingNeighborComplete := TRUE;
	RETURN;
END_IF

// At this point, the 'trailing' neighbor has a door and its DoorDasher's transferring seq is running.

// Finally, check if the source's trailing neighbor is complete.
isSourceTrailingNeighborComplete := 
	stCurrentTargetNode.Direction <> MAIN.mainStateMachine.asmTableManagers[iSourceTrailingNeighborIndex].smDoorDasher.stCurrentTargetNode.Direction OR // TODO: if the source's trailing neighbor is not moving in the same direction, then it's considered complete.
	(MAIN.mainStateMachine.asmTableManagers[iSourceTrailingNeighborIndex].smDoorDasher.bCrossTransferWaitingForAllDoorDashersComplete OR 
	 MAIN.mainStateMachine.asmTableManagers[iSourceTrailingNeighborIndex].smDoorDasher.bInlineTransferWaitingForAllDoorDashersComplete)
	;]]></ST>
      </Implementation>
    </Method>
    <Method Name="isSourceTrailingNeighborReady" Id="{7e212fc6-59f2-4241-8ef9-b3378694c22d}">
      <Declaration><![CDATA[METHOD isSourceTrailingNeighborReady : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF iSourceTrailingNeighborIndex = -1 THEN
	isSourceTrailingNeighborReady := TRUE;
	RETURN;
END_IF

IF NOT MAIN.mainStateMachine.asmTableManagers[iSourceTrailingNeighborIndex].bHasDoor THEN
	isSourceTrailingNeighborReady := TRUE;
	RETURN;
END_IF

// At this point, the 'trailing' neighbor has a door.
IF NOT (MAIN.mainStateMachine.asmTableManagers[iSourceTrailingNeighborIndex].smDoorDasher.bCrossTransferSeqRunning OR 
	MAIN.mainStateMachine.asmTableManagers[iSourceTrailingNeighborIndex].smDoorDasher.bInlineTransferSeqRunning) THEN
	isSourceTrailingNeighborReady := TRUE;
	RETURN;
END_IF

// At this point, the 'trailing' neighbor has a door and its DoorDasher's transferring seq is running.

// Finally, check if the source's trailing neighbor is ready.
isSourceTrailingNeighborReady := 
	stCurrentTargetNode.Direction <> MAIN.mainStateMachine.asmTableManagers[iSourceTrailingNeighborIndex].smDoorDasher.stCurrentTargetNode.Direction OR // TODO: if the source's trailing neighbor is not moving in the same direction, then it's considered ready.
	(MAIN.mainStateMachine.asmTableManagers[iSourceTrailingNeighborIndex].smDoorDasher.bCrossTransferWaitingForAllDoorDashersReady OR 
	 MAIN.mainStateMachine.asmTableManagers[iSourceTrailingNeighborIndex].smDoorDasher.bInlineTransferWaitingForAllDoorDashersReady)
	;]]></ST>
      </Implementation>
    </Method>
    <Method Name="isTargetMotorMoving" Id="{b686962a-2c71-45d8-95a7-1cb09e4103b2}">
      <Declaration><![CDATA[METHOD isTargetMotorMoving : BOOL
VAR 
	tableIndex : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[tableIndex := stTargetPath.Path[iTargetPathIndex].TableIndex;
isTargetMotorMoving := MAIN.mainStateMachine.asmTableManagers[tableIndex].status_bMoving;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="isTargetTransferTableCandDsideDoorFeedEyesClear" Id="{d65f8068-ebb2-4b62-882c-5d7f9e51c26f}">
      <Declaration><![CDATA[METHOD isTargetTransferTableCandDsideDoorFeedEyesClear : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[isTargetTransferTableCandDsideDoorFeedEyesClear := 
	bIsConveyorAtTarget OR
	NOT (MAIN.mainStateMachine.asmTableManagers[cmd_iTarget].smC234FeedManager.di_CSideDoorFeedEye OR
		MAIN.mainStateMachine.asmTableManagers[cmd_iTarget].smC234FeedManager.di_DSideDoorFeedEye);]]></ST>
      </Implementation>
    </Method>
    <Method Name="postProcess" Id="{f2a05d74-55a1-4aaa-b1e6-52218d61973e}">
      <Declaration><![CDATA[METHOD postProcess
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.postProcess();
cmd_bReset := FALSE;
cmd_bDoorDash := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="preProcess" Id="{d80ca6b5-b444-492c-a882-3774c8e2106b}">
      <Declaration><![CDATA[(* this method is run before the doState is run*)
METHOD preProcess]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.preProcess();

bCrossTransferWaitingForAllDoorDashersReady := machineState = DOOR_DASHER_CROSS_TRANSFER_WAIT_FOR_ALL_DOORDASHERS_READY;
bCrossTransferWaitingForAllDoorDashersComplete := machineState = DOOR_DASHER_CROSS_TRANSFER_WAIT_FOR_ALL_DOORDASHERS_COMPLETE;

bInlineTransferWaitingForAllDoorDashersReady := machineState = DOOR_DASHER_INLINE_TRANSFER_WAIT_FOR_ALL_DOORDASHERS_READY;
bInlineTransferWaitingForAllDoorDashersComplete := machineState = DOOR_DASHER_INLINE_TRANSFER_WAIT_FOR_ALL_DOORDASHERS_COMPLETE;

ftrigAutofeedOn(CLK:=cmd_bAutoFeedOn);

IF iErrorId <> 0 THEN
	raiseError(FALSE);
END_IF


IF NOT cmd_bEnable THEN
	IF machineState > DOOR_DASHER_ENABLING AND
		machineState <= DOOR_DASHER_ERROR THEN
		machineState := DOOR_DASHER_DISABLED;
	END_IF	
ELSIF bError THEN
	IF machineState > DOOR_DASHER_ENABLING AND
		machineState < DOOR_DASHER_ERROR THEN
		machineState := DOOR_DASHER_ERROR;
	END_IF
ELSIF ftrigAutofeedOn.Q THEN
	IF machineState > DOOR_DASHER_AUTOFEED_OFF AND
		machineState < DOOR_DASHER_ERROR THEN
		machineState := DOOR_DASHER_AUTOFEED_OFF;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="raiseError" Id="{16dab513-936b-40ca-912f-cd3e4323040f}">
      <Declaration><![CDATA[METHOD raiseError
VAR_INPUT
	bSetError : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE iErrorId OF
	DOOR_DASHER_FAILED_TO_FIND_SOURCE_C_EYE_RISING_EDGE: 
		formatError('Failed to find source C-Eye rising edge', 'Turn Autofeed on and retry');
	DOOR_DASHER_FAILED_TO_FIND_SOURCE_D_EYE_RISING_EDGE: 
		formatError('Failed to find source D-Eye rising edge', 'Turn Autofeed on and retry');
	DOOR_DASHER_FAILED_TO_FIND_TARGET_C_EYE_RISING_EDGE: 
		formatError('Failed to find target C-Eye rising edge', 'Turn Autofeed on and retry');
	DOOR_DASHER_FAILED_TO_FIND_TARGET_D_EYE_RISING_EDGE: 
		formatError('Failed to find target D-Eye rising edge', 'Turn Autofeed on and retry');
	DOOR_DASHER_FAILED_TO_FIND_FALLING_EDGE_OF_TARGET_FEED_EYE_OR_RISING_EDGE_FENCE_EYE: 
		formatError('Failed to find falling edge of target feed eye or rising edge fence eye', 'Turn Autofeed on and retry');		
	DOOR_DASHER_TARGET_TRANSFER_TABLE_C_AND_D_FEED_EYES_MUST_BE_CLEAR: 
		formatError('Target transfer table C and D feed eyes must be clear', 'Turn Autofeed on and retry');
	DOOR_DASHER_FAILED_TO_FIND_SOURCE_A_EYE_RISING_EDGE: 
		formatError('Failed to find source A-Eye rising edge', 'Turn Autofeed on and retry');
	DOOR_DASHER_FAILED_TO_FIND_SOURCE_B_EYE_RISING_EDGE: 
		formatError('Failed to find source B-Eye rising edge', 'Turn Autofeed on and retry');
	DOOR_DASHER_FAILED_TO_FIND_TARGET_A_SIDE_EYE_RISING: 
		formatError('Failed to find target A-side eye rising edge', 'Turn Autofeed on and retry');
	DOOR_DASHER_FAILED_TO_FIND_TARGET_A_SIDE_EYE_FALLING: 
		formatError('Failed to find target A-side eye falling edge', 'Turn Autofeed on and retry');	
	DOOR_DASHER_FAILED_TO_FIND_TARGET_B_SIDE_EYE_RISING: 
		formatError('Failed to find target B-side eye rising edge', 'Turn Autofeed on and retry');
	DOOR_DASHER_FAILED_TO_FIND_TARGET_B_SIDE_EYE_FALLING: 
		formatError('Failed to find target B-side eye falling edge', 'Turn Autofeed on and retry');	
END_CASE
SUPER^.raiseError(bSetError);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="recordStateCallHistory" Id="{8167215a-9c5f-4707-9e8b-80558df34165}" FolderPath="uml\">
      <Declaration><![CDATA[(* base implementation to record state calling history. 
 	Derrived FB's should override this method to replace the machine' specific type of eState *)
	
METHOD recordStateCallHistory
VAR_INPUT
	iState				: INT;
	iSubState			: INT;
END_VAR
VAR
	sCurTaskCycle 		: STRING;
    eState       		: E_DoorDasher_States; // todo: replace with the derrived STRUCT type (ie, E_HeadManager_States)
    eSubState			: E_SubState;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// DO NOT CHANGE BELOW!!!
// This was auto-generated by a Kval's UML tool.

sCurTaskCycle := TO_STRING(mainStateCallingData[iState, iSubState].nCycleIdFirstCall);
eState := iState;
eSubState := iSubState;

// Enter the state name into array
mainStateCallHistory[iStateCallHistoryIndex].sTaskCycle := sCurTaskCycle;
mainStateCallHistory[iStateCallHistoryIndex].sStateId := TO_STRING(iState);
mainStateCallHistory[iStateCallHistoryIndex].sStateDesc := TO_STRING(eState);
mainStateCallHistory[iStateCallHistoryIndex].sSubStateId := TO_STRING(iSubState);
mainStateCallHistory[iStateCallHistoryIndex].sSubStateDesc := TO_STRING(eSubState);

iStateCallHistoryIndex := iStateCallHistoryIndex + 1;
IF iStateCallHistoryIndex = MAX_STATE_CALL_HISTORY THEN
	iStateCallHistoryIndex := 0;
END_IF

// mark next index to record state call history
mainStateCallHistory[iStateCallHistoryIndex].sTaskCycle := '--';
mainStateCallHistory[iStateCallHistoryIndex].sStateId := '--';
mainStateCallHistory[iStateCallHistoryIndex].sStateDesc := '--';
mainStateCallHistory[iStateCallHistoryIndex].sSubStateId := '--';
mainStateCallHistory[iStateCallHistoryIndex].sSubStateDesc := '--';]]></ST>
      </Implementation>
    </Method>
