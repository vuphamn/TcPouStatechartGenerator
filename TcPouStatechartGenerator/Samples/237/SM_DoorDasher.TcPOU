    <Method Name="updateSourceTargetDoorTrack" Id="{19eaab80-dcc4-41f8-9fdc-97857fc39cd6}">
      <Declaration><![CDATA[METHOD updateSourceTargetDoorTrack
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[setTargetDoorTrack();	
// is there new door-track data copied from the trailing door-dasher?
IF pstTable^.bDoorTrackDirty THEN
	pstTable^.bDoorTrackDirty := FALSE;
	pstTable^.stDoorTrack := pstTable^.stDoorTrackLast;
	pstTable^.setTableEmptyStatus(FALSE);
ELSE
	// clear source's DoorTrack.
	pstTable^.stDoorTrack := stDoorTrackDefault;
	pstTable^.setTableEmptyStatus(TRUE);					
END_IF]]></ST>
      </Implementation>
    </Method>
