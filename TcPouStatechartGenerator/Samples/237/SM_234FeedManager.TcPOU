<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="SM_234FeedManager" Id="{4e540ff9-af90-451c-8463-b311a5dc8289}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK SM_234FeedManager EXTENDS SM_FeedManagerBase
VAR_INPUT
	cmd_bReset						: BOOL; 	// reset from error state
	cmd_bToFenceFwd					: BOOL; 	// true => to-fence fwd.
	cmd_bToFenceRev					: BOOL; 	// true => to-fence rev.
	cmd_bCrossTransferFwd			: BOOL; 	// true => cross-feed fwd.
	cmd_bCrossTransferRev			: BOOL; 	// true => cross-feed rev.	
	cmd_bInlineTransferFwd			: BOOL; 	// true => feed straight fwd.
	cmd_bInlineTransferRev			: BOOL; 	// true => feed straight rev.
	cmd_bJogSlow					: BOOL; 	// true => jog slow; false => jog fast. 
	cmd_bAbort						: BOOL; 	// trigger event to abort any motion.
	cmd_bFeedIn						: BOOL;		// trigger event to feed in the door.
	cmd_bRotate						: BOOL; 	// true to rotate door if Option A is installed.
	cmd_bSelfCenter					: BOOL;		// true to self-center door if Option S is installed.	
	cmd_bAlign						: BOOL;		// true to align door at the near/far/center fence position before feeding out.	
	cmd_bCrossFeedinFwd				: BOOL;		// true to cross-feed-in in the forward direction.
	cmd_bCrossFeedinRev				: BOOL;		// true to cross-feed-in in the reverse direction.
	cmd_bCrossFeedoutFwd			: BOOL;		// true to cross-feed-out in the forward direction.
	cmd_bCrossFeedoutRev			: BOOL;		// true to cross-feed-out in the reverse direction.
	cmd_bRaiseCrossCyls				: BOOL; 	// true to raise both the cross cyls.
	cmd_bLowerCrossCyls				: BOOL; 	// true to lower both the cross cyls.

	cmd_bAllConveyorTablesInitCompleted : BOOL; // true to wait for all conveyor tables init seq to complete.
	
	// the currently select feed-out destination index (3-bit value, range 0-7). 
	// Notes: 
	// In 'full-auto' routing mode, this might come from table's CtrlInterface sent from machine's job download such as Apex running KvalCAM or 994-X running InduSoft.
	// In 'semi-auto' or manual routing mode, this comes from the 3-bit (8 positions) switch.
	cmd_iSelectedDestinationIndex			: UINT;
	
	// The rising edge of this input tells the machine that the door data for the incoming door is set and correct.
	// Notes:
	// This is a push-button on any system where the destination is manually selected by the operator. If the destination is auto-generated, this will be tied to that automatic system.
	cmd_bDoorDataReady						: BOOL;  
	
	cmd_eIncomingDoorHand					: E_DOORHAND := E_DOORHAND.DOORHAND_NO_HAND;
	cmd_bFeedInHasDoorTest					: BOOL; // for testing feed-in and set the HasDoor = true.
	
	config_eFeedoutAligned				: E_FeedoutAligned; // feedout align at near/far/center fence

	(* Config parameters *)
	config_iFastSpeedRPM 					: UINT;		// speed fast in RPM	
	config_iSlowSpeedRPM					: UINT;		// speed slow in RPM

	config_bOutfeedSideA_Enabled			: BOOL; // true if the feed-out Side-A is enabled.
	config_bOutfeedSideB_Enabled			: BOOL; // true if the feed-out Side-B is enabled.
	
	
	config_bInputPort						: BOOL; // true if table can receive doors from other machines such as Apex/Commander3.
	config_bBypassInfeedSideA_IsLockEdgeRightOfAB : BOOL; // true to bypass Infeed-Side-A's IsLockEdgeRightOfAB for rotation/flip check.
	config_bCanSelfCenter					: BOOL; // true if table has the self-centering option (Option S)
	config_bCanRotate						: BOOL; // true if table has the Auto-rotate option (Option A)	
	config_bLH_RotateDoorRequired 			: BOOL; // true to rotate LH door. Set by KvalCAM and stored in topology.
	config_bRH_RotateDoorRequired 			: BOOL; // true to rotate RH door. Set by KvalCAM and stored in topology.
	config_bIsBufferTable					: BOOL;
	
	
	config_tDoorClearCorDEyeTime			: TIME := T#0.2S; // timeout for init seq.
	config_tInitNotOnOutfeedEndEyeDoorSearchTimeout			: TIME := T#5.55S; // timeout for init/door-search timeout when not on the outfeed-end eye.
	config_tInitOnOutfeedEndEyeDoorSearchTimeout			: TIME := T#10.55S; // timeout for init/door-search timeout when not on the outfeed-end eye.
	config_tFeedinTimeout					: TIME := T#10.0S; // timeout for the feedin seq to find door-stop 1 eye rising edge or falling edge of infeed-end eye.
	config_tInitFeedinTimeout				: TIME := T#5.15S; // timeout for the init seq to find door-stop 1 eye rising edge.
	
	config_tFeedinInMachineEye  			: TIME := T#2.0S; // timeout on finding falling edge of in-machine eye.
	config_tFeedinTimeout1  				: TIME := T#4.0S; // timeout for 6'6" door length after falling edge of infeed-end. 
	config_tFeedinTimeout2  				: TIME := T#3.0S; // timeout for 8' door length after finding rising edge of door stop1
	config_tDoorAtFenceWaitTime  			: TIME := T#1.0S; // how long to wait for door to arrive at near/far fence after finding rising edge of near/far eye.
 	config_tFindDoorAtFenceEyeLongTimeout  	: TIME := T#10.25S; // timeout for finding near/far fence eye for smaller-width doors
	config_tFindDoorAtFenceEyeShortTimeout  : TIME := T#5.5S; // timeout for finding near/far fence eye for wide-width doors that cover both near and far fence eyes, or door is on the eye of the side of the fence being aligned to. 
	config_tFindCorDFeedEdgeTimeout  		: TIME := T#5.0S;
	config_tInfeedEndEyeValidTime	: TIME := T#100MS;	// debouncing time for finding falling edge of infeed-end eye
	config_tCorDEyeFallingEdgeTime	: TIME := T#250MS;

	// an Auto-cross transfer table can have any combination of these 2 options: S: self-centering door, A: auto-rotate door
	smSelfCenterManager						: SM_SelfCenterManager; // manage self-centering the door.
	smRotateManager							: SM_RotateManager; // manage rotating the door.
	
	psmCrossFeedFenceHeightCyl				: POINTER TO SM_KCylinder;
	psmCrossFeedTransferHeightCyl			: POINTER TO SM_KCylinder;
	
	// door feed eyes
	di_ASideDoorSenseEye				: BOOL;
	di_BSideDoorSenseEye				: BOOL;	
	
	di_OkToFeedOutSideA					: BOOL; // Side-A call-door/foot-pedal input used by the feedout seq.
	di_OkToFeedOutSideB					: BOOL; // Side-B call-door/foot-pedal input used by the feedout seq.
	
	
	di_AtNearFenceEye				: BOOL;  // used to detect door is aligned at the near fence. 
	di_AtFarFenceEye				: BOOL;  // used to detect door is aligned at the far fence.
	
	// these are only present on machine with IsInputPort = true.
	di_InMachineEye					: BOOL; // used to detect 7' <= doorLength < 8'
	di_DoorStop1Eye					: BOOL;
	di_DoorStop3Eye					: BOOL;
	
	// the following digital inputs are new from phase 2:
	di_DoorDataReady				: BOOL; // The rising edge of this input tells the machine that the door data for the incoming door is set and correct.

	di_IncomingDoorLH				: BOOL; // Indicates the incoming door is LH	
	di_IncomingDoorRH				: BOOL; // Indicates the incoming door is RH	

	di_DestinationBit0				: BOOL; // Bit #0 of the destination instruction.
	di_DestinationBit1				: BOOL; // Bit #1 of the destination instruction.
	di_DestinationBit2				: BOOL; // Bit #2 of the destination instruction.
	
	// The "Disable Out-Feed Port" signals are used to turn-off a specific port, at the actual table side. It's a way for the operator at the out-feed location to disable doors going to this location.
	di_DisableFeedoutSideA				: BOOL;
	di_DisableFeedoutSideB				: BOOL;			
	 
END_VAR
VAR_OUTPUT
	
	// This signal goes true when valid door data is received. This indicates that a pending door-entry request is active.	
	// Notes: 
	// For systems where the destination is manually selected by the operator, this will be tied to an indicator light.
	// For auto-routing systems, this will need to be used to determine if a route is set.	
	do_DoorDataAck						: BOOL;
	
	// This signal goes true when the table is ready to receive a door from the indicated side. This will always be in response to an active door request.
	// Notes: at the moment, only SideA is allowed to receive door. Sides B,C and D are reserved for future.	
	do_OkToFeedInSideA					: BOOL;
	do_OkToFeedInSideB					: BOOL;

	// This signal goes true when there is a door ready to feed out the given side. It's waiting for the corresponding "OK To Feed Out" signal.	
	do_ReadyToFeedoutSideA				: BOOL;
	do_ReadyToFeedoutSideB				: BOOL;	
	
	
	bOkToFeedIn					: BOOL;
	bReadyToFeedOut				: BOOL;
	bCrossfeedCylsRetracted 	: BOOL;
	bCrossfeedCylsExtended 		: BOOL;
	
	bFeedinRunning				: BOOL; // true if the feedin seq is running.
	
	bSelfCenterRunning			: BOOL; // true if the self-centering seq is running.
	bRotateRunning				: BOOL; // true if the rotate seq is running.
	
	bAlignRunning				: BOOL; // true if the centering/fence-align seq is running.
	bRotateRequired				: BOOL; // true if the feeding-in door required to be rotated. 
	bIncomingDoorHandValid		: BOOL;
	
	bDoorDataAck				: BOOL;
END_VAR
VAR CONSTANT
END_VAR

VAR
	tonReadyToFeedoutSideA_Blinker				: TON;	
	tonReadyToFeedoutSideB_Blinker				: TON;	
	tonDoorArrivedAtFenceWaitTimer				: TON;
	tOutfeedEndEyeDoorSearchTimeout				: TIME;
	tFindDoorAtFenceEyeTimeout  				: TIME;
	rtrigInitFoundDoor							: R_TRIG; // trigger on rising edge of bInitRunning AND other combinations of inputs.
	rtrigFeedFwdInMachineEyeRisingEdge 			: R_TRIG; // trigger on rising edge of in-machine eye going in forward direction
	rtrigFeedRevInMachineEyeRisingEdge 			: R_TRIG; // trigger on rising edge of in-machine eye going in reverse direction	
	rtrigFeedOutfeedEndSlowEyeRisingEdge 		: R_TRIG; // trigger event to indicate the feed sequence arrived at the slow eye.
	rtrigInfeedEndDoorSenseEyeRisingEdge		: R_TRIG; // trigger on rising edge of infeed-end door sense eye.	
	rtrigFeedinTimeout							: R_TRIG; // timeout rising edge trigger for the init/feedin seq.  For the init seq, timeout is smaller because door is already in machine.	
	rtrigAtFenceEye								: R_TRIG; // triggered on rising edge of near/far fence eye.
	ftrigCorDEyeFallingEdge						: F_TRIG; // triggered on falling edge of C or D eye to indicate door init is complete.
	ftrigRotateComplete							: F_TRIG; // trigger to indicate the rotate sequence is completed.
	ftrigSelfCenterComplete						: F_TRIG; // trigger to indicate the door-centering sequence is completed.
	ftrigInMachineEye							: F_TRIG; // triggered on falling edge of the in-machine eye.
	rtrigDoorStopEye1RisingEdge					: R_TRIG; // triggered on rising edge of door-stop-eye1
	rtrigDoorStopEye1AndNotInMachineEye			: R_TRIG; // triggered on rising edge of door-stop-eye1 and NOT in-machine eye
	rtrigDoorStopEye1AndInMachineEye			: R_TRIG; // triggered on rising edge of door-stop-eye1 and in-machine eye, keep going to find falling edge of in-machine eye.
	rtrigDoorStopEye3RisingEdge					: R_TRIG; // triggered on rising edge of door-stop-eye3
	ftrigInfeedEndDoorSenseEyeFallingEdge		: F_TRIG; // triggered on falling edge of the infeed-end-eye during the cross-feed-in process.
	tofInfeedEndEyeValidTimer					: TOF;
	tofCorDEyeFallingEdgeTimer					: TOF;
	iCurDestinationIndex						: UINT; 
	iLastDestinationIndex						: UINT;

	bLastDoorDataReady							: BOOL;
	
	bLastIncomingDoorLH							: BOOL;
	bLastIncomingDoorRH							: BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[runMachine();

]]></ST>
    </Implementation>
    <Folder Name="uml" Id="{ffa918be-ea15-4341-940c-4bb585c193dc}" />
    <Method Name="blinkReadyToFeedoutSideA" Id="{fa00e0e7-7172-4d21-92a7-8fabebeb8502}">
      <Declaration><![CDATA[METHOD blinkReadyToFeedoutSideA
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tonReadyToFeedoutSideA_Blinker(in:=TRUE, PT:=T#500MS);
IF tonReadyToFeedoutSideA_Blinker.Q THEN
	tonReadyToFeedoutSideA_Blinker(in:=FALSE);
	do_ReadyToFeedoutSideA := NOT do_ReadyToFeedoutSideA;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="blinkReadyToFeedoutSideB" Id="{d1f94fcd-d39d-40e8-845b-7630cca7d3fb}">
      <Declaration><![CDATA[METHOD blinkReadyToFeedoutSideB
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tonReadyToFeedoutSideB_Blinker(in:=TRUE, PT:=T#500MS);
IF tonReadyToFeedoutSideB_Blinker.Q THEN
	tonReadyToFeedoutSideB_Blinker(in:=FALSE);
	do_ReadyToFeedoutSideB := NOT do_ReadyToFeedoutSideB;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="destinationDigitalInputsToDestinationIndex" Id="{458713c3-c9b7-438f-adba-a06555fd4e47}">
      <Declaration><![CDATA[// Notes: this only applies to semi- and manual-routing modes where operator selects the 4-position destination switch.
// For 'full-auto' routing mode, the destination-index and 'door-data-ready' inputs are set by the machine downloading the job.
METHOD destinationDigitalInputsToDestinationIndex : UINT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[destinationDigitalInputsToDestinationIndex := 
	SHL(BOOL_TO_UINT(di_DestinationBit0), 0) OR 
	SHL(BOOL_TO_UINT(di_DestinationBit1), 1) OR 
	SHL(BOOL_TO_UINT(di_DestinationBit2), 2); ]]></ST>
      </Implementation>
    </Method>
    <Method Name="doState" Id="{44cf212b-2e1e-472c-87eb-5d80e83b9bbd}">
      <Declaration><![CDATA[METHOD doState
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE (machineState) OF	
	C234_FEEDMANAGER_DISABLED:
		IF bFirstPass THEN
		   downstream.setAllDownstreamDisabled();
			status_bReady := FALSE;
			cmd_bFeedIn := FALSE;
			cmd_bFeedOut := FALSE;
			do_OkToFeedInSideA := FALSE;
		END_IF

	C234_FEEDMANAGER_ENABLING:
		IF bFirstPass THEN
			 downstream.setAllDownstreamEnabled();
		END_IF
		IF downstream.status_bDownstreamAllReady THEN
			setTableEmptyStatus(TRUE);
			machineState := C234_FEEDMANAGER_AUTOFEED_OFF;
		END_IF
		
	C234_FEEDMANAGER_AUTOFEED_OFF:
		IF bFirstPass THEN
			cmd_bFeedIn := FALSE;
			cmd_bFeedOut := FALSE;
			status_bReady := TRUE;
			status_bBusy := FALSE;
			cmd_bInlineTransferFwd := FALSE;
			cmd_bInlineTransferRev := FALSE;	
			bExternal := FALSE;
			bInitRunning := FALSE;
			bFeedinRunning := FALSE;
			bSelfCenterRunning := FALSE;
			bRotateRunning := FALSE;
			bAlignRunning := FALSE;
			bFeedoutRunning := FALSE;
			cmd_bAllConveyorTablesInitCompleted := FALSE;
			do_OkToFeedInSideA := FALSE;
			stop();
		END_IF
		
		IF cmd_bAutoFeedOn THEN
			machineState := C234_FEEDMANAGER_AUTOFEED_ON;
		ELSIF cmd_bSelfCenter AND
			config_bCanSelfCenter AND
			NOT smSelfCenterManager.status_bBusy THEN
			machineState := C234_FEEDMANAGER_SELF_CENTER_LOWER_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS;
		ELSIF cmd_bRotate AND
			config_bCanRotate AND
			NOT smRotateManager.status_bBusy THEN
			machineState := C234_FEEDMANAGER_ROTATE_LOWER_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS;
		ELSIF cmd_bCrossTransferFwd OR cmd_bCrossTransferRev THEN
			machineState := C234_FEEDMANAGER_JOG_RAISE_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS;	
		ELSIF cmd_bInlineTransferFwd OR cmd_bInlineTransferRev THEN
			machineState := C234_FEEDMANAGER_JOG_LOWER_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS;
		ELSIF cmd_bToFenceFwd OR cmd_bToFenceRev THEN
			machineState := C234_FEEDMANAGER_JOG_RAISE_CROSS_FEED_FENCE_AND_LOWER_TRANSFER_HEIGHT_CYLS;
		END_IF
	
	C234_FEEDMANAGER_AUTOFEED_ON:
		IF bFirstPass THEN
			cmd_bFeedIn := FALSE;
			cmd_bFeedOut := FALSE;
			status_bReady := TRUE;
			status_bBusy := FALSE;
			cmd_bInlineTransferFwd := FALSE;
			cmd_bInlineTransferRev := FALSE;
			bExternal := FALSE;
			bInitRunning := FALSE;
			bFeedinRunning := FALSE;
			bSelfCenterRunning := FALSE;
			bRotateRunning := FALSE;
			bAlignRunning := FALSE;
			bFeedoutRunning := FALSE;
			cmd_bAllConveyorTablesInitCompleted := FALSE;
			stop();
		END_IF
		do_OkToFeedInSideA := bOkToFeedIn;
		IF cmd_bTestToggleHasDoor THEN
			machineState := C234_FEEDMANAGER_TEST_TOGGLE_HAS_DOOR;
		ELSIF cmd_bFeedInHasDoorTest THEN
			machineState := C234_FEEDMANAGER_FEEDIN_START;
		ELSIF NOT cmd_bAutoFeedOn THEN
			machineState := C234_FEEDMANAGER_AUTOFEED_OFF;
		ELSIF cmd_bInit THEN
			machineState := C234_FEEDMANAGER_INIT_START;
		ELSIF cmd_bFeedIn THEN
			machineState := C234_FEEDMANAGER_FEEDIN_START;
		ELSIF cmd_bFeedOut THEN
			machineState := C234_FEEDMANAGER_FEEDOUT_START;
		ELSIF cmd_bExternal THEN
			machineState := C234_FEEDMANAGER_EXTERNAL;
		END_IF
	
	C234_FEEDMANAGER_TEST_TOGGLE_HAS_DOOR:
		IF bFirstPass THEN
			bTableIsEmpty := NOT bTableIsEmpty;
			setTableEmptyStatus(bTableIsEmpty);	
		END_IF
		machineState := C234_FEEDMANAGER_AUTOFEED_ON;
		
	// external seq	
	C234_FEEDMANAGER_EXTERNAL:
		IF bFirstPass THEN
			cmd_bFeedIn := FALSE;
			bExternal := TRUE;
			status_bBusy := FALSE;
			bAlignRunning := FALSE;
			bFeedinRunning := FALSE;
			do_OkToFeedInSideA := FALSE;
			stop();
		END_IF
		IF cmd_bFeedIn THEN
			machineState := C234_FEEDMANAGER_FEEDIN_START;
		ELSIF cmd_bRotate THEN
			machineState := C234_FEEDMANAGER_ROTATE_LOWER_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS;
		ELSIF cmd_bSelfCenter THEN
			machineState := C234_FEEDMANAGER_SELF_CENTER_LOWER_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS;
		ELSIF cmd_bInternal OR NOT cmd_bAutoFeedOn THEN
			machineState := C234_FEEDMANAGER_AUTOFEED_ON;
		ELSIF cmd_bRaiseCrossCyls THEN
			machineState := C234_FEEDMANAGER_EXTERNAL_RAISE_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS;
		ELSIF cmd_bLowerCrossCyls THEN
			machineState := C234_FEEDMANAGER_EXTERNAL_LOWER_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS;
		ELSIF cmd_bAlign THEN
			machineState := C234_FEEDMANAGER_ALIGN_START;
		END_IF
	
	C234_FEEDMANAGER_EXTERNAL_RAISE_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS:
		IF bFirstPass THEN
			status_bBusy := TRUE;
			psmCrossFeedFenceHeightCyl^.cmd_bExtend := TRUE;
			psmCrossFeedTransferHeightCyl^.cmd_bExtend := TRUE;
		END_IF
		IF bCrossfeedCylsExtended OR config_bIsBufferTable OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
			machineState := C234_FEEDMANAGER_EXTERNAL;
		END_IF
		
	C234_FEEDMANAGER_EXTERNAL_LOWER_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS:
		IF bFirstPass THEN
			status_bBusy := TRUE;
			psmCrossFeedFenceHeightCyl^.cmd_bRetract := TRUE;
			psmCrossFeedTransferHeightCyl^.cmd_bRetract := TRUE;
		END_IF
		IF bCrossfeedCylsRetracted OR config_bIsBufferTable OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
			machineState := C234_FEEDMANAGER_EXTERNAL;
		END_IF
		
	C234_FEEDMANAGER_JOG_LOWER_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS:
		IF bFirstPass THEN
			status_bBusy := TRUE;
			psmCrossFeedFenceHeightCyl^.cmd_bRetract := TRUE;
			psmCrossFeedTransferHeightCyl^.cmd_bRetract := TRUE;
		END_IF
		IF NOT (cmd_bInlineTransferFwd OR cmd_bInlineTransferRev) THEN
			machineState := C234_FEEDMANAGER_AUTOFEED_OFF;
		ELSIF bCrossfeedCylsRetracted OR config_bIsBufferTable OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
			machineState := C234_FEEDMANAGER_INLINE_JOGGING;
		END_IF
		
	C234_FEEDMANAGER_INLINE_JOGGING:
		IF bFirstPass THEN
			status_bBusy := TRUE;	
			psmFeedMotor^.cmd_bFwd := cmd_bInlineTransferFwd;
			psmFeedMotor^.cmd_bRev := cmd_bInlineTransferRev;
		END_IF
		IF cmd_bJogSlow THEN
			goSlow();
		ELSE
			goFast();
		END_IF
		IF NOT (cmd_bInlineTransferFwd OR cmd_bInlineTransferRev) THEN
			machineState := C234_FEEDMANAGER_AUTOFEED_OFF;
		END_IF

	C234_FEEDMANAGER_JOG_RAISE_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS:
		IF bFirstPass THEN
			status_bBusy := TRUE;
			psmCrossFeedFenceHeightCyl^.cmd_bExtend := TRUE;
			psmCrossFeedTransferHeightCyl^.cmd_bExtend := TRUE;
		END_IF
		IF NOT (cmd_bCrossTransferFwd OR cmd_bCrossTransferRev) THEN
			machineState := C234_FEEDMANAGER_AUTOFEED_OFF;
		ELSIF bCrossfeedCylsExtended OR config_bIsBufferTable OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
			machineState := C234_FEEDMANAGER_CROSS_JOGGING;
		END_IF
	
	C234_FEEDMANAGER_CROSS_JOGGING:
		IF bFirstPass THEN
			status_bBusy := TRUE;	
			psmFeedMotor^.cmd_bFwd := cmd_bCrossTransferFwd;
			psmFeedMotor^.cmd_bRev := cmd_bCrossTransferRev;
		END_IF
		IF cmd_bJogSlow THEN
			crossSlow();
		ELSE
			crossFast();
		END_IF
		IF NOT (cmd_bCrossTransferFwd OR cmd_bCrossTransferRev) THEN
			machineState := C234_FEEDMANAGER_AUTOFEED_OFF;
		END_IF
	
	C234_FEEDMANAGER_JOG_RAISE_CROSS_FEED_FENCE_AND_LOWER_TRANSFER_HEIGHT_CYLS:
		IF bFirstPass THEN
			status_bBusy := TRUE;
			psmCrossFeedFenceHeightCyl^.cmd_bExtend := TRUE;
			psmCrossFeedTransferHeightCyl^.cmd_bRetract := TRUE;
		END_IF
		IF NOT (cmd_bToFenceFwd OR cmd_bToFenceRev) THEN
			machineState := C234_FEEDMANAGER_AUTOFEED_OFF;
		ELSIF psmCrossFeedFenceHeightCyl^.status_bExtended AND 
			psmCrossFeedTransferHeightCyl^.status_bRetracted OR
			config_bIsBufferTable OR
			(config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
			machineState := C234_FEEDMANAGER_TO_FENCE_JOGGING;
		END_IF
		
	C234_FEEDMANAGER_TO_FENCE_JOGGING:
		IF bFirstPass THEN
			status_bBusy := TRUE;	
			psmFeedMotor^.cmd_bFwd := cmd_bToFenceFwd;
			psmFeedMotor^.cmd_bRev := cmd_bToFenceRev;
		END_IF
		IF cmd_bJogSlow THEN
			crossSlow();
		ELSE
			crossFast();
		END_IF
		IF NOT (cmd_bToFenceFwd OR cmd_bToFenceRev) THEN
			machineState := C234_FEEDMANAGER_AUTOFEED_OFF;
		END_IF
		
	C234_FEEDMANAGER_ROTATE_LOWER_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS:
		IF bFirstPass THEN
			status_bBusy := TRUE;
			bRotateRunning := TRUE;
			psmCrossFeedFenceHeightCyl^.cmd_bRetract := TRUE;
			psmCrossFeedTransferHeightCyl^.cmd_bRetract := TRUE;
		END_IF
		IF bCrossfeedCylsRetracted OR config_bIsBufferTable OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
			machineState := C234_FEEDMANAGER_ROTATE;
		END_IF
	
	C234_FEEDMANAGER_ROTATE:
		IF bFirstPass THEN
			status_bBusy := TRUE;
			smRotateManager.cmd_bRotate := TRUE;
		end_if
		ftrigRotateComplete(CLK:=smRotateManager.status_bBusy);
		IF ftrigRotateComplete.Q THEN
			IF bExternal THEN
				machineState := C234_FEEDMANAGER_EXTERNAL;
			ELSE
				machineState := C234_FEEDMANAGER_AUTOFEED_OFF;
			END_IF
		END_IF
		
	C234_FEEDMANAGER_SELF_CENTER_LOWER_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS:
		IF bFirstPass THEN
			status_bBusy := TRUE;
			bSelfCenterRunning := TRUE;
			psmCrossFeedFenceHeightCyl^.cmd_bRetract := TRUE;
			psmCrossFeedTransferHeightCyl^.cmd_bRetract := TRUE;
		END_IF
		IF bCrossfeedCylsRetracted OR config_bIsBufferTable OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
			machineState := C234_FEEDMANAGER_SELF_CENTER;
		END_IF
	
	C234_FEEDMANAGER_SELF_CENTER:
		IF bFirstPass THEN
			status_bBusy := TRUE;
			smSelfCenterManager.cmd_bSelfCenter := TRUE;
		end_if
		ftrigSelfCenterComplete(CLK:=smSelfCenterManager.status_bBusy);
		IF ftrigSelfCenterComplete.Q THEN
			IF bExternal THEN
				machineState := C234_FEEDMANAGER_EXTERNAL;
			ELSE
				machineState := C234_FEEDMANAGER_AUTOFEED_OFF;
			END_IF
		END_IF
		
	// init seq
	C234_FEEDMANAGER_INIT_START:
		IF bFirstPass THEN
			bInitRunning := TRUE;	
			status_bBusy := TRUE;
			do_OkToFeedInSideA := FALSE;
			setTableEmptyStatus(TRUE);
		ELSE
			IF config_bIsBufferTable THEN
				machineState := C234_FEEDMANAGER_INIT_WAIT_FOR_ALL_CONVEYORS_INIT_COMPLETE;
			ELSIF di_CSideDoorFeedEye OR di_DSideDoorFeedEye THEN
				machineState := C234_FEEDMANAGER_INIT_RAISE_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS;
			ELSE 
				machineState := C234_FEEDMANAGER_INIT_WAIT_FOR_ALL_CONVEYORS_INIT_COMPLETE;
			END_IF
		END_IF

	C234_FEEDMANAGER_INIT_RAISE_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS:
        IF bFirstPass THEN
			psmCrossFeedFenceHeightCyl^.cmd_bExtend := TRUE;
			psmCrossFeedTransferHeightCyl^.cmd_bExtend := TRUE;
		END_IF
        IF bCrossfeedCylsExtended OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
			machineState := C234_FEEDMANAGER_INIT_START_MOTOR;			
		END_IF

	C234_FEEDMANAGER_INIT_START_MOTOR:
        IF bFirstPass THEN
			IF di_CSideDoorFeedEye THEN
				goFwd(); // invert direction when crossing.
			ELSIF di_DSideDoorFeedEye THEN
				goRev(); // invert direction when crossing.
			END_IF
			crossSlow();
		END_IF
        IF rtrigMoving.Q THEN
			machineState := C234_FEEDMANAGER_INIT_FIND_C_OR_D_EYE_FALLING_EDGE;
		END_IF

	C234_FEEDMANAGER_INIT_FIND_C_OR_D_EYE_FALLING_EDGE:
	 	IF bFirstPass THEN
			ftrigCorDEyeFallingEdge(CLK:=TRUE);
			tofCorDEyeFallingEdgeTimer(IN:=FALSE, PT:=config_tCorDEyeFallingEdgeTime);		
		END_IF
		tofCorDEyeFallingEdgeTimer(IN:=di_CSideDoorFeedEye OR di_DSideDoorFeedEye);
		ftrigCorDEyeFallingEdge(CLK:=tofCorDEyeFallingEdgeTimer.Q);
		IF ftrigCorDEyeFallingEdge.Q THEN
			machineState := C234_FEEDMANAGER_INIT_STOP_MOTOR;
		ELSIF tTimeInState > config_tFindCorDFeedEdgeTimeout THEN
			iErrorId := C234_FEEDMANAGER_FAILED_TO_FIND_FALLING_EDGE_OF_C_OR_D_FEED_EYE;
		END_IF

	C234_FEEDMANAGER_INIT_STOP_MOTOR:
        IF bFirstPass THEN
			stop();
		END_IF
        IF ftrigMoving.Q THEN
			machineState := C234_FEEDMANAGER_INIT_WAIT_FOR_ALL_CONVEYORS_INIT_COMPLETE;
		END_IF
		
	C234_FEEDMANAGER_INIT_WAIT_FOR_ALL_CONVEYORS_INIT_COMPLETE:
        IF cmd_bAllConveyorTablesInitCompleted THEN
			machineState := C234_FEEDMANAGER_FEEDIN_START;
		END_IF
		
	// feedin seq
	C234_FEEDMANAGER_FEEDIN_START:
		IF bFirstPass THEN
			IF config_bNoHardwareTestMode THEN
				di_OkToFeedOutSideA :=  FALSE;
				di_OkToFeedOutSideB :=  false;
				di_OkToFeedOutSideC :=  false;
				di_OkToFeedOutSideD :=  false;
			END_IF						
			status_bBusy := TRUE;
			bFeedinRunning := TRUE;
			setRotationRequired();
			ftrigSelfCenterComplete(CLK:=FALSE);
			ftrigRotateComplete(CLK:=FALSE);
			itfDoorTracker.setFeedInStarted();
		END_IF
		IF di_CSideDoorFeedEye OR di_DSideDoorFeedEye THEN
			machineState := C234_FEEDMANAGER_FEEDIN_COMPLETE;
		ELSIF config_bIsBufferTable THEN
			IF (bInitRunning OR bExternal) AND NOT di_ASideDoorSenseEye THEN
				machineState := C234_FEEDMANAGER_FEEDIN_REV_START_MOTOR;
			ELSE
				machineState := C234_FEEDMANAGER_FEEDIN_FWD_START_MOTOR;
			END_IF
		ELSIF cmd_bNext THEN
			machineState := C234_FEEDMANAGER_FEEDIN_LOWER_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS;
		END_IF

	C234_FEEDMANAGER_FEEDIN_LOWER_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS:
        IF bFirstPass THEN
			psmCrossFeedFenceHeightCyl^.cmd_bRetract := TRUE;
			psmCrossFeedTransferHeightCyl^.cmd_bRetract := TRUE;
		END_IF
        IF bCrossfeedCylsRetracted OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
			IF (bInitRunning OR bExternal) AND NOT di_ASideDoorSenseEye THEN
				machineState := C234_FEEDMANAGER_FEEDIN_REV_START_MOTOR;
			ELSE
				machineState := C234_FEEDMANAGER_FEEDIN_FWD_START_MOTOR;
			END_IF
		END_IF

	C234_FEEDMANAGER_FEEDIN_REV_START_MOTOR:
        IF bFirstPass THEN
			goRev();
			goSlow();
		END_IF
        IF rtrigMoving.Q OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
			machineState := C234_FEEDMANAGER_FEEDIN_REV_FIND_RISING_EDGE_OF_INFEED_EYE;
		END_IF
		
	C234_FEEDMANAGER_FEEDIN_REV_FIND_RISING_EDGE_OF_INFEED_EYE:
        IF bFirstPass THEN
			IF di_BSideDoorSenseEye THEN
				tOutfeedEndEyeDoorSearchTimeout := config_tInitOnOutfeedEndEyeDoorSearchTimeout;
			ELSE
				tOutfeedEndEyeDoorSearchTimeout := config_tInitNotOnOutfeedEndEyeDoorSearchTimeout;
			END_IF
		END_IF
		IF di_BSideDoorSenseEye THEN
			goFast();
		ELSE
			goSlow();
		END_IF
        IF di_ASideDoorSenseEye OR tTimeInState >= tOutfeedEndEyeDoorSearchTimeout THEN
			machineState := C234_FEEDMANAGER_FEEDIN_STOP;
		END_IF
		
	C234_FEEDMANAGER_FEEDIN_STOP:
        IF bFirstPass THEN
			stop();
			updateTableEmptyStatus();
			// do not call setTableEmptyStatus() yet. 
			// It will be called later in 'stop final' state below.
			// setTableEmptyStatus(bTableIsEmpty);
		END_IF
        IF ftrigMoving.Q OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
			IF NOT bTableIsEmpty THEN
				// Table has a door. Go fwd to center it.
				machineState := C234_FEEDMANAGER_FEEDIN_FWD_START_MOTOR;
			ELSE 
				machineState := C234_FEEDMANAGER_FEEDIN_COMPLETE;
			END_IF
		END_IF
		
	C234_FEEDMANAGER_FEEDIN_FWD_START_MOTOR:
        IF bFirstPass THEN
			goFwd();
			goFast();
		END_IF
        IF rtrigMoving.Q OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
			machineState := C234_FEEDMANAGER_FEEDIN_FIND_INFEED_EYE_FALLING_OR_DOORSTOP1_RISING;
		END_IF
	
	C234_FEEDMANAGER_FEEDIN_FIND_INFEED_EYE_FALLING_OR_DOORSTOP1_RISING:
		IF bFirstPass THEN
			ftrigInfeedEndDoorSenseEyeFallingEdge(CLK:=FALSE);
			rtrigDoorStopEye1RisingEdge(CLK:=FALSE);
			rtrigFeedinTimeout(CLK:=FALSE);		
			tofInfeedEndEyeValidTimer(IN:=FALSE, PT:=config_tInfeedEndEyeValidTime);							
		ELSE
			IF config_bNoHardwareTestMode THEN
				di_ASideDoorSenseEye :=  NOT (tTimeInState > T#1S);
				di_InMachineEye := tTimeInState > T#1S;
			END_IF
			tofInfeedEndEyeValidTimer(IN:=di_ASideDoorSenseEye);
			ftrigInfeedEndDoorSenseEyeFallingEdge(CLK:=tofInfeedEndEyeValidTimer.Q);
			rtrigDoorStopEye1RisingEdge(CLK:=di_DoorStop1Eye);
			IF cmd_bFeedIn THEN
				rtrigFeedinTimeout(CLK:=tTimeInState > config_tFeedinTimeout);
			ELSE 
				rtrigFeedinTimeout(CLK:=tTimeInState > config_tInitFeedinTimeout);
			END_IF
			IF ftrigInfeedEndDoorSenseEyeFallingEdge.Q THEN	
				IF NOT config_bIsBufferTable THEN
					// Not a buffer table (T1 option). Search for door-stop1 eye.
					machineState := C234_FEEDMANAGER_FEEDIN_DOORSTOP1_RISING;
				ELSE
					machineState := C234_FEEDMANAGER_FEEDIN_STOP_FINAL;
				END_IF
			ELSIF rtrigDoorStopEye1RisingEdge.Q THEN
				machineState := C234_FEEDMANAGER_FEEDIN_DOORSTOP3_RISING;
			ELSIF rtrigFeedinTimeout.Q THEN
				IF NOT bExternal THEN
					setTableEmptyStatus(TRUE);
				END_IF
				IF cmd_bFeedIn THEN
					iErrorId := C234_FEEDMANAGER_FEEDIN_FAILED_TO_FIND_STOP_EYE_1_RISING_EDGE_OR_INFEED_EYE;
				ELSE
					iErrorId := C234_FEEDMANAGER_INIT_FAILED_TO_FIND_STOP_EYE_1_RISING_EDGE_OR_INFEED_EYE;
				END_IF
			END_IF
		END_IF
		
	C234_FEEDMANAGER_FEEDIN_DOORSTOP1_RISING:
		IF bFirstPass THEN
			goSlow();
			rtrigDoorStopEye1RisingEdge(CLK:=FALSE);						
		ELSE
			IF config_bNoHardwareTestMode THEN
				di_DoorStop1Eye := tTimeInState > T#1S;
			END_IF
			rtrigDoorStopEye1RisingEdge(CLK:=di_DoorStop1Eye);
			IF rtrigDoorStopEye1RisingEdge.Q THEN
				IF di_InMachineEye THEN
					machineState := C234_FEEDMANAGER_FEEDIN_IN_MACHINE_EYE_FALLING;
				ELSE
					machineState := C234_FEEDMANAGER_FEEDIN_STOP_FINAL;
				END_IF
			ELSIF tTimeInState > config_tFeedinTimeout1 THEN
				iErrorId := C234_FEEDMANAGER_FAILED_TO_FIND_STOP_EYE_1_RISING_EDGE;
			END_IF
		END_IF
		
	C234_FEEDMANAGER_FEEDIN_DOORSTOP3_RISING:
		IF bFirstPass THEN
			goSlow();
			rtrigDoorStopEye3RisingEdge(CLK:=FALSE);			
		ELSE
			IF config_bNoHardwareTestMode THEN
				di_DoorStop3Eye := tTimeInState > T#1S;
			END_IF
			rtrigDoorStopEye3RisingEdge(CLK:=di_DoorStop3Eye);
			IF rtrigDoorStopEye3RisingEdge.Q THEN
				machineState := C234_FEEDMANAGER_FEEDIN_STOP_FINAL;
			ELSIF tTimeInState > config_tFeedinTimeout2 THEN
				iErrorId := C234_FEEDMANAGER_FAILED_TO_FIND_STOP_EYE_3_RISING_EDGE;
			END_IF	
		END_IF
		
	C234_FEEDMANAGER_FEEDIN_IN_MACHINE_EYE_FALLING:
		IF bFirstPass THEN
			ftrigInMachineEye(CLK:=TRUE);			
		ELSE
			IF config_bNoHardwareTestMode THEN
				di_InMachineEye := NOT (tTimeInState > T#1S);
			END_IF
			ftrigInMachineEye(CLK:=di_InMachineEye);
			IF ftrigInMachineEye.Q THEN
				machineState := C234_FEEDMANAGER_FEEDIN_STOP_FINAL;
			ELSIF tTimeInState > config_tFeedinInMachineEye THEN
				iErrorId := C234_FEEDMANAGER_FAILED_TO_FIND_IN_MACHINE_EYE;
			END_IF
		END_IF
		
	C234_FEEDMANAGER_FEEDIN_STOP_FINAL:
        IF bFirstPass THEN
			stop();
			do_OkToFeedInSideA := FALSE;
			itfDoorTracker.setDoorDataReadyLatch(FALSE);
						
			IF config_bNoHardwareTestMode THEN
				cmd_eIncomingDoorHand := E_DOORHAND.DOORHAND_NO_HAND;
				di_DoorStop1Eye := FALSE;
				di_DoorStop3Eye := FALSE;
				IF cmd_bFeedInHasDoorTest THEN
					cmd_bFeedInHasDoorTest := FALSE;
					di_InMachineEye := TRUE;					
				END_IF
			END_IF
			IF NOT bExternal THEN
					updateTableEmptyStatus();
					IF config_bIsBufferTable THEN
						// For buffer table (T1 option), door was found on rising and falling edge of SideA eye, so
						// door must be in the middle of table without seeing either SideA or SideB eye.
						bTableIsEmpty := FALSE; 
					END_IF
					setTableEmptyStatus(bTableIsEmpty);	
				END_IF
		END_IF
        IF ftrigMoving.Q OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
			IF bDoorInMachine AND 
				bRotateRequired AND 
				NOT bInitRunning AND
				NOT config_bIsBufferTable THEN
				machineState := C234_FEEDMANAGER_FEEDIN_CENTER_DOOR_PRE_ROTATE;
			ELSE
				machineState := C234_FEEDMANAGER_FEEDIN_COMPLETE;
			END_IF
		END_IF
		
	C234_FEEDMANAGER_FEEDIN_CENTER_DOOR_PRE_ROTATE:
		IF bFirstPass THEN
			smSelfCenterManager.cmd_bSelfCenter := TRUE;
			ftrigSelfCenterComplete(CLK:=FALSE);			
		ELSE
			ftrigSelfCenterComplete(CLK:=smSelfCenterManager.status_bBusy);
			IF ftrigSelfCenterComplete.Q OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
				machineState := C234_FEEDMANAGER_FEEDIN_ROTATE_DOOR;
			END_IF
		END_IF
		
	C234_FEEDMANAGER_FEEDIN_ROTATE_DOOR:
		IF bFirstPass THEN
			smRotateManager.cmd_bRotate := TRUE;			
			ftrigRotateComplete(CLK:=FALSE);
			pstDoorTrack^.DoorIsRotating := TRUE;
			pstDoorTrack^.DoorWasRotated := FALSE;
		ELSE
			ftrigRotateComplete(CLK:=smRotateManager.status_bBusy);
			IF ftrigRotateComplete.Q THEN
				pstDoorTrack^.DoorIsRotating := FALSE;
				pstDoorTrack^.DoorWasRotated := TRUE;
				machineState := C234_FEEDMANAGER_FEEDIN_COMPLETE;								
			END_IF
		END_IF
		
	C234_FEEDMANAGER_FEEDIN_COMPLETE:
		IF bFirstPass THEN
			do_OkToFeedInSideA := FALSE;
		ELSE
			IF di_CSideDoorFeedEye OR di_DSideDoorFeedEye THEN
				iErrorId := C234_FEEDMANAGER_C_AND_D_FEED_EYES_MUST_BE_CLEAR;
			ELSE
				machineState := C234_FEEDMANAGER_ALIGN_START;
			END_IF
		END_IF
	
	C234_FEEDMANAGER_ALIGN_START:
        IF bFirstPass THEN
			bAlignRunning := TRUE;
			status_bBusy := TRUE;
			tonDoorArrivedAtFenceWaitTimer(IN:=FALSE, PT:=config_tDoorAtFenceWaitTime);			
		END_IF
		IF config_bIsBufferTable OR
			NOT (bDoorInMachine OR bExternal) OR 
			di_CSideDoorFeedEye OR
			di_DSideDoorFeedEye THEN
			machineState := C234_FEEDMANAGER_ALIGN_COMPLETE;
		ELSIF config_eFeedoutAligned = E_FeedoutAligned.CenterFence THEN
			machineState := C234_FEEDMANAGER_ALIGN_CENTER_DOOR;
		ELSIF cmd_bNext THEN
			machineState := C234_FEEDMANAGER_ALIGN_RAISE_CROSS_FEED_FENCE_AND_LOWER_TRANSFER_HEIGHT_CYLS;
		END_IF
		
	C234_FEEDMANAGER_ALIGN_RAISE_CROSS_FEED_FENCE_AND_LOWER_TRANSFER_HEIGHT_CYLS:
        IF bFirstPass THEN
			psmCrossFeedFenceHeightCyl^.cmd_bExtend := TRUE;
			psmCrossFeedTransferHeightCyl^.cmd_bRetract := TRUE;
		END_IF
        IF psmCrossFeedFenceHeightCyl^.status_bExtended AND psmCrossFeedTransferHeightCyl^.status_bRetracted OR 
			(config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
			machineState := C234_FEEDMANAGER_ALIGN_START_MOTOR;
		END_IF

	C234_FEEDMANAGER_ALIGN_START_MOTOR:
        IF bFirstPass THEN
			IF config_eFeedoutAligned = E_FeedoutAligned.NearFence THEN
				goFwd(); // invert direction when crossing.
			ELSIF config_eFeedoutAligned = E_FeedoutAligned.FarFence THEN
				goRev(); // invert direction when crossing.
			END_IF
			crossSlow();
		END_IF
        IF rtrigMoving.Q OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
			machineState := C234_FEEDMANAGER_ALIGN_FIND_FENCE_DOOR_SENSE_EYE_RISING_EDGE;
		END_IF

	C234_FEEDMANAGER_ALIGN_FIND_FENCE_DOOR_SENSE_EYE_RISING_EDGE:
        IF bFirstPass THEN
			rtrigAtFenceEye(CLK:=FALSE);
			IF (di_AtNearFenceEye AND di_AtFarFenceEye) OR
				(di_AtNearFenceEye AND config_eFeedoutAligned = E_FeedoutAligned.NearFence) OR
				(di_AtFarFenceEye AND config_eFeedoutAligned = E_FeedoutAligned.FarFence)
			THEN
				tFindDoorAtFenceEyeTimeout := config_tFindDoorAtFenceEyeShortTimeout;
			ELSE
				tFindDoorAtFenceEyeTimeout := config_tFindDoorAtFenceEyeLongTimeout;
			END_IF
		ELSE
			IF config_eFeedoutAligned = E_FeedoutAligned.NearFence THEN
				rtrigAtFenceEye(CLK:=di_AtNearFenceEye);
			ELSIF config_eFeedoutAligned = E_FeedoutAligned.FarFence THEN
				rtrigAtFenceEye(CLK:=di_AtFarFenceEye);
			END_IF
			IF rtrigAtFenceEye.Q OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
				machineState := C234_FEEDMANAGER_ALIGN_WAIT_FOR_AT_FENCE_POS;
			ELSIF tTimeInState > tFindDoorAtFenceEyeTimeout THEN
				iErrorId := C234_FEEDMANAGER_FAILED_TO_FIND_FENCE_EYE_RISING_EDGE;
			END_IF
		END_IF
	
	C234_FEEDMANAGER_ALIGN_WAIT_FOR_AT_FENCE_POS:
        IF bFirstPass THEN
			tonDoorArrivedAtFenceWaitTimer(IN:=FALSE, PT:=config_tDoorAtFenceWaitTime);
		END_IF
		tonDoorArrivedAtFenceWaitTimer(IN:=TRUE);
        IF tonDoorArrivedAtFenceWaitTimer.Q OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
			machineState := C234_FEEDMANAGER_ALIGN_STOP_MOTOR;
		END_IF
	
	C234_FEEDMANAGER_ALIGN_STOP_MOTOR:
        IF bFirstPass THEN
			stop();
		END_IF
        IF ftrigMoving.Q OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
			machineState := C234_FEEDMANAGER_ALIGN_LOWER_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS;
		END_IF

	C234_FEEDMANAGER_ALIGN_LOWER_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS:
		 IF bFirstPass THEN
			psmCrossFeedFenceHeightCyl^.cmd_bRetract := TRUE;
			psmCrossFeedTransferHeightCyl^.cmd_bRetract := TRUE;
		END_IF
        IF bCrossfeedCylsRetracted OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
			machineState := C234_FEEDMANAGER_ALIGN_COMPLETE;
		END_IF

	C234_FEEDMANAGER_ALIGN_CENTER_DOOR:
		IF bFirstPass THEN
			smSelfCenterManager.cmd_bSelfCenter := TRUE;
			ftrigSelfCenterComplete(CLK:=smSelfCenterManager.status_bBusy);
		end_if
		ftrigSelfCenterComplete(CLK:=smSelfCenterManager.status_bBusy);
		IF ftrigSelfCenterComplete.Q OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
			machineState := C234_FEEDMANAGER_ALIGN_COMPLETE;
		END_IF
	
	C234_FEEDMANAGER_ALIGN_COMPLETE:
		IF bFirstPass THEN
			pstTable^.cmd_bFeedinCompleted := TRUE;
		ELSE
			IF bExternal THEN
				machineState := C234_FEEDMANAGER_EXTERNAL;
			ELSE
				machineState := C234_FEEDMANAGER_AUTOFEED_ON;
			END_IF
		END_IF
		
	// feedout seq
	C234_FEEDMANAGER_FEEDOUT_START:
        IF bFirstPass THEN
			status_bBusy := TRUE;
			bFeedoutRunning := TRUE;
			cmd_bFeedOut := FALSE;
			pstTable^.cmd_bFeedoutStarted := TRUE;			
		END_IF
		IF pdi_OkToFeedout=0 OR pdi_OutfeedEndDoorSenseEye=0 THEN
			machineState := C234_FEEDMANAGER_FEEDOUT_COMPLETE;
		ELSIF config_bIsBufferTable THEN
			machineState := C234_FEEDMANAGER_FEEDOUT_START_MOTOR;
		ELSIF cmd_eFeedoutSide=E_FeedoutSideType.C OR
			cmd_eFeedoutSide=E_FeedoutSideType.D THEN
			machineState := C234_FEEDMANAGER_FEEDOUT_RAISE_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS;
		ELSIF cmd_eFeedoutSide=E_FeedoutSideType.A OR
			cmd_eFeedoutSide=E_FeedoutSideType.B THEN
			machineState := C234_FEEDMANAGER_FEEDOUT_LOWER_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS;
		END_IF	
			
	C234_FEEDMANAGER_FEEDOUT_RAISE_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS:
        IF bFirstPass THEN
			psmCrossFeedFenceHeightCyl^.cmd_bExtend := TRUE;
			psmCrossFeedTransferHeightCyl^.cmd_bExtend := TRUE;
		END_IF
        IF bCrossfeedCylsExtended OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
			machineState := C234_FEEDMANAGER_FEEDOUT_START_MOTOR;			
		END_IF
	
	C234_FEEDMANAGER_FEEDOUT_LOWER_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS:
        IF bFirstPass THEN
			psmCrossFeedFenceHeightCyl^.cmd_bRetract := TRUE;
			psmCrossFeedTransferHeightCyl^.cmd_bRetract := TRUE;
		END_IF
         IF bCrossfeedCylsRetracted OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S)THEN
			machineState := C234_FEEDMANAGER_FEEDOUT_START_MOTOR;
		END_IF
		
	C234_FEEDMANAGER_FEEDOUT_START_MOTOR:
        IF bFirstPass THEN
			feedoutStartMotor();
			feedoutSetMotorSpeed();
		END_IF
        IF rtrigMoving.Q OR (config_bNoHardwareTestMode AND tTimeInState>T#5.25S) THEN
			machineState := C234_FEEDMANAGER_FEEDOUT_FIND_OUTFEED_END_DOOR_SENSE_EYE_RISING_EDGE;
		END_IF

	C234_FEEDMANAGER_FEEDOUT_FIND_OUTFEED_END_DOOR_SENSE_EYE_RISING_EDGE:
        IF bFirstPass THEN
			rtrigOutfeedEndDoorSenseEyesRisingEdge(CLK:=FALSE);
		END_IF
		IF config_bNoHardwareTestMode THEN
			pdi_OutfeedEndDoorSenseEye^ := tTimeInState > T#1S;
		END_IF
		rtrigOutfeedEndDoorSenseEyesRisingEdge(CLK:=pdi_OutfeedEndDoorSenseEye^);
		IF tTimeInState > config_tFindOutfeedEndEyeTimeout THEN
			iErrorId := C234_FEEDMANAGER_FAILED_TO_FIND_OUTFEED_END_EYE;
		END_IF
        IF rtrigOutfeedEndDoorSenseEyesRisingEdge.Q OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
			IF pdi_OkToFeedOut^ THEN
				machineState := C234_FEEDMANAGER_FEEDOUT_FIND_OUTFEED_END_DOOR_SENSE_EYE_FALLING_EDGE;
			ELSE
				machineState := C234_FEEDMANAGER_FEEDOUT_STOP_MOTOR;
			END_IF
		END_IF

	C234_FEEDMANAGER_FEEDOUT_STOP_MOTOR:
        IF bFirstPass THEN
			stop();
		END_IF
		IF ftrigMoving.Q OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
			machineState := C234_FEEDMANAGER_FEEDOUT_WAIT_FOR_OK_TO_FEEDOUT;
		END_IF

	C234_FEEDMANAGER_FEEDOUT_WAIT_FOR_OK_TO_FEEDOUT:
        IF bFirstPass THEN
			rtrigReadyToFeedOut(CLK:=FALSE);
		END_IF
		IF config_bNoHardwareTestMode THEN
			di_OkToFeedOutSideA :=  tTimeInState > T#1S;
			di_OkToFeedOutSideB :=  tTimeInState > T#1S;
			di_OkToFeedOutSideC :=  tTimeInState > T#1S;
			di_OkToFeedOutSideD :=  tTimeInState > T#1S;
		END_IF
		rtrigReadyToFeedOut(CLK:=pdi_OkToFeedOut^);
		updateTableEmptyStatus();
		IF bTableIsEmpty THEN
			machineState := C234_FEEDMANAGER_FEEDOUT_COMPLETE;
		ELSIF rtrigReadyToFeedOut.Q THEN
			machineState := C234_FEEDMANAGER_FEEDOUT_RESTART_MOTOR;
		END_IF
		
	C234_FEEDMANAGER_FEEDOUT_RESTART_MOTOR:
        IF bFirstPass THEN
			feedoutStartMotor();
			feedoutSetMotorSpeed();
		END_IF
        IF rtrigMoving.Q OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
			machineState := C234_FEEDMANAGER_FEEDOUT_FIND_OUTFEED_END_DOOR_SENSE_EYE_FALLING_EDGE;
		END_IF

	C234_FEEDMANAGER_FEEDOUT_FIND_OUTFEED_END_DOOR_SENSE_EYE_FALLING_EDGE:
		IF config_bNoHardwareTestMode THEN
			di_InMachineEye :=  NOT (tTimeInState > T#1S);
			di_ASideDoorSenseEye :=  NOT (tTimeInState > T#1S); 
			di_BSideDoorSenseEye :=  NOT (tTimeInState > T#1S);	
		END_IF
		updateTableEmptyStatus();
        IF bTableIsEmpty THEN
			machineState := C234_FEEDMANAGER_FEEDOUT_STOP_MOTOR_FINAL;
		ELSIF NOT pdi_OkToFeedOut^ THEN
			machineState := C234_FEEDMANAGER_FEEDOUT_STOP_MOTOR;
		END_IF

	C234_FEEDMANAGER_FEEDOUT_STOP_MOTOR_FINAL:
        IF bFirstPass THEN
			stop();
		END_IF
        IF ftrigMoving.Q OR (config_bNoHardwareTestMode AND tTimeInState>T#0.25S) THEN
			machineState := C234_FEEDMANAGER_FEEDOUT_COMPLETE;
		END_IF

	C234_FEEDMANAGER_FEEDOUT_COMPLETE:
		IF bFirstPass THEN
			IF config_bNoHardwareTestMode THEN
				di_OkToFeedOutSideA :=  FALSE;
				di_OkToFeedOutSideB :=  false;
				di_OkToFeedOutSideC :=  false;
				di_OkToFeedOutSideD :=  false;
			END_IF
			updateTableEmptyStatus();
			IF bTableIsEmpty THEN
				setTableEmptyStatus(TRUE);
				pstTable^.clearDoorTrack();
				iFeedoutDoorsCount := iFeedoutDoorsCount + 1;
			END_IF
			pstTable^.cmd_bFeedoutCompleted := TRUE;
		END_IF
		machineState := C234_FEEDMANAGER_AUTOFEED_ON;
		
	C234_FEEDMANAGER_ERROR:
		IF bFirstPass THEN
			status_bBusy := FALSE;
			cmd_bInlineTransferFwd := FALSE;
			cmd_bInlineTransferRev := FALSE;
			cmd_bFeedIn := FALSE;
			cmd_bFeedOut := FALSE;
			do_OkToFeedInSideA := FALSE;
			do_OkToFeedInSideB := FALSE;
			do_OkToFeedInSideC := FALSE;
			do_OkToFeedInSideD := FALSE;
			bExternal := FALSE;
			bInitRunning := FALSE;
			bFeedinRunning := FALSE;
			bSelfCenterRunning := FALSE;
			bRotateRunning := FALSE;
			bAlignRunning := FALSE;
			bFeedoutRunning := FALSE;
			stop();
		END_IF
		IF NOT cmd_bEnable THEN
			machineState := C234_FEEDMANAGER_DISABLED;
		ELSIF cmd_bReset THEN
			clearLastError();
			machineState := C234_FEEDMANAGER_AUTOFEED_OFF;
		END_IF








END_CASE
]]></ST>
      </Implementation>
    </Method>
