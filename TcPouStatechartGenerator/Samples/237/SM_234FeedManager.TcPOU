    <Method Name="getStateDescription" Id="{15b7f27f-d611-4c41-a1b8-0d471853890a}">
      <Declaration><![CDATA[METHOD getStateDescription : STRING

]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE machineState OF
	

	C234_FEEDMANAGER_DISABLED:
		getStateDescription := 'Disabled';

	C234_FEEDMANAGER_ENABLING:
		getStateDescription := 'Enabling';
		
	C234_FEEDMANAGER_AUTOFEED_OFF:
		getStateDescription := 'Autofeed Off';
		
	C234_FEEDMANAGER_AUTOFEED_ON:
		IF bOkToFeedIn THEN
			getStateDescription := 'Autofeed On - Ok to Feed In';
		ELSIF bReadyToFeedOut THEN
			getStateDescription := 'Autofeed On - Ready to Feed Out';
		ELSE
			getStateDescription := 'Autofeed On';
		END_IF
		
	C234_FEEDMANAGER_TEST_TOGGLE_HAS_DOOR:
		getStateDescription := 'Test Toggle Has Door';
	
	C234_FEEDMANAGER_EXTERNAL:
		getStateDescription := 'External';
		
	C234_FEEDMANAGER_EXTERNAL_RAISE_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS:
		getStateDescription := 'Raising Cross Cylinders';
		
	C234_FEEDMANAGER_EXTERNAL_LOWER_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS:
		getStateDescription := 'Lowering Cross Cylinders';
		
	C234_FEEDMANAGER_JOG_LOWER_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS:
		getStateDescription := 'Lowering Cross Cylinders';
		
	C234_FEEDMANAGER_INLINE_JOGGING:
		getStateDescription := 'Inline Jogging';
		
	C234_FEEDMANAGER_JOG_RAISE_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS:
		getStateDescription := 'Raising Cross Cylinders';
		
	C234_FEEDMANAGER_CROSS_JOGGING:
		getStateDescription := 'Cross Jogging';
		
	C234_FEEDMANAGER_JOG_RAISE_CROSS_FEED_FENCE_AND_LOWER_TRANSFER_HEIGHT_CYLS:
		getStateDescription := 'Raising Cross and Lower Transfer Height Cylinders';
		
	C234_FEEDMANAGER_TO_FENCE_JOGGING:
		getStateDescription := 'To-Fence Jogging';

	C234_FEEDMANAGER_ROTATE_LOWER_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS:
		getStateDescription := 'Lowering Cross Cylinders';
		
	C234_FEEDMANAGER_ROTATE:
		getStateDescription := 'Rotating';
		
	C234_FEEDMANAGER_SELF_CENTER_LOWER_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS:
		getStateDescription := 'Lowering Cross Cylinders';
		
	C234_FEEDMANAGER_SELF_CENTER:
		getStateDescription := 'Door Centering';
		
	C234_FEEDMANAGER_INIT_START:
		getStateDescription := 'Init Starts';
		
	C234_FEEDMANAGER_INIT_RAISE_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS:
		getStateDescription := 'Raising Cross Cylinders';
		
	C234_FEEDMANAGER_INIT_START_MOTOR:
		getStateDescription := 'Starting Motor';
		
	C234_FEEDMANAGER_INIT_FIND_C_OR_D_EYE_FALLING_EDGE:
		getStateDescription := 'Finding Feed C or D Eye';
		
	C234_FEEDMANAGER_INIT_STOP_MOTOR:
		getStateDescription := 'Stopping Motor';
		
	C234_FEEDMANAGER_INIT_WAIT_FOR_ALL_CONVEYORS_INIT_COMPLETE:
		getStateDescription := 'Wait for All Conveyors Init Complete';
		
		
	C234_FEEDMANAGER_FEEDIN_START:
		getStateDescription := 'Feed-in Starts';
		
	C234_FEEDMANAGER_FEEDIN_LOWER_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS:
		getStateDescription := 'Lowering Cross Cylinders';
		
	C234_FEEDMANAGER_FEEDIN_REV_START_MOTOR:
		getStateDescription := 'Starting Motor in Reverse';
		
	C234_FEEDMANAGER_FEEDIN_REV_FIND_RISING_EDGE_OF_INFEED_EYE:
		getStateDescription := 'Finding Infeed-End Eye Rising Edge';
		
	C234_FEEDMANAGER_FEEDIN_STOP:
		getStateDescription := 'Feed-in Stopping';
		
	C234_FEEDMANAGER_FEEDIN_FWD_START_MOTOR:
		getStateDescription := 'Starting Motor';
		
	C234_FEEDMANAGER_FEEDIN_FIND_INFEED_EYE_FALLING_OR_DOORSTOP1_RISING:
		getStateDescription := 'Finding Infeed-End or Door Stop 1 Eye';
		
	C234_FEEDMANAGER_FEEDIN_DOORSTOP1_RISING:
		getStateDescription := 'Finding Door Stop 1 Eye';
		
	C234_FEEDMANAGER_FEEDIN_DOORSTOP3_RISING:
		getStateDescription := 'Finding Door Stop 3 Eye';
		
	C234_FEEDMANAGER_FEEDIN_IN_MACHINE_EYE_FALLING:
		getStateDescription := 'Finding Falling-Edge of In-Machine Eye';
	
	C234_FEEDMANAGER_FEEDIN_STOP_FINAL:
		getStateDescription := 'Stopping Motor';
		
	C234_FEEDMANAGER_FEEDIN_CENTER_DOOR_PRE_ROTATE:
		getStateDescription := 'Centering Door Prior to Rotate';
		
	C234_FEEDMANAGER_FEEDIN_ROTATE_DOOR:
		getStateDescription := 'Rotating Door';
		
	C234_FEEDMANAGER_FEEDIN_COMPLETE:
		getStateDescription := 'Feed-in Complete';

	C234_FEEDMANAGER_ALIGN_START:
		getStateDescription := 'Align and Feed-out Starts';
		
	C234_FEEDMANAGER_ALIGN_RAISE_CROSS_FEED_FENCE_AND_LOWER_TRANSFER_HEIGHT_CYLS:
		getStateDescription := 'Raising Cross Cylinders';
		
	C234_FEEDMANAGER_ALIGN_START_MOTOR:
		getStateDescription := 'Starting Motor';
		
	C234_FEEDMANAGER_ALIGN_FIND_FENCE_DOOR_SENSE_EYE_RISING_EDGE:
		getStateDescription := 'Finding Fence Door Sense Eye';
		
	C234_FEEDMANAGER_ALIGN_WAIT_FOR_AT_FENCE_POS:
		getStateDescription := 'Waiting for Door to Arrive at Fence Position';
	
	C234_FEEDMANAGER_ALIGN_STOP_MOTOR:
		getStateDescription := 'Stopping Motor';
		
	C234_FEEDMANAGER_ALIGN_LOWER_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS:
		getStateDescription := 'Lowering Cross Cylinders';
		
	C234_FEEDMANAGER_ALIGN_CENTER_DOOR:
		getStateDescription := 'Centering Door';
		
	C234_FEEDMANAGER_ALIGN_COMPLETE:
		getStateDescription := 'Align Complete';

	C234_FEEDMANAGER_FEEDOUT_START:
		getStateDescription := 'Feed-out Starts';
		
	C234_FEEDMANAGER_FEEDOUT_RAISE_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS:
		getStateDescription := 'Raising Cross Cylinders';	
		
	C234_FEEDMANAGER_FEEDOUT_LOWER_CROSS_FEED_FENCE_AND_TRANSFER_HEIGHT_CYLS:
		getStateDescription := 'Lowering Cross Cylinders';
		
	C234_FEEDMANAGER_FEEDOUT_START_MOTOR:
		getStateDescription := 'Starting Motor';
		
	C234_FEEDMANAGER_FEEDOUT_FIND_OUTFEED_END_DOOR_SENSE_EYE_RISING_EDGE:
		getStateDescription := 'Finding Outfeed-End Eye';
		
	C234_FEEDMANAGER_FEEDOUT_STOP_MOTOR:
		getStateDescription := 'Stopping Motor';
		
	C234_FEEDMANAGER_FEEDOUT_WAIT_FOR_OK_TO_FEEDOUT:
		getStateDescription := 'Waiting for OK to Feed Out';
		
	C234_FEEDMANAGER_FEEDOUT_RESTART_MOTOR:
		getStateDescription := 'Starting Motor';
		
	C234_FEEDMANAGER_FEEDOUT_FIND_OUTFEED_END_DOOR_SENSE_EYE_FALLING_EDGE:
		getStateDescription := 'Finding Outfeed-End Door Sense Eye';
		
	C234_FEEDMANAGER_FEEDOUT_STOP_MOTOR_FINAL:
		getStateDescription := 'Stopping Motor';
		
	C234_FEEDMANAGER_FEEDOUT_COMPLETE:
		getStateDescription := 'Feed-out Complete';
		
	C234_FEEDMANAGER_ERROR:
		getStateDescription := 'Error';
END_CASE

SUPER^.getStateDescription();
	]]></ST>
      </Implementation>
    </Method>
    <Method Name="initialize" Id="{1a82f989-738b-45ac-bc9f-52d263f74b91}">
      <Declaration><![CDATA[METHOD initialize

]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.initialize();		// must run first
descriptor.sModuleClass := 'Cross-Straight Feed Manager';

//IF config_bNoHardwareTestMode THEN
//	di_FeedoutModeSW := TRUE;
//END_IF

// In IO manager now
//addChildStateMachine('Cross-Feed-Fence-Height Cyl', ADR(psmCrossFeedFenceHeightCyl));
//	psmCrossFeedFenceHeightCyl.config_bUseExtendedInput := FALSE;
//	psmCrossFeedFenceHeightCyl.config_bUseRetractedInput := FALSE;
//	psmCrossFeedFenceHeightCyl.config_tExtendTime := T#1.0S;
//	psmCrossFeedFenceHeightCyl.config_tRetractTime := T#1.0S;

//addChildStateMachine('Cross-Feed-Transfer-Height Cyl', ADR(psmCrossFeedTransferHeightCyl));
//	psmCrossFeedTransferHeightCyl.config_bUseExtendedInput := FALSE;
//	psmCrossFeedTransferHeightCyl.config_bUseRetractedInput := FALSE;
//	psmCrossFeedTransferHeightCyl.config_tExtendTime := T#1.0S;
//	psmCrossFeedTransferHeightCyl.config_tRetractTime := T#1.0S;	
		
IF config_bCanRotate THEN
	// Option A (auto-rotate). Only run this state machine if Option A is installed.
	addChildStateMachine('Rotate Manager',ADR(smRotateManager));
		smRotateManager(
			config_bNoHardwareTestMode := config_bNoHardwareTestMode
		);
END_IF

IF config_bCanSelfCenter THEN
	// Option S (self-center). Only add this state machine if Option S is installed.
	addChildStateMachine('Self-Center Manager',ADR(smSelfCenterManager));
		smSelfCenterManager(
			config_bNoHardwareTestMode := config_bNoHardwareTestMode
		);
END_IF	

]]></ST>
      </Implementation>
    </Method>
    <Method Name="isTableEmpty" Id="{17b4c1b7-78a7-4f06-9d3c-e2ea5d004a76}">
      <Declaration><![CDATA[METHOD isTableEmpty : bool
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[isTableEmpty := 
		NOT (
		di_InMachineEye OR
		di_ASideDoorSenseEye OR 
		di_BSideDoorSenseEye OR
		di_CSideDoorFeedEye OR
		di_DSideDoorFeedEye OR
		di_AtNearFenceEye OR
		di_AtFarFenceEye OR
		di_DoorStop1Eye OR
		di_DoorStop3Eye)
		;]]></ST>
      </Implementation>
    </Method>
    <Method Name="postProcess" Id="{6a82d0bf-ecbb-4165-b4e2-33a45c0d701e}">
      <Declaration><![CDATA[METHOD postProcess
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.postProcess();
cmd_bAbort := FALSE;
cmd_bReset := FALSE;
cmd_bRotate := FALSE;
cmd_bSelfCenter := FALSE;
cmd_bAlign := FALSE;
cmd_bInit := FALSE;
cmd_bExternal := FALSE;
cmd_bInternal := FALSE;
cmd_bRaiseCrossCyls := FALSE;
cmd_bLowerCrossCyls := FALSE;
cmd_bDoorDataReady := FALSE;
cmd_bTestToggleHasDoor := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="preProcess" Id="{6725ecf3-ae81-46de-9298-467dcfdee35f}">
      <Declaration><![CDATA[(* this method is run before the doState is run*)
METHOD preProcess]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.preProcess();

iCurDestinationIndex := destinationDigitalInputsToDestinationIndex();
IF iCurDestinationIndex <> iLastDestinationIndex THEN
	iLastDestinationIndex := iCurDestinationIndex;
	cmd_iSelectedDestinationIndex := iCurDestinationIndex;
END_IF

IF di_DoorDataReady <> bLastDoorDataReady THEN
	bLastDoorDataReady := di_DoorDataReady;
	cmd_bDoorDataReady := bLastDoorDataReady;
END_IF

IF bLastIncomingDoorLH <> di_IncomingDoorLH OR bLastIncomingDoorRH <> di_IncomingDoorRH THEN
	bLastIncomingDoorLH := di_IncomingDoorLH;
	bLastIncomingDoorRH := di_IncomingDoorRH;
	
	IF bLastIncomingDoorLH XOR bLastIncomingDoorRH THEN
		IF bLastIncomingDoorLH THEN
			cmd_eIncomingDoorHand := E_DOORHAND.DOORHAND_LEFT;
		ELSE
			cmd_eIncomingDoorHand := E_DOORHAND.DOORHAND_RIGHT;
		END_IF
	ELSE
		cmd_eIncomingDoorHand := E_DOORHAND.DOORHAND_NO_HAND;
	END_IF
END_IF

bIncomingDoorHandValid := cmd_eIncomingDoorHand <> E_DOORHAND.DOORHAND_NO_HAND;

itfDoorTracker.setDestinationIndex(cmd_iSelectedDestinationIndex);
itfDoorTracker.setIncomingDoorHand(cmd_eIncomingDoorHand);
itfDoorTracker.setDoorDataReady(cmd_bDoorDataReady);

bCrossfeedCylsRetracted := 
	psmCrossFeedFenceHeightCyl^.status_bRetracted AND psmCrossFeedTransferHeightCyl^.status_bRetracted;
bCrossfeedCylsExtended := 
	psmCrossFeedFenceHeightCyl^.status_bExtended AND psmCrossFeedTransferHeightCyl^.status_bExtended;
	
bDoorDataAck := do_DoorDataAck;

bOkToFeedIn := 
	NOT (
	di_InMachineEye OR
	di_BSideDoorSenseEye OR
	di_CSideDoorFeedEye OR
	di_DSideDoorFeedEye OR
	di_AtNearFenceEye OR
	di_AtFarFenceEye OR
	di_DoorStop1Eye OR
	di_DoorStop3Eye OR
	status_bBusy OR 
	bInitRunning OR
	bExternal
	) AND 
	config_bInputPort AND
	pstTable^.bRouteReadyWaitForFeedIn AND
	pstTable^.cmd_bIncomingDoorHandValid AND
	cmd_bAutoFeedOn;
	
// only triggered if not in External state.
rtrigInfeedEndDoorSenseEyeRisingEdge(CLK:=di_ASideDoorSenseEye AND NOT bExternal);
IF rtrigInfeedEndDoorSenseEyeRisingEdge.Q THEN
	cmd_bFeedIn := bOkToFeedIn; // precondition to start feed-in seq. 
END_IF

bReadyToFeedOut := 
	config_bOutputPort AND 
	config_bOutputPortEnabled AND
	bDoorInMachine AND 
	cmd_bAutoFeedOn AND 
	pstTable^.bDoorWaitingForFeedOut AND
	NOT (status_bBusy OR bExternal)
	;
rtrigFeedout(CLK:=
	bReadyToFeedOut AND
	((config_bOutfeedSideA_Enabled AND di_OkToFeedOutSideA AND isFeedoutSideInDestinationsFeedoutPortsMapping(E_FeedoutSideType.A) AND NOT di_DisableFeedoutSideA) OR 
	 (config_bOutfeedSideB_Enabled AND di_OkToFeedOutSideB AND isFeedoutSideInDestinationsFeedoutPortsMapping(E_FeedoutSideType.B) AND NOT di_DisableFeedoutSideB) OR
	 (config_bOutfeedSideC_Enabled AND di_OkToFeedOutSideC AND isFeedoutSideInDestinationsFeedoutPortsMapping(E_FeedoutSideType.C) AND NOT di_DisableFeedoutSideC) OR
	 (config_bOutfeedSideD_Enabled AND di_OkToFeedOutSideD AND isFeedoutSideInDestinationsFeedoutPortsMapping(E_FeedoutSideType.D) AND NOT di_DisableFeedoutSideD)))
	;
	
IF rtrigFeedout.Q THEN	
	cmd_bFeedout := checkFeedoutPreconditions(); 
END_IF

ftrigAutofeedOn(CLK:=cmd_bAutoFeedOn);

IF downstream.status_bDownstreamError THEN
	iErrorId := C234_FEEDMANAGER_DOWNSTREAM_ERROR;
END_IF

IF iErrorId <> 0 THEN
	raiseError(FALSE);
END_IF

IF NOT cmd_bEnable THEN
	IF machineState > C234_FEEDMANAGER_ENABLING AND
		machineState <= C234_FEEDMANAGER_ERROR THEN
		machineState := C234_FEEDMANAGER_DISABLED;
	END_IF	
ELSIF cmd_bAbort THEN
	IF bInitRunning OR bFeedinRunning OR bAlignRunning OR bFeedoutRunning THEN
		IF bAlignRunning AND bExternal THEN
			machineState := C234_FEEDMANAGER_EXTERNAL;
		ELSE
			machineState := C234_FEEDMANAGER_AUTOFEED_ON;
		END_IF
	END_IF	
ELSIF bError THEN
	IF machineState > C234_FEEDMANAGER_ENABLING AND
		machineState < C234_FEEDMANAGER_ERROR THEN
		machineState := C234_FEEDMANAGER_ERROR;
	END_IF	
ELSIF ftrigAutofeedOn.Q THEN
	IF machineState > C234_FEEDMANAGER_AUTOFEED_ON AND
		machineState < C234_FEEDMANAGER_ERROR THEN
		machineState := C234_FEEDMANAGER_AUTOFEED_ON;
	END_IF
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="raiseError" Id="{251b2b3f-3bca-444d-9b5d-fa3b9857a089}">
      <Declaration><![CDATA[METHOD raiseError
VAR_INPUT
	bSetError : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE iErrorId OF
	C234_FEEDMANAGER_FAILED_TO_FIND_FALLING_EDGE_OF_C_OR_D_FEED_EYE: 
		formatError('Failed to find falling edge of C or D feed eye', 'Turn Autofeed on and retry');
	C234_FEEDMANAGER_DOWNSTREAM_ERROR: 
		formatError('Downstream error', 'Reset machine');
	C234_FEEDMANAGER_FAILED_TO_FIND_OUTFEED_END_EYE: 
		formatError('Failed to find the outfeed-end eye', 'Turn Autofeed on and retry');
	C234_FEEDMANAGER_C_AND_D_FEED_EYES_MUST_BE_CLEAR: 
		formatError('C and D feed eyes must be clear', 'Turn Autofeed on and retry');
	C234_FEEDMANAGER_FEEDIN_FAILED_TO_FIND_STOP_EYE_1_RISING_EDGE_OR_INFEED_EYE: 
		formatError('Failed to find door-stop eye 1 rising edge or infeed eye falling edge during feed-in sequence', 'Turn Autofeed on and retry');
	C234_FEEDMANAGER_INIT_FAILED_TO_FIND_STOP_EYE_1_RISING_EDGE_OR_INFEED_EYE: 
		formatError('Failed to find door-stop eye 1 rising edge or infeed eye falling edge during init sequence', 'Turn Autofeed on and retry');
	C234_FEEDMANAGER_FAILED_TO_FIND_STOP_EYE_1_RISING_EDGE: 
		formatError('Failed to find door-stop eye 1 rising edge', 'Turn Autofeed on and retry');
	C234_FEEDMANAGER_FAILED_TO_FIND_STOP_EYE_3_RISING_EDGE: 
		formatError('Failed to find door-stop eye 3 rising edge', 'Turn Autofeed on and retry');		
	C234_FEEDMANAGER_FAILED_TO_FIND_IN_MACHINE_EYE: 
		formatError('Failed to find in-machine eye', 'Turn Autofeed on and retry');
	C234_FEEDMANAGER_FAILED_TO_FIND_FENCE_EYE_RISING_EDGE: 
		formatError('Failed to find fence eye rising edge', 'Turn Autofeed on and retry');
END_CASE
SUPER^.raiseError(bSetError);]]></ST>
      </Implementation>
    </Method>
    <Method Name="recordStateCallHistory" Id="{e598d84d-220c-4eb4-acca-e2dcd76e780d}" FolderPath="uml\">
      <Declaration><![CDATA[(* base implementation to record state calling history. 
 	Derrived FB's should override this method to replace the machine' specific type of eState *)
	
METHOD recordStateCallHistory
VAR_INPUT
	iState				: INT;
	iSubState			: INT;
END_VAR
VAR
	sCurTaskCycle 		: STRING;
    eState       		: E_234FeedManager_States; // todo: replace with the derrived STRUCT type (ie, E_HeadManager_States)
    eSubState			: E_SubState;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// DO NOT CHANGE BELOW!!!
// This was auto-generated by a Kval's UML tool.

sCurTaskCycle := TO_STRING(mainStateCallingData[iState, iSubState].nCycleIdFirstCall);
eState := iState;
eSubState := iSubState;

// Enter the state name into array
mainStateCallHistory[iStateCallHistoryIndex].sTaskCycle := sCurTaskCycle;
mainStateCallHistory[iStateCallHistoryIndex].sStateId := TO_STRING(iState);
mainStateCallHistory[iStateCallHistoryIndex].sStateDesc := TO_STRING(eState);
mainStateCallHistory[iStateCallHistoryIndex].sSubStateId := TO_STRING(iSubState);
mainStateCallHistory[iStateCallHistoryIndex].sSubStateDesc := TO_STRING(eSubState);

iStateCallHistoryIndex := iStateCallHistoryIndex + 1;
IF iStateCallHistoryIndex = MAX_STATE_CALL_HISTORY THEN
	iStateCallHistoryIndex := 0;
END_IF

// mark next index to record state call history
mainStateCallHistory[iStateCallHistoryIndex].sTaskCycle := '--';
mainStateCallHistory[iStateCallHistoryIndex].sStateId := '--';
mainStateCallHistory[iStateCallHistoryIndex].sStateDesc := '--';
mainStateCallHistory[iStateCallHistoryIndex].sSubStateId := '--';
mainStateCallHistory[iStateCallHistoryIndex].sSubStateDesc := '--';]]></ST>
      </Implementation>
    </Method>
